{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8788/",
        "http://localhost:8788/ar",
        "http://localhost:8788/about",
        "http://localhost:8788/ar/about",
        "http://localhost:8788/portfolio",
        "http://localhost:8788/ar/portfolio",
        "http://localhost:8788/portfolio/all",
        "http://localhost:8788/ar/portfolio/all",
        "http://localhost:8788/contact",
        "http://localhost:8788/ar/contact",
        "http://localhost:8788/services",
        "http://localhost:8788/ar/services",
        "http://localhost:8788/portfolio/the-rider",
        "http://localhost:8788/ar/portfolio/the-rider",
        "http://localhost:8788/services/logo",
        "http://localhost:8788/ar/services/logo"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ],
        "unsized-images": "error",
        "modern-image-formats": "error",
        "font-display": "error"
      },
      "aggregationMethod": "median"
    }
  }
}
