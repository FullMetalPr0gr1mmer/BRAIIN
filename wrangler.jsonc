{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "braiin-station",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // NOTE (adapter v14): no `main` here. The Cloudflare Vite plugin resolves the worker
  // entry during the build and errors if `main` points at a not-yet-emitted output file
  // (the old v12 value was "./dist/_worker.js/index.js").
  "assets": {
    // Astro 7 splits output into dist/client (public) + dist/server (worker, wrangler.json
    // AND .dev.vars containing real env values). Pointing at ./dist would serve
    // dist/server/.dev.vars over HTTP under `wrangler dev` (the perf-seo-a11y workflow).
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // ⚠ READ THIS BEFORE CHANGING A `PUBLIC_*` VALUE HERE — IT WILL NOT TAKE EFFECT.
  //
  // All three PUBLIC_* vars are declared `context: 'client'` in astro.config.mjs, so
  // `astro:env/client` INLINES them into the bundle when `astro build` runs. A build-time
  // constant cannot be overridden by a runtime binding, so these entries are inert: the
  // value that ships is whatever was in the BUILD environment.
  //
  // Verified, not inferred: a Worker built with .env's `http://localhost:4321` and
  // previewed with these vars set to the workers.dev origin served
  // `<link rel="canonical" href="http://localhost:4321/">` and a sitemap of localhost
  // <loc>s. `grep -r localhost:4321 dist/server` finds them compiled in.
  //
  // They are kept here anyway, deliberately, for two reasons: `wrangler deploy` prints the
  // binding table on every deploy, so these document the expected values where someone
  // will actually look; and if a future refactor moves any of them to `context: 'server'`
  // they become live without a config change. Do not treat them as the source of truth.
  //
  // TO CHANGE THE ORIGIN: set it in the build environment and rebuild.
  //   PUBLIC_SITE_URL=https://<origin> npm run build && npx wrangler deploy
  // `npm run prebuild` (scripts/check-site-url.mjs) blocks a build whose PUBLIC_SITE_URL
  // is localhost or non-https, so this cannot ship silently again.
  //
  // Non-secret by construction: PUBLIC_SUPABASE_ANON_KEY ships inside the client bundle on
  // every page, so committing it reveals nothing a visitor cannot already read — it is an
  // identifier, and RLS is what protects the data behind it. Anything genuinely secret
  // goes through `npm run cf:secrets`.
  "vars": {
    // TODO: swap to the custom domain once DNS is cut over — AND rebuild, per the note above.
    "PUBLIC_SITE_URL": "https://braiin-station.workers.dev",
    "PUBLIC_SUPABASE_URL": "https://xkxthzcmmvtnwicerlup.supabase.co",
    "PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_fdVFL7qNbBx64z1pwvDAbg_ReRzjhOr",
    // `context: 'server'` in astro.config.mjs, so unlike the three above this one IS a
    // live runtime binding. (Note: src/lib/ai/spendCap.ts currently uses its own
    // hard-coded ceiling and never imports it — wiring that up is Style-Finder work.)
    "AI_DAILY_USD_CAP": "5",
  },
  // Image transforms (astro adapter imageService: 'cloudflare-binding').
  "images": {
    "binding": "IMAGES",
  },
  // Astro session storage. Create with: wrangler kv namespace create SESSION
  // then paste the id below (and a preview_id for `wrangler dev`).
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "28ffe378e6844cdc8b2802e7ffafa267",
      "preview_id": "7f8764a06e9b4baca340cfdc8495f223",
      "remote": true,
    },
  ],
  // NOTE: secrets (SUPABASE_SERVICE_ROLE_KEY, LEAD_PII_ENC_KEY, AUDIT_HMAC_KEY,
  // NOTIFY_LEAD_SECRET, ANTHROPIC_API_KEY) are set via `wrangler secret put <NAME>`
  // or the Cloudflare dashboard — NEVER committed here.
}
