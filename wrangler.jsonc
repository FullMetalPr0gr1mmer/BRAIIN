{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "braiin-station",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // NOTE (adapter v14): `main` is a SOURCE file. The Cloudflare Vite plugin resolves and
  // bundles it during the build, and errors if `main` points at a not-yet-emitted output
  // file (the old v12 value was "./dist/_worker.js/index.js"). src/worker.ts is the
  // adapter's own entry with the byte-range media route in front of it.
  "main": "./src/worker.ts",
  "assets": {
    // Astro 7 splits output into dist/client (public) + dist/server (worker, wrangler.json
    // AND .dev.vars containing real env values). Pointing at ./dist would serve
    // dist/server/.dev.vars over HTTP under `wrangler dev` (the perf-seo-a11y workflow).
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The asset worker ignores `Range`, so a <video> of /media/showreel.mp4 could never
    // seek and every clip window played the file from 0 (EXC-009). These paths reach the
    // Worker first, which answers them with byte ranges (src/lib/http/media.ts). Every
    // other static file is still served by the asset worker directly — so their security
    // headers come from public/_headers, not from the Worker. Keep this list to /media:
    // widening it would make every stylesheet and font a Worker invocation (counted
    // against the plan's request quota, and a hop slower) instead of a free asset hit.
    "run_worker_first": ["/media/*"],
  },
  "observability": {
    "enabled": true,
  },
  // The daily jobs (src/worker.ts `scheduled` → src/lib/cron/daily.ts): the Join retention
  // run — expired CVs out of the private Storage bucket, then their rows — and the public
  // write limiter's old counters. Cron triggers are free on every Workers plan.
  "triggers": {
    "crons": ["23 3 * * *"],
  },
  // ⚠ NO `PUBLIC_*` ENTRIES HERE — THEY OVERRIDE THE BUILD ENVIRONMENT.
  //
  // All three PUBLIC_* vars are declared `context: 'client'` in astro.config.mjs, so
  // `astro:env/client` INLINES them when `astro build` runs. Under Astro 7 + adapter 14 the
  // build reads this file's `vars` too, and they WIN over the process environment:
  // measured 2026-09-26, a build run with PUBLIC_SITE_URL=http://localhost:8790 shipped
  // `var PUBLIC_SITE_URL = "https://braiin-station.braiin.workers.dev"` — the value that
  // used to sit here. (On the older adapter they were inert; that is what this note said.)
  //
  // What it broke: the perf-seo-a11y workflow builds against its seeded local Supabase,
  // but every CI preview Worker was compiled with the production URL and key from here,
  // so E2E, axe and Lighthouse audited PRODUCTION data. A seeded case study 404'd in CI
  // because it is a draft in production; a new column 404'd a service page until
  // production had the migration.
  //
  // The build environment is the only source: .env locally, the job's `env:` in CI, and
  // the deploy job's `env:` (ci.yml) for production. `npm run prebuild`
  // (scripts/check-site-url.mjs) and `postbuild` (verify-build-origin.mjs) block a deploy
  // artifact carrying a localhost origin.
  //
  // Non-secret by construction: PUBLIC_SUPABASE_ANON_KEY ships inside the client bundle on
  // every page, so it is an identifier, and RLS is what protects the data behind it.
  // Anything genuinely secret goes through `npm run cf:secrets`.
  "vars": {
    // `context: 'server'` in astro.config.mjs, so this IS a live runtime binding.
    // (Note: src/lib/ai/spendCap.ts currently uses its own hard-coded ceiling and never
    // imports it — wiring that up is Style-Finder work.)
    "AI_DAILY_USD_CAP": "5",
  },
  // Image transforms (astro adapter imageService: 'cloudflare-binding').
  "images": {
    "binding": "IMAGES",
  },
  // Astro session storage. Create with: wrangler kv namespace create SESSION
  // then paste the id below (and a preview_id for `wrangler dev`).
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "28ffe378e6844cdc8b2802e7ffafa267",
      "preview_id": "7f8764a06e9b4baca340cfdc8495f223",
      "remote": true,
    },
  ],
  // NOTE: secrets (SUPABASE_SERVICE_ROLE_KEY, LEAD_PII_ENC_KEY, AUDIT_HMAC_KEY,
  // NOTIFY_LEAD_SECRET, ANTHROPIC_API_KEY) are set via `wrangler secret put <NAME>`
  // or the Cloudflare dashboard — NEVER committed here.
}
