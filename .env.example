# Braiin Station — environment template.
# Copy to `.env` (git-ignored) for local dev. SECRETS go to Cloudflare via
# `npm run cf:secrets` (wrangler secret put) / dashboard / Supabase Vault.
# NEVER commit real values.
#
# ⚠ PUBLIC_* DO NOT WORK AS WRANGLER VARS. All three are `context: 'client'` in
#   astro.config.mjs, so astro:env INLINES them into the bundle at build time. The
#   `vars` block in wrangler.jsonc is inert for them — a build-time constant cannot be
#   overridden by a runtime binding. Whatever is present when `astro build` runs is what
#   ships, permanently, inside the artifact.
#
#   To build for deployment WITHOUT disturbing your local dev values, put the production
#   origin in `.env.local` (git-ignored via the `*.local` rule, and higher precedence
#   than `.env`):
#
#       echo 'PUBLIC_SITE_URL=https://braiin-station.braiin.workers.dev' > .env.local
#       npm run build && npx wrangler deploy
#
#   Measured, not assumed: `PUBLIC_SITE_URL=... npm run build` and `.env.production` were
#   BOTH tested against the served output of the built Worker and neither took effect.
#   `.env.local` and `.env` are the two that do.
#
#   `npm run postbuild` (scripts/verify-build-origin.mjs) inspects the built artifact and
#   fails if a local origin was compiled in, so this cannot ship silently. Local preview
#   builds opt out with ALLOW_LOCAL_SITE_URL=1.

# ---- Client-safe (public, non-sensitive) ----
# Local dev value. See the note above before changing this for a deploy.
PUBLIC_SITE_URL="http://localhost:4321"
PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJ...anon-key..."

# ---- Server, non-secret config ----
AI_DAILY_USD_CAP="5"

# ---- Server SECRETS (server-only; never client-bundled) ----
# Supavisor transaction-mode pooler URL (:6543, pgbouncer=true, prepare:false).
SUPABASE_DB_POOL_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
SUPABASE_SERVICE_ROLE_KEY="eyJ...service-role-key... (KEEP SECRET)"
# 32-byte base64 key for envelope-encrypting lead PII (phone/email/budget).
LEAD_PII_ENC_KEY="base64:CHANGE_ME_32_BYTES"
# HMAC key for the append-only audit hash-chain (store in Supabase Vault in prod).
AUDIT_HMAC_KEY="base64:CHANGE_ME_32_BYTES"
# Bearer secret the DB trigger uses to authenticate the notify-lead Worker call.
NOTIFY_LEAD_SECRET="CHANGE_ME_RANDOM"
# Optional until the AI Style-Finder is built (Phase 4). Server-only.
ANTHROPIC_API_KEY=""
