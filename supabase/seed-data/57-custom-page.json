          "type": "textBlock",
          "content": {
            "tag": {
              "en": "Our process",
              "ar": "طريقتنا"
            },
            "heading": {
              "en": "Every project starts with a conversation",
              "ar": "كل مشروع يبدأ بحوار"
            },
            "body": {
              "en": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "We start by listening: what you need, who it is for, and what a good result looks like to you."
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Then one team plans it, makes it and stays with it after it goes live, so nothing is lost between hands."
                      }
                    ]
                  }
                ]
              },
              "ar": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "نبدأ بالاستماع: وش تحتاج، ولمين، وكيف تشوف النتيجة الناجحة."
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "بعدها فريق واحد يخطط ويصنع ويبقى معك بعد الإطلاق، عشان ما يضيع شيء بين الأيادي."
                      }
                    ]
                  }
                ]
              }
            }
          },
          "visible": true,
          "sort_order": 20,
          "is_placeholder": true,
          "__placeholder": true
