---
import type { Locale } from '@schemas/primitives';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { ogImageCandidates } from '@/lib/seo/ogImage';
import { PAGE_META } from '@/lib/seo/pageMeta';
import type { JoinPageData } from '@/lib/sections/joinPage';

// Join (`/join`, `/ar/join`) — a CMS-composed section page (`pages` slug 'join' +
// `page_sections`): banner hero → why join → how it works → the application. The default
// composition renders until the page is composed. The route loads its data
// (src/lib/sections/joinPage.ts, with the route-level guarantees), sets the cache headers
// (Tier A for the bare URL, tagged with what its sections read; a `?status=` answer is
// private, no-store) and hands both over (Admin v2 R7).

interface Props {
  locale: Locale;
  page: JoinPageData;
}

const { locale, page } = Astro.props;
const { sections, jsonLd, header, hiddenH1 } = page;
const { seo } = page.head;
const meta = PAGE_META.join[locale];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  logicalPath="/join"
  jsonLd={jsonLd}
  robots={seo.robots}
  header={header}
  styles={['join.css']}
  ogImages={ogImageCandidates(seo)}
  {...seo.canonicalOverride ? { canonicalOverride: seo.canonicalOverride } : {}}
>
  <main class="join-page">
    {hiddenH1 && <h1 class="sr-only">{meta.title}</h1>}
    <SectionRenderer locale={locale} sections={sections} />
  </main>
</BaseLayout>
