---
import { barBucket, clean, formatNumber } from '@/lib/admin/charts';

// A funnel (Admin v2 G1a, the prototype's `.fun` rows in opsStatsConversions, screens_ops.js):
// each step's name and, in words, how many visits reached it, their share of the first step
// and the drop from the step before. The bar beside it is decoration (aria-hidden): the
// kept part is the share of the first step, the left part what the step lost from the one
// before, both 5% buckets (`.bar-fill[data-width]`, admin.css; a style attribute would be
// refused). The words are the alternative, so the list needs no table. Zero JS.
//
// A list (<ol>): the steps are in order, and each is a subset of the one before it, so a
// share never passes 100% nor a later step the earlier one.

export interface FunnelStepItem {
  label: string;
  value: number;
}

interface Props {
  steps: readonly FunnelStepItem[];
  /** What a step counts, plural and singular: "visits", "visit". */
  unit?: { one: string; many: string };
  /** The list's name, when no heading right above it names it. */
  label?: string | undefined;
}

const { steps, unit = { one: 'visit', many: 'visits' }, label } = Astro.props;
const base = clean(steps[0]?.value ?? 0);
const share = (value: number) => (base > 0 ? (clean(value) / base) * 100 : 0);
const whole = (pct: number) => `${Math.round(pct)}%`;
const rows = steps.map((step, i) => {
  const value = clean(step.value);
  const before = i > 0 ? clean(steps[i - 1]?.value ?? 0) : null;
  const kept = share(value);
  const lost = before === null ? 0 : Math.max(0, share(before) - kept);
  const drop =
    before === null || before === 0 ? null : (1 - Math.min(value, before) / before) * 100;
  const words = [
    `${formatNumber(value)} ${value === 1 ? unit.one : unit.many}`,
    ...(i > 0 ? [`${whole(kept)} of ${unit.many}`] : []),
    ...(drop === null ? [] : [`${whole(drop)} drop off`]),
  ].join(', ');
  return {
    label: step.label,
    words,
    kept: barBucket(kept, 100),
    lost: barBucket(lost, 100),
  };
});
---

<ol class="fun-list" aria-label={label}>
  {
    rows.map((row) => (
      <li class="fun">
        <div class="fun__t">
          <b>{row.label}</b>
          <span>{row.words}</span>
        </div>
        <span class="fun__bar" aria-hidden="true">
          <span class="bar-fill" data-width={row.kept} />
          {row.lost > 0 && <span class="bar-fill fun__lost" data-width={row.lost} />}
        </span>
      </li>
    ))
  }
</ol>
