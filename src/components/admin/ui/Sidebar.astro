---
import { Picture } from 'astro:assets';
import logo from '@/assets/braiin-logo-white.png';
import { ENVIRONMENT_LABELS } from '@/lib/admin/environment';
import type { NavGroup, NavLink } from '@/lib/admin/nav';
import type { ShellState } from '@/lib/admin/shell';
import Icon from './Icon.astro';

// The midnight sidebar (Admin v2 F2, the prototype's .side). Server-rendered, zero JS.
//
// Below 900px it is a popover: the topbar's Menu button toggles it, and the browser gives
// light dismiss, Escape and the top layer for free (WCAG 1.4.10: the menu is never lost
// at 320px or 400% zoom). From 900px admin.css shows it in the page grid instead.
//
// Beside the logo, the environment pill (F8): "Live", "Staging" or "Local", from the
// deployment marker, and nothing when the database is unmarked. At its foot, the account
// chip (F8): a link to /admin/account, which the chrome island opens as the account
// drawer instead; the name and initials carry data hooks so a rename shows at once.

interface Props {
  nav: readonly NavGroup[];
  current: NavLink | null;
  brand: string;
  shell: ShellState;
  email: string;
  roleLabel: string;
  initials: string;
}

const { nav, current, brand, shell, email, roleLabel, initials } = Astro.props;
---

<nav id="admin-side" class="admin-sidebar admin-nav" popover="auto" aria-label="Admin sections">
  <div class="side__inner">
    <div class="side__logo">
      <a class="admin-brand" href="/admin">
        {/* 104 CSS px; 264 is the 2x candidate (both on the /_image width allow-list). */}
        <Picture
          src={logo}
          alt={brand}
          formats={['avif', 'webp']}
          width={104}
          widths={[104, 264]}
          sizes="104px"
          decoding="async"
          loading="eager"
        />
      </a>
      {
        shell.environment && (
          <span class="side__env" data-env={shell.environment}>
            <span class="visually-hidden">Environment: </span>
            {ENVIRONMENT_LABELS[shell.environment]}
          </span>
        )
      }
    </div>

    <div class="side__nav">
      {
        nav.map((group, index) => (
          <div class="admin-nav-group">
            <p class="admin-nav-title" id={`nav-group-${index}`}>
              {group.title}
            </p>
            <ul aria-labelledby={`nav-group-${index}`}>
              {group.links.map((link) => {
                const count = link.count ? shell.counts[link.count] : undefined;
                return (
                  <li>
                    <a href={link.href} aria-current={link === current ? 'page' : undefined}>
                      <Icon name={link.icon} />
                      <span class="side__label">{link.label}</span>
                      {count !== undefined && count > 0 && (
                        <span class="cnt">
                          {count}
                          <span class="visually-hidden"> new</span>
                        </span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="side__foot">
      <a class="side__user" href="/admin/account" data-open="account">
        <span class="avatar" aria-hidden="true" data-account-initials>{initials}</span>
        <span class="side__who">
          <span class="visually-hidden">Your account: </span>
          <b data-account-name>{shell.displayName ?? email}</b>
          <span data-role>{roleLabel}</span>
        </span>
        <Icon name="chevron" size={16} />
      </a>
    </div>
  </div>
</nav>
