---
import LinkTabs from './LinkTabs.astro';
import type { NavTab } from '@/lib/admin/nav';
import { guideHref, screenOf } from '@/lib/admin/help/model';
import Icon from './Icon.astro';

// The page head (Admin v2 F2, the prototype's .ph): the h1, its plain-language sub-line,
// a wrapping actions slot, and the area's tabs. Tabs are the screens the prototype folds
// into one area (Services · Disciplines · Case studies…): server-rendered links, the
// current one marked aria-current, shown only when the role can open two or more
// (LinkTabs, the kit's tabs as links, F4b).
//
// `guide` (U16, the prototype's ROUTE_GUIDE button) is the slug of this screen's guide for
// the role, decided by the layout (src/lib/admin/help/pageGuides.ts): "Guide", first of the
// actions, a link to the guide's page without JS (carrying this screen, so the page's "All
// guides" lists this screen's guides first), opened in the help drawer with it.
//
// `heading` (C4b) is the h1 when it is not the title: a lead's page is titled "Lead" (the tab
// and the history never carry a person's name, crm.md §11) while its h1 is the person's name,
// read in its own direction (`headingDir: 'auto'`).

interface Props {
  title: string;
  heading?: string | undefined;
  headingDir?: 'auto' | undefined;
  subtitle?: string | undefined;
  tabs?: readonly NavTab[] | undefined;
  currentTab?: NavTab | null | undefined;
  area?: string | undefined;
  guide?: string | null | undefined;
}

const {
  title,
  heading,
  headingDir,
  subtitle,
  tabs = [],
  currentTab = null,
  area = title,
  guide,
} = Astro.props;
const screen = screenOf(Astro.url.pathname);
---

<header class="admin-header">
  <div>
    <h1 dir={headingDir}>{heading ?? title}</h1>
    {subtitle && <p class="admin-sub">{subtitle}</p>}
  </div>
  {
    guide && (
      <a
        class="btn admin-header__guide"
        data-variant="ghost"
        href={guideHref(guide, screen)}
        data-open="help"
        data-help-guide={guide}
      >
        <Icon name="info" size={16} />
        Guide<span class="visually-hidden"> to this screen</span>
      </a>
    )
  }
  <slot name="actions" />
</header>
{tabs.length > 1 && <LinkTabs tabs={tabs} current={currentTab?.href} label={`${area} sections`} />}
