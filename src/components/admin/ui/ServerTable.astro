---
import Avatar from './Avatar.astro';
import Badge from './Badge.astro';
import EmptyState from './EmptyState.astro';
import Pager from './Pager.astro';
import { formatNumber } from '@/lib/admin/charts';
import { offsetOf, pageInfo, pageParam, rangeText, PAGE_SIZE } from '@/lib/admin/pager';
import type { IconName } from '@/lib/admin/icons';
import { BADGE_TONES, type BadgeTone } from '@/lib/admin/tones';
import { isoOf, toDate } from '@/lib/admin/relTime';
import { studioClock } from '@/lib/admin/studioTimeZone';

// The studio's clock (Admin v2 U9: `site_settings.timezone`, read once per request).
const { formatDate, formatDateTime, relTime } = await studioClock(Astro.locals);

// A server-rendered table (Admin v2 F4b, the prototype's .tbl): the DataTable's look with
// zero JS, for screens without client state (the activity log, release history, the forms
// overview). The rows are one page the server already read; paging is links (Pager), the
// range "26 to 50 of 112" sits under the table.
//
// A page past the end is the screen's to handle: ServerTable clamps its range and pager to
// the last page (pageInfo), but it cannot read rows. A screen reads the page the URL
// names clamped the same way, `pageInfo(total, offsetOf(pageParam(value))).offset` (or
// redirects to that page when it learns the total from the read itself); otherwise
// `?page=99` shows an empty table under "51 to 60 of 60" (kit.astro does the former).
//
// Cells are typed, not free markup: text, a number (tabular, end-aligned), a status
// badge, a date, a date and time, or "3 h ago" as a <time>. The `title` column links to
// `rowHref(row)` (no click handler on the row) and its link covers the row.
//
// Two cells carry a shape rather than one value (Admin v2 U13, the activity log; the
// prototype's Who and What): `person`, an avatar beside a name and a sub-line, the name a
// link when the row gives one; `tagged`, a badge (a tone and a word) before a sentence of
// parts, each a plain, strong or muted text. Every part is a text node: a cell holds what
// people typed (a name, an item's title), never markup. A value of the wrong shape renders
// an empty cell.

/** A `person` cell's value. */
export interface PersonCell {
  /** The person's id, which picks the avatar's tone (absent: the brand colour). */
  id: string | null;
  name: string;
  sub?: string | null;
  href?: string | null;
}

/** One run of a `tagged` cell's sentence. */
export interface TaggedPart {
  text: string;
  strong?: boolean;
  muted?: boolean;
}

/** A `tagged` cell's value. */
export interface TaggedCell {
  badge: { label: string; tone: BadgeTone };
  parts: readonly TaggedPart[];
}
//
// The scroll box is a named region in the tab order (U2): a table wider than a phone
// scrolls inside it, and a table with no link in it would otherwise leave that scrolling
// out of reach of the keyboard (WCAG 2.1.1; axe's scrollable-region-focusable).

export interface ServerColumn {
  key: string;
  label: string;
  kind?: 'text' | 'number' | 'status' | 'date' | 'datetime' | 'ago' | 'person' | 'tagged';
  /** This column's cell links to the row's page. */
  title?: boolean;
}

const isRecord = (value: unknown): value is Record<string, unknown> =>
  typeof value === 'object' && value !== null && !Array.isArray(value);

function personOf(value: unknown): PersonCell | null {
  if (!isRecord(value) || typeof value['name'] !== 'string') return null;
  return {
    id: typeof value['id'] === 'string' ? value['id'] : null,
    name: value['name'],
    sub: typeof value['sub'] === 'string' ? value['sub'] : null,
    href: typeof value['href'] === 'string' ? value['href'] : null,
  };
}

function taggedOf(value: unknown): TaggedCell | null {
  if (!isRecord(value) || !isRecord(value['badge']) || !Array.isArray(value['parts'])) return null;
  const { label, tone } = value['badge'];
  if (typeof label !== 'string' || !(BADGE_TONES as readonly unknown[]).includes(tone)) return null;
  const parts = (value['parts'] as unknown[]).flatMap((part) =>
    isRecord(part) && typeof part['text'] === 'string'
      ? [{ text: part['text'], strong: part['strong'] === true, muted: part['muted'] === true }]
      : [],
  );
  return { badge: { label, tone: tone as BadgeTone }, parts };
}

interface Props {
  /** The table's name, for assistive technology (a visually hidden <caption>). */
  caption: string;
  columns: readonly ServerColumn[];
  rows: readonly Record<string, unknown>[];
  rowHref?: ((row: Record<string, unknown>) => string | null) | undefined;
  /** With `url`, the rows are one page of `total`: the range and the pager show. */
  total?: number | undefined;
  url?: URL | undefined;
  param?: string;
  limit?: number;
  empty?: { title: string; text?: string; icon?: IconName } | undefined;
  now?: Date | number | string | undefined;
}

const {
  caption,
  columns,
  rows,
  rowHref,
  total,
  url,
  param = 'page',
  limit = PAGE_SIZE,
  empty = { title: 'Nothing here yet' },
  now = Date.now(),
} = Astro.props;

const paged = total !== undefined && url !== undefined;
const info = paged
  ? pageInfo(total, offsetOf(pageParam(url.searchParams.get(param)), limit), limit)
  : null;
const numeric = (column: ServerColumn) => column.kind === 'number';
const text = (value: unknown) =>
  value === null || value === undefined ? '' : typeof value === 'string' ? value : String(value);
---

<div class="card card--flush dt">
  <div class="table-wrap" tabindex="0" role="region" aria-label={caption}>
    <table class="data">
      <caption class="visually-hidden">{caption}</caption>
      <thead>
        <tr>
          {
            columns.map((column) => (
              <th scope="col" class={numeric(column) ? 'num' : undefined}>
                {column.label}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.length === 0 ? (
            <tr>
              <td colspan={columns.length}>
                <EmptyState title={empty.title} text={empty.text} icon={empty.icon ?? 'inbox'} />
              </td>
            </tr>
          ) : (
            rows.map((row) => (
              <tr>
                {columns.map((column) => {
                  const value = row[column.key];
                  const href = column.title && rowHref ? rowHref(row) : null;
                  const person = column.kind === 'person' ? personOf(value) : null;
                  const tagged = column.kind === 'tagged' ? taggedOf(value) : null;
                  return (
                    <td class={numeric(column) ? 'num' : undefined}>
                      {person ? (
                        <span class="cell-person">
                          <Avatar name={person.name} toneKey={person.id ?? undefined} size="sm" />
                          <span class="cell-person__t">
                            {person.href ? (
                              <a href={person.href} dir="auto">
                                {person.name}
                              </a>
                            ) : (
                              <span dir="auto">{person.name}</span>
                            )}
                            {person.sub && <span class="cell-secondary">{person.sub}</span>}
                          </span>
                        </span>
                      ) : tagged ? (
                        <span class="cell-tagged">
                          <Badge tone={tagged.badge.tone} plain>
                            {tagged.badge.label}
                          </Badge>
                          {tagged.parts.map((part) =>
                            part.strong ? (
                              <>
                                {' '}
                                <b dir="auto">{part.text}</b>
                              </>
                            ) : (
                              <>
                                {' '}
                                <span class={part.muted ? 'cell-secondary' : undefined} dir="auto">
                                  {part.text}
                                </span>
                              </>
                            ),
                          )}
                        </span>
                      ) : column.kind === 'person' || column.kind === 'tagged' ? null : href ? (
                        <a class="data-link" href={href} dir="auto">
                          {text(value) || 'Untitled'}
                        </a>
                      ) : column.kind === 'status' && text(value) ? (
                        <Badge status={text(value)} />
                      ) : column.kind === 'number' && typeof value === 'number' ? (
                        formatNumber(value)
                      ) : column.kind === 'date' && toDate(value as string) ? (
                        formatDate(value as string, { now })
                      ) : column.kind === 'datetime' && toDate(value as string) ? (
                        formatDateTime(value as string)
                      ) : column.kind === 'ago' && toDate(value as string) ? (
                        <time
                          datetime={isoOf(value as string)}
                          title={formatDateTime(value as string)}
                        >
                          {relTime(value as string, now)}
                        </time>
                      ) : (
                        <span dir="auto">{text(value)}</span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))
          )
        }
      </tbody>
    </table>
  </div>
  {
    info && url && (
      <div class="tbl__foot">
        <p class="tbl__range">{rangeText(info)}</p>
        <Pager total={info.total} url={url} param={param} limit={limit} />
      </div>
    )
  }
</div>
