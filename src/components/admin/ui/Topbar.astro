---
import type { NavLink } from '@/lib/admin/nav';
import Icon from './Icon.astro';

// The white topbar (Admin v2 F2, the prototype's .top): the menu button on narrow screens,
// the breadcrumb, search, the maintenance badge and View site.
//
// Search is a plain GET form to the server-rendered results page: it works with no JS
// and cannot show a result the server did not authorize. The command palette (F3)
// enhances it. The maintenance badge is a read of the KV flag (a boolean, never the
// allowlist); it links to the switch only for roles that may flip it.

interface Props {
  section: NavLink | null;
  title: string;
  current: string;
  maintenance: boolean;
  canManageMaintenance: boolean;
}

const { section, title, current, maintenance, canManageMaintenance } = Astro.props;
const showSection = section && section.href !== '/admin' && current !== section.href;
---

<div class="admin-topbar">
  <button
    type="button"
    class="top__menu btn--icon"
    popovertarget="admin-side"
    aria-label="Menu"
    data-variant="ghost"
  >
    <Icon name="list" size={20} />
  </button>

  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      <li>
        <a href="/admin">Admin</a>
      </li>
      {
        showSection && (
          <li>
            <a href={section.href}>{section.label}</a>
          </li>
        )
      }
      <li aria-current="page">{title}</li>
    </ol>
  </nav>

  <form class="topbar-search" role="search" action="/admin/search" method="get">
    <label class="visually-hidden" for="topbar-q">Search the admin</label>
    <Icon name="search" size={16} />
    <input
      id="topbar-q"
      type="search"
      name="q"
      placeholder="Search anything…"
      minlength="2"
      maxlength="64"
    />
  </form>

  {
    maintenance &&
      (canManageMaintenance ? (
        <a class="badge" data-tone="warn" href="/admin/maintenance">
          Maintenance on
        </a>
      ) : (
        <span class="badge" data-tone="warn">
          Maintenance on
        </span>
      ))
  }

  <a class="btn top__view" data-variant="dark" href="/" target="_blank" rel="noopener">
    <Icon name="ext" size={14} />
    View site<span class="visually-hidden"> (opens in a new tab)</span>
  </a>
</div>
