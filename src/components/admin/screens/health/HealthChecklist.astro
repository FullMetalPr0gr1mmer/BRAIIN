---
import Icon from '@/components/admin/ui/Icon.astro';
import { byGroup, tally, type CheckResult, type CheckState } from '@/lib/admin/health/checklist';
import type { IconName } from '@/lib/admin/icons';
import type { BadgeTone } from '@/lib/admin/tones';

// The checklist (Admin v2 U2; the prototype's grouped .hsrow list): each group with how many
// of its judged rows pass, each row its state, its line and, when it fails and the role can
// open the screen, a link to where it is fixed. The state is a word as well as an icon and a
// tint (WCAG 1.4.1). `groups` narrows it to some groups (the SEO tab shows SEO alone).

interface Props {
  checks: readonly CheckResult[];
  /** Show only these groups (all by default). */
  groups?: readonly string[] | undefined;
  /** The heading level of a group's title. */
  level?: 2 | 3;
}

const { checks, groups, level = 3 } = Astro.props;
const shown = byGroup(checks).filter((g) => !groups || groups.includes(g.group));
const Heading = level === 2 ? 'h2' : 'h3';

const LOOK: Record<CheckState, { tone: BadgeTone; icon: IconName; word: string }> = {
  ok: { tone: 'ok', icon: 'check', word: 'Passing' },
  fail: { tone: 'warn', icon: 'warn', word: 'Needs fixing' },
  info: { tone: 'sky', icon: 'info', word: 'For information' },
  unknown: { tone: 'gray', icon: 'clock', word: 'Not judged' },
};
const idOf = (group: string) => `hc-${group.toLowerCase()}`;
---

<div class="hc">
  {
    shown.map(({ group, results }) => {
      const { ok, judged } = tally(results);
      return (
        <section class="hc__group" aria-labelledby={idOf(group)}>
          <Heading class="hc__h" id={idOf(group)}>
            <span>{group}</span>
            {judged > 0 && (
              <span class="hc__n">
                {ok} of {judged} passing
              </span>
            )}
          </Heading>
          <ul class="hc__list">
            {results.map((check) => (
              <li class="hsrow" data-state={check.state}>
                <span class="st" data-tone={LOOK[check.state].tone} aria-hidden="true">
                  <Icon name={LOOK[check.state].icon} size={12} />
                </span>
                <div class="hsrow__main">
                  <span class="visually-hidden">{LOOK[check.state].word}: </span>
                  <span class="hsrow__t">{check.text}</span>
                  {check.detail && <small class="hsrow__s">{check.detail}</small>}
                </div>
                {check.fix && (
                  <a class="btn" data-size="sm" href={check.fix}>
                    Fix<span class="visually-hidden">: {check.text}</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</div>
