---
import BarList from '@/components/admin/ui/BarList.astro';
import Card from '@/components/admin/ui/Card.astro';
import EmptyState from '@/components/admin/ui/EmptyState.astro';
import Kpi from '@/components/admin/ui/Kpi.astro';
import Donut from '@/components/admin/ui/charts/Donut.astro';
import Line from '@/components/admin/ui/charts/Line.astro';
import { formatNumber } from '@/lib/admin/charts';
import { percentChange, pointChange } from '@/lib/admin/kpi';
import { perThousand, type LeadKpis } from '@/lib/admin/stats/leads';
import { arabicShare, dailyArabicShare, type PageviewSummary } from '@/lib/admin/stats/pageviews';
import { dayLabel, periodLabel } from '@/lib/admin/stats/range';
import { onePageShare, pagesPerVisit, type VisitSummary } from '@/lib/admin/stats/visits';

// Website stats, Overview (Admin v2 U2, v2 in G1a; the prototype's opsStatsOverview,
// screens_ops.js): visits, page views, pages per visit and one-page visits; then the Arabic
// share and, for leads.manage holders only (`leads`, null otherwise), new leads and
// inquiries per 1,000 page views exactly as U2 drew them; then visits and page views day by
// day, the language split and the top pages. A visit is one browser tab on one UTC day
// (visits.ts). A KPI shows its change only when its own rollup holds the previous period
// (`summary.previous` for page views, `visits.previous` for visits, which started counting
// later). Zero JS: every chart is server-drawn SVG with its table.

interface Props {
  summary: PageviewSummary;
  visits: VisitSummary;
  leads: LeadKpis | null;
}

const { summary, visits, leads } = Astro.props;
const { current, previous, range } = summary;
const period = periodLabel(range);

const views = current.total;
const prevViews = previous ? previous.total : null;
const share = arabicShare(current.byLocale);
const prevShare = previous ? arabicShare(previous.byLocale) : null;
const rate = leads ? perThousand(leads.current, views) : null;
const prevRate =
  leads && leads.previous !== null && prevViews !== null
    ? perThousand(leads.previous, prevViews)
    : null;

const now = visits.current;
const before = visits.previous;
const perVisit = pagesPerVisit(now);
const onePage = onePageShare(now);

const percent = (value: number) =>
  `${new Intl.NumberFormat('en-GB', { maximumFractionDigits: 1 }).format(value)}%`;
const dayViews = current.byDay.map((d) => d.en + d.ar);
const labels = current.byDay.map((d) => dayLabel(d.day));
const en = current.byLocale.find((l) => l.locale === 'en')?.views ?? 0;
const ar = current.byLocale.find((l) => l.locale === 'ar')?.views ?? 0;
const other = Math.max(0, views - en - ar);
const languages = [
  { label: 'English', value: en },
  { label: 'Arabic', value: ar },
  ...(other > 0 ? [{ label: 'Other', value: other }] : []),
];
const top = current.topPaths.slice(0, 10).map((p) => ({ label: p.path, value: p.views }));
const delta = (value: number | null, earlier: number | null) =>
  value === null ? null : percentChange(value, earlier);
const visitsByDay = new Map(now.byDay.map((d) => [d.day, d.visits]));
---

<div class="grid grid--4">
  <Kpi
    label="Visits"
    value={now.visits}
    delta={delta(now.visits, before ? before.visits : null)}
    period={period}
    spark={now.byDay.map((d) => d.visits)}
  />
  <Kpi
    label="Page views"
    value={views}
    delta={delta(views, prevViews)}
    period={period}
    spark={dayViews}
    series={1}
  />
  <Kpi
    label="Pages per visit"
    value={perVisit === null ? 'No visits yet' : formatNumber(perVisit)}
    delta={delta(perVisit, before ? pagesPerVisit(before) : null)}
    period={period}
    series={2}
  />
  <Kpi
    label="One-page visits"
    value={onePage === null ? 'No visits yet' : percent(onePage)}
    delta={pointChange(onePage, before ? onePageShare(before) : null)}
    deltaUnit="points"
    good="down"
    period={period}
    series={3}
  />
</div>

<div class:list={['grid stats__row', leads ? 'grid--3' : 'grid--2']}>
  <Kpi
    label="Arabic share"
    value={share === null ? 'No views yet' : percent(share)}
    delta={pointChange(share, prevShare)}
    deltaUnit="points"
    period={period}
    spark={dailyArabicShare(current.byDay)}
    series={1}
  />
  {
    leads && (
      <Kpi
        label="New leads"
        value={leads.current}
        delta={delta(leads.current, leads.previous)}
        period={period}
      />
    )
  }
  {
    leads && (
      <Kpi
        label="Inquiries per 1,000 page views"
        value={rate === null ? 'No views yet' : formatNumber(rate)}
        delta={delta(rate, prevRate)}
        period={period}
      />
    )
  }
</div>

{
  views === 0 && now.visits === 0 ? (
    <Card level={2} class="stats__row" flush>
      <EmptyState
        icon="chart"
        title={summary.firstDay ? 'No visits counted in this period.' : 'No visits counted yet.'}
        text="Visits arrive from visitors who accept analytics cookies."
      />
    </Card>
  ) : (
    <>
      <div class="grid grid--2-1 stats__row">
        <Card level={2} title="Visits and page views" sub={`The last ${range.days} days`}>
          <Line
            id="stats-line"
            caption="Visits and page views per day"
            captionVisible={false}
            series={[
              {
                name: 'Visits',
                data: current.byDay.map((d) => visitsByDay.get(d.day) ?? 0),
              },
              { name: 'Page views', data: dayViews },
            ]}
            labels={labels}
            labelHeading="Day"
          />
        </Card>
        <Card level={2} title="Language">
          <Donut
            id="stats-donut"
            caption="Page views by language"
            captionVisible={false}
            data={languages}
            center={formatNumber(views)}
            labelHeading="Language"
            valueHeading="Page views"
          />
        </Card>
      </div>
      <Card level={2} title="Top pages" sub="By page views" class="stats__row">
        <BarList label="Page views per page" items={top} />
      </Card>
    </>
  )
}
