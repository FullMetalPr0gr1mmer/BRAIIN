---
// The design's primary button: a pill with a round arrow badge, the badge FIRST in the
// DOM (it sits at the inline start in both directions). Colour variants:
//   klein  Klein fill, white badge (default; "See all our work", "See all projects")
//   light  white fill, Klein badge — for Klein bands (LeadBand "Start an inquiry");
//          it stays white on hover (the mockup's projects/project pages turned it Cobalt
//          with a Klein label, ~2:1 — a cascade bug not carried over)
// Icon: `go` (→, nudges toward the reading direction) or `down` (↓, in-page anchors).
// Renders an <a> with `href`, else a <button>.

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'klein' | 'light';
  icon?: 'go' | 'down';
  class?: string;
}

const { href, type = 'button', variant = 'klein', icon = 'go', class: className } = Astro.props;
const classes = ['cta', 'cta--badge', `cta--${variant}`, `cta--${icon}`, className];
const Tag = href ? 'a' : 'button';
---

<Tag class:list={classes} href={href} type={href ? undefined : type}>
  <span class="cta__ico" aria-hidden="true">
    {
      icon === 'down' ? (
        <svg viewBox="0 0 16 16">
          <path
            d="M8 1v13M3 9l5 5 5-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      ) : (
        <svg viewBox="0 0 16 16">
          <path
            d="M2 8h12M9 3l5 5-5 5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      )
    }
  </span>
  <span><slot /></span>
</Tag>
