---
import type { Locale } from '@schemas/primitives';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StreamPlayer from '@/components/StreamPlayer.astro';
import { buildServiceSchema, buildBreadcrumbSchema } from '@/lib/seo/jsonld';
import { localizedPath, pickLocale, pickLocaleStrict } from '@/lib/i18n';
import { PUBLIC_SITE_URL } from 'astro:env/client';
import { seoForEntity } from '@/lib/data/seo';
import type { ServiceRow } from '@/lib/data/services';

interface Props {
  locale: Locale;
  service: ServiceRow;
}

const { locale, service } = Astro.props;

const STR = {
  en: { cta: 'Request this service', soon: 'Coming soon', home: 'Home', services: 'Services' },
  ar: { cta: 'اطلب هذه الخدمة', soon: 'قريبًا', home: 'الرئيسية', services: 'خدماتنا' },
}[locale];

const title = pickLocale(service.title, locale, service.slug);
const blurb = pickLocale(service.blurb, locale);
// Metadata takes the STRICT read: no EN fallback on an Arabic page.
const blurbMeta = pickLocaleStrict(service.blurb, locale);
// body_html is the server-SANITIZED HTML cache (sanitized on write in the admin,
// Phase 3). Safe to render; empty until content is authored.
const bodyHtml = pickLocale(service.body_html, locale);

const base = PUBLIC_SITE_URL.replace(/\/$/, '');
const url = base + localizedPath(`/services/${service.slug}`, locale);

const jsonLd = [
  buildServiceSchema({ name: title, description: blurbMeta, url }),
  buildBreadcrumbSchema([
    { name: STR.home, url: base + localizedPath('/', locale) },
    { name: STR.services, url: base + localizedPath('/services', locale) },
    { name: title, url },
  ]),
];

// Per-entity SEO override (`entity_seo`, authored by the SEO role under /admin) layered
// over the tenant defaults (`seo_defaults`), falling back to the content's own title and
// summary. Resolved server-side on this Tier-A route so the override is in the HTML —
// metadata that needed JavaScript would not be metadata.
const seo = await seoForEntity({
  entityType: 'service',
  entityId: service.id,
  locale,
  fallbackTitle: `${title} — Braiin Station`,
  fallbackDescription: blurbMeta,
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  logicalPath={`/services/${service.slug}`}
  jsonLd={jsonLd}
  robots={seo.robots}
  {...seo.ogImage ? { ogImage: seo.ogImage } : {}}
  {...seo.canonicalOverride ? { canonicalOverride: seo.canonicalOverride } : {}}
>
  <main class="container">
    <h1>{title}</h1>
    {service.is_teaser ? <p class="notice">{STR.soon}</p> : null}
    {
      service.hero_video_uid && !service.is_teaser ? (
        <StreamPlayer uid={service.hero_video_uid} title={title} />
      ) : null
    }
    {blurb ? <p class="lead">{blurb}</p> : null}
    {bodyHtml ? <div class="prose" set:html={bodyHtml} /> : null}
    <p><a class="cta" href={localizedPath('/contact', locale)}>{STR.cta}</a></p>
  </main>
</BaseLayout>
