---
import type { Locale } from '@schemas/primitives';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildArticleSchema, buildBreadcrumbSchema, orgRef } from '@/lib/seo/jsonld';
import { localizedPath, formatDate, pickLocale, pickLocaleStrict } from '@/lib/i18n';
import { PUBLIC_SITE_URL } from 'astro:env/client';
import { loadHead } from '@/lib/seo/head';
import { absoluteHttpUrl, ogImageCandidates } from '@/lib/seo/ogImage';
import type { PostDetail } from '@/lib/data/blog';

interface Props {
  locale: Locale;
  post: PostDetail;
}

const { locale, post } = Astro.props;

const STR = {
  en: { home: 'Home', blog: 'Creative Knowledge', by: 'By', read: 'min read' },
  ar: { home: 'الرئيسية', blog: 'المعرفة الإبداعية', by: 'بقلم', read: 'دقيقة قراءة' },
}[locale];

const title = pickLocale(post.title, locale, post.slug);
const excerpt = pickLocale(post.excerpt, locale);
// Metadata takes the STRICT read: no EN fallback on an Arabic page.
const excerptMeta = pickLocaleStrict(post.excerpt, locale);
// The body, rendered from its Tiptap source by the allowlist renderer in the loader
// (postBodyHtml, src/lib/data/blog.ts), never the stored body_html cache (H15, PRE-2:
// sanitised on write AND render, CLAUDE.md §3).
const bodyHtml = pickLocale(post.bodyHtml, locale);
const author = pickLocale(post.author?.name, locale);

const base = PUBLIC_SITE_URL.replace(/\/$/, '');
const url = base + localizedPath(`/creative-knowledge/${post.slug}`, locale);

// Per-entity SEO override (`entity_seo`, authored by the SEO role under /admin) layered
// over the tenant defaults (`seo_defaults`), falling back to the content's own title and
// summary — loaded with the public identity in one concurrent round. Resolved server-side
// on this Tier-A route so the override is in the HTML — metadata that needed JavaScript
// would not be metadata.
const { seo, identity } = await loadHead(Astro.locals, {
  locale,
  fallbackTitle: title,
  fallbackDescription: excerptMeta,
  entity: { type: 'blog_post', id: post.id },
});
const org = orgRef(identity, locale);
// The cover, absolute (og:image and JSON-LD `image` both need it) and http(s) only — a
// stored relative path or an odd scheme must not reach either.
const cover = absoluteHttpUrl(post.cover_image_url, base);

const jsonLd = [
  buildArticleSchema({
    headline: title,
    description: excerptMeta,
    url,
    org,
    ...(author ? { authorName: author } : {}),
    ...(post.published_at ? { datePublished: post.published_at } : {}),
    ...(post.updated_at ? { dateModified: post.updated_at } : {}),
    ...(cover ? { image: cover } : {}),
  }),
  buildBreadcrumbSchema([
    { name: STR.home, url: base + localizedPath('/', locale) },
    { name: STR.blog, url: base + localizedPath('/creative-knowledge', locale) },
    { name: title, url },
  ]),
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  logicalPath={`/creative-knowledge/${post.slug}`}
  jsonLd={jsonLd}
  robots={seo.robots}
  ogImages={ogImageCandidates(seo, cover)}
  {...seo.canonicalOverride ? { canonicalOverride: seo.canonicalOverride } : {}}
>
  <main class="container">
    <article>
      <h1>{title}</h1>
      <p class="post-meta">
        {author ? `${STR.by} ${author}` : ''}
        {post.published_at ? ` · ${formatDate(post.published_at, locale)}` : ''}
        {post.reading_minutes ? ` · ${post.reading_minutes} ${STR.read}` : ''}
      </p>
      {excerpt ? <p class="lead">{excerpt}</p> : null}
      {bodyHtml ? <div class="prose" set:html={bodyHtml} /> : null}
    </article>
  </main>
</BaseLayout>
