---
// The SINGLE <head> SEO choke point (CLAUDE.md Pillar 3). Emits title/description,
// per-language self-referential canonical, reciprocal hreflang + x-default, OG/Twitter,
// and JSON-LD. AR metadata is first-class (callers pass already-localized strings).
import type { Locale } from '@schemas/primitives';
import type { JsonLdNode } from '@/lib/seo/jsonld';
import { hreflangAlternates, localizedPath } from '@/lib/i18n';
import { PUBLIC_SITE_URL } from 'astro:env/client';
import JsonLd from './JsonLd.astro';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  logicalPath: string;
  ogImage?: string;
  robots?: string;
  jsonLd?: JsonLdNode[];
  /**
   * CMS-authored canonical override (`entity_seo.canonical_override`), for the case a
   * page must consolidate onto a different URL — a duplicate landing page, or a
   * campaign variant. Absent for almost every page, and deliberately validated below:
   * an authored value that is not a same-origin absolute URL is IGNORED rather than
   * emitted, because a canonical pointing off-site hands the page's ranking to whatever
   * domain was typed into the box.
   */
  canonicalOverride?: string;
}

const {
  title,
  description,
  locale,
  logicalPath,
  ogImage,
  robots = 'index,follow',
  jsonLd = [],
  canonicalOverride,
} = Astro.props;

const base = PUBLIC_SITE_URL.replace(/\/$/, '');

function safeCanonical(override: string | undefined, fallback: string): string {
  if (!override) return fallback;
  try {
    const parsed = new URL(override, base);
    return parsed.origin === new URL(base).origin ? parsed.href : fallback;
  } catch {
    return fallback;
  }
}

const canonical = safeCanonical(canonicalOverride, base + localizedPath(logicalPath, locale));
const alternates = hreflangAlternates(logicalPath, PUBLIC_SITE_URL);
const ogLocale = locale === 'ar' ? 'ar_SA' : 'en_US';

// A noindex page must not also advertise itself as canonical or claim hreflang twins:
// that pairs "don't index me" with "here is my indexable identity and my alternates",
// which is a contradiction search engines resolve unpredictably. /search and the 404s
// are the noindex routes here.
const isIndexable = !robots.includes('noindex');

// Descriptions come from prose fields, where AR is allowed to lag EN (see
// LocalizedProseSchema). pickLocale therefore falls back to English — correct for body
// copy, wrong for a <meta description> on a page that declares og:locale=ar_SA and
// lang="ar". An English description under an Arabic locale is a worse signal than no
// description, so the caller passes '' and we omit the tag entirely.
const hasDescription = description.trim().length > 0;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
{hasDescription ? <meta name="description" content={description} /> : null}
<meta name="robots" content={robots} />
{isIndexable ? <link rel="canonical" href={canonical} /> : null}
{
  isIndexable
    ? alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)
    : null
}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Braiin Station" />
<meta property="og:title" content={title} />
{hasDescription ? <meta property="og:description" content={description} /> : null}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale} />
{ogImage ? <meta property="og:image" content={ogImage} /> : null}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{hasDescription ? <meta name="twitter:description" content={description} /> : null}
{ogImage ? <meta name="twitter:image" content={ogImage} /> : null}
{jsonLd.map((node) => <JsonLd data={node} />)}
