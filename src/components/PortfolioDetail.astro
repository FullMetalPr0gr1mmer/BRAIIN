---
import type { Locale } from '@schemas/primitives';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildCreativeWorkSchema, buildBreadcrumbSchema } from '@/lib/seo/jsonld';
import { localizedPath, pickLocale, pickLocaleStrict } from '@/lib/i18n';
import { PUBLIC_SITE_URL } from 'astro:env/client';
import { seoForEntity } from '@/lib/data/seo';
import type { PortfolioRow } from '@/lib/data/portfolio';

interface Props {
  locale: Locale;
  item: PortfolioRow;
}

const { locale, item } = Astro.props;

const STR = {
  en: { cta: 'Start a project like this', home: 'Home', portfolio: 'Portfolio' },
  ar: { cta: 'ابدأ مشروعًا مثل هذا', home: 'الرئيسية', portfolio: 'أعمالنا' },
}[locale];

const title = pickLocale(item.title, locale, item.slug);
const summary = pickLocale(item.summary, locale);
// Metadata takes the STRICT read: no EN fallback on an Arabic page.
const summaryMeta = pickLocaleStrict(item.summary, locale);
// body_html is the server-SANITIZED HTML cache (sanitized on write in the admin,
// Phase 3). Safe to render; empty until content is authored.
const bodyHtml = pickLocale(item.body_html, locale);

const base = PUBLIC_SITE_URL.replace(/\/$/, '');
const url = base + localizedPath(`/portfolio/${item.slug}`, locale);

const jsonLd = [
  buildCreativeWorkSchema({ name: title, description: summaryMeta, url }),
  buildBreadcrumbSchema([
    { name: STR.home, url: base + localizedPath('/', locale) },
    { name: STR.portfolio, url: base + localizedPath('/portfolio', locale) },
    { name: title, url },
  ]),
];

// Per-entity SEO override (`entity_seo`, authored by the SEO role under /admin) layered
// over the tenant defaults (`seo_defaults`), falling back to the content's own title and
// summary. Resolved server-side on this Tier-A route so the override is in the HTML —
// metadata that needed JavaScript would not be metadata.
const seo = await seoForEntity({
  entityType: 'portfolio',
  entityId: item.id,
  locale,
  fallbackTitle: `${title} — Braiin Station`,
  fallbackDescription: summaryMeta,
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  logicalPath={`/portfolio/${item.slug}`}
  jsonLd={jsonLd}
  robots={seo.robots}
  {...seo.ogImage ? { ogImage: seo.ogImage } : {}}
  {...seo.canonicalOverride ? { canonicalOverride: seo.canonicalOverride } : {}}
>
  <main class="container">
    <h1>{title}</h1>
    {summary ? <p class="lead">{summary}</p> : null}
    {bodyHtml ? <div class="prose" set:html={bodyHtml} /> : null}
    <p><a class="cta" href={localizedPath('/contact', locale)}>{STR.cta}</a></p>
  </main>
</BaseLayout>
