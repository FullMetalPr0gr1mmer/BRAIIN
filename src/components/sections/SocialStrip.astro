---
import type { Locale } from '@schemas/primitives';
import type { SocialSectionContent } from '@schemas/sections';
import { pickLocale } from '@/lib/i18n';
import { getIdentity } from '@/lib/identity';
import { SOCIAL_COPY } from '@/lib/sections/copy/social';
import { NETWORKS } from '@/lib/social/networks';
import AccentText from '@/components/ui/AccentText.astro';

// "Follow the studio" — gradient hover boxes on paper. The links are the public
// identity's socials (`site_profile.socials`, host-allow-listed per network on write AND
// read), so a new handle is a settings edit, not a deploy. Tag/heading/links stay
// CMS-overridable per section via page_sections.content (SocialSectionContentSchema —
// hrefs are validated https-only there, since they render into <a href>). Icons resolve
// by network, and for a per-section override by label (case-insensitive); a label the
// map does not know renders without an icon.
//
// Two layouts (UI v2 PR8): `paper` (default — home, contact) and `klein`, About's "Follow
// the studio" band (the mockup's `.follow`): Klein ground with the sky glow, the heading
// beside a line of text, its accent outlined, white-fill hover cards. Each layout has its
// own built-in copy, verbatim from the design (src/lib/sections/copy/social.ts).

interface Props extends SocialSectionContent {
  locale: Locale;
  /** Rendered inside another paper block (ContactChannels) — drops the top padding so
   *  the two read as one band rather than two stacked ones. */
  joined?: boolean;
}

const {
  locale,
  variant = 'paper',
  tag,
  heading,
  accent,
  text,
  links,
  joined = false,
} = Astro.props;

const klein = variant === 'klein';
const copy = SOCIAL_COPY[variant];
const tagText = tag ? pickLocale(tag, locale) : copy.tag[locale];
const headingText = heading ? pickLocale(heading, locale) : copy.heading[locale];
// An authored heading keeps only an authored accent; only the Klein band has a built-in one.
const headingAccent = heading ? accent : (accent ?? (klein ? SOCIAL_COPY.klein.accent : undefined));
const lineText = text
  ? pickLocale(text, locale)
  : klein
    ? SOCIAL_COPY.klein.text[locale]
    : undefined;

const identity = await getIdentity(Astro.locals);
const byLabel = new Map(Object.values(NETWORKS).map((n) => [n.label.toLowerCase(), n.icon]));
const resolved = links
  ? links.map((l) => ({ ...l, icon: byLabel.get(l.label.toLowerCase()) }))
  : // An account with "Show on the site" off (Admin v2 U9) stays in the admin only.
    identity.socials
      .filter((sl) => sl.visible !== false)
      .map((sl) => ({
        label: NETWORKS[sl.network].label,
        user: sl.handle,
        href: sl.url,
        icon: NETWORKS[sl.network].icon,
      }));
---

<section
  class:list={[
    'social-strip',
    { 'social-strip--joined': joined, 'social-strip--klein klein-band': klein },
  ]}
>
  <div class="social-strip__wrap section-wrap">
    {
      klein ? (
        <div class="social-strip__head">
          <div>
            <div class="tag rv">
              <span class="dot" />
              <span>{tagText}</span>
            </div>
            <h2 class="rv">
              <AccentText text={headingText} locale={locale} accent={headingAccent} />
            </h2>
          </div>
          {lineText && <p class="rv">{lineText}</p>}
        </div>
      ) : (
        <>
          <div class="tag rv">
            <span class="dot" />
            <span>{tagText}</span>
          </div>
          <h2 class="rv">
            <AccentText text={headingText} locale={locale} accent={headingAccent} />
          </h2>
        </>
      )
    }
    <ul class="social-links">
      {
        resolved.map((l) => (
          <li>
            <a class="sbox rv" href={l.href} target="_blank" rel="noopener">
              <span class="sbox__top">
                {l.icon ? (
                  <svg class="sbox__ico" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={l.icon} />
                  </svg>
                ) : null}
                <svg class="sbox__go" viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="M4 12L12 4M6 4h6v6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span>
                <span class="sbox__name">{l.label}</span>
                <span class="sbox__user" dir="ltr">
                  {l.user}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
