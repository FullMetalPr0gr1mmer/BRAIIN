---
import type { Locale } from '@schemas/primitives';
import type { ContactInquirySectionContent } from '@schemas/sections';
import type { Accent } from '@schemas/media';
import { pickLocale } from '@/lib/i18n';
import ContactForm from '@/components/ContactForm.astro';
import AccentText from '@/components/ui/AccentText.astro';
import type { ServiceRow } from '@/lib/data/services';

// The inquiry band (UI v2 PR9): tag, section head, and the real wired form — the FULL
// variant (name, email, company, service, budget, deadline, message), posted as
// kind=project_inquiry.
//
// This wraps ContactForm rather than reimplementing it. The mockup ships its own <form>
// with no honeypot, no consent checkbox, no same-origin fetch and label-valued options —
// porting that markup would have deleted the spam guard and the PDPL lawful basis, and made
// every submission a 422. The design is a shell around the existing form.
//
// Copy is CMS-overridable (ContactInquirySectionContentSchema); the published services
// arrive as ROUTE data (withContactData), never as content.

interface Props extends ContactInquirySectionContent {
  locale: Locale;
  data?: { services?: readonly ServiceRow[] } | undefined;
}

const { locale, tag, heading, accent, lead, note, successMessage, submitLabel, data } = Astro.props;

// The design's copy, verbatim (c.inqTag / c.inqH / c.inqP). The accent is a word range:
// "Tell us what you're <em>making</em>" / "قل لنا وش <em>تصنع</em>".
const STR = {
  en: {
    tag: 'Project inquiry',
    heading: "Tell us what you're making",
    lead: 'The more you give us here, the more useful our first reply is. Budget range and deadline help most.',
  },
  ar: {
    tag: 'طلب مشروع',
    heading: 'قل لنا وش تصنع',
    lead: 'كل ما أعطيتنا تفاصيل أكثر هنا، صار ردنا الأول أنفع. الميزانية والموعد النهائي هما الأكثر فائدة.',
  },
}[locale];
const BUILT_IN_ACCENT: Accent = { en: { from: 4 }, ar: { from: 3 } };

const tagText = tag ? pickLocale(tag, locale) : STR.tag;
const headingText = heading ? pickLocale(heading, locale) : STR.heading;
// An authored heading takes only an authored accent: the built-in range counts words of
// the built-in heading.
const accentRange = heading ? accent : (accent ?? BUILT_IN_ACCENT);
const leadText = lead ? pickLocale(lead, locale) : STR.lead;
const services = data?.services ?? [];
---

<section class="contact-inquiry" id="inquiry" aria-labelledby="inquiry-heading">
  <div class="section-wrap">
    <div class="tag tag--sky rv"><span class="dot"></span><span>{tagText}</span></div>
    <div class="sec-head">
      <h2 class="rv" id="inquiry-heading">
        <AccentText text={headingText} locale={locale} accent={accentRange} />
      </h2>
      <p class="rv">{leadText}</p>
    </div>
    <ContactForm
      locale={locale}
      services={services}
      fields="full"
      kind="project_inquiry"
      note={note ? pickLocale(note, locale) : undefined}
      okMessage={successMessage ? pickLocale(successMessage, locale) : undefined}
      submitLabel={submitLabel ? pickLocale(submitLabel, locale) : undefined}
    />
  </div>
</section>
