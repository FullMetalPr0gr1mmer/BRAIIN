---
import type { Locale } from '@schemas/primitives';
import type { JoinWhySectionContent } from '@schemas/sections';
import { pickLocale } from '@/lib/i18n';
import { brandName, getIdentity } from '@/lib/identity';
import { JOIN_WHY_COPY, withBrand } from '@/lib/sections/join';
import AccentText from '@/components/ui/AccentText.astro';

// "Why {brand}" (Join): the paper band under the hero — tag, heading, lead and four
// numbered reasons (the mockup's .why). Copy is the design's (JOIN_WHY_COPY), every key
// overridable from the CMS (JoinWhySectionContentSchema); the studio is named through
// `%brand%`, in defaults and authored copy alike. Styled in public/styles/join.css.

interface Props extends JoinWhySectionContent {
  locale: Locale;
}

const { locale, tag, heading, accent, lead, items } = Astro.props;

const STR = JOIN_WHY_COPY[locale];
const brand = brandName(await getIdentity(Astro.locals), locale);
const text = (authored: { en: string; ar: string } | undefined, fallback: string) =>
  withBrand(authored ? pickLocale(authored, locale) : fallback, brand);

// An authored heading takes only an authored accent: the built-in range counts the words
// of the built-in heading.
const title = heading
  ? { text: text(heading, ''), accent }
  : { text: text(undefined, STR.heading), accent: JOIN_WHY_COPY.accent };
const reasons =
  items && items.length > 0
    ? items.map((i) => ({ heading: text(i.heading, ''), text: text(i.text, '') }))
    : STR.items.map((i) => ({
        heading: withBrand(i.heading, brand),
        text: withBrand(i.text, brand),
      }));
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="join-why" aria-labelledby="join-why-heading">
  <div class="section-wrap">
    <div class="tag rv"><span class="dot"></span><span>{text(tag, STR.tag)}</span></div>
    <div class="sec-head">
      <h2 class="rv" id="join-why-heading">
        <AccentText text={title.text} locale={locale} accent={title.accent} />
      </h2>
      <p class="rv">{text(lead, STR.lead)}</p>
    </div>
    <div class="join-why__grid">
      {
        reasons.map((r, i) => (
          <div class="join-why__item rv">
            <span class="join-why__n" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <h3>{r.heading}</h3>
            <p>{r.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
