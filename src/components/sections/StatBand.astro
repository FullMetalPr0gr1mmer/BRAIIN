---
import type { Locale } from '@schemas/primitives';
import type { Accent } from '@schemas/media';
import type { LocalizedText, StatisticRow } from '@schemas/content';
import { pickLocale } from '@/lib/i18n';
import { STATISTICS_COPY } from '@/lib/sections/copy/statistics';
import AccentText from '@/components/ui/AccentText.astro';

// Statistics as the UI v2 bands (the mockup's `.nums`, `.reach` and `.proof .stats`):
//   band   home "In numbers" — black, sky accents, 4 columns
//   reach  About "Our reach" — white, Klein accents, 3 columns
//   proof  Our Work — white, the tag alone above the row (the quotes follow in the section).
//          Standalone (a CMS statistics section) it carries the mockup's white .proof shell;
//          `bare`, inside Our Work's section, that section supplies it.
//
// Every number is rendered FINAL on the server (a crawler, a no-JS visitor and a
// reduced-motion visitor all read "250+"); countUp.ts counts it up only when it is still
// off-screen at load. A countable number is rendered twice: an .sr-only copy of the final
// value for assistive tech (which reads ahead of the viewport, so it must never hear the
// "0" the count starts from) and the animated digits inside aria-hidden.
// A value that is not a number ("TBD") is shown as written, muted.
// Digits stay Western in Arabic, as the design has them in its stats.
// Fewer than `minItems` counters and the band renders nothing.

type Variant = 'band' | 'reach' | 'proof';

interface Props {
  locale: Locale;
  items: StatisticRow[];
  variant: Variant;
  tag?: LocalizedText | undefined;
  heading?: LocalizedText | undefined;
  accent?: Accent | undefined;
  text?: LocalizedText | undefined;
  staticNumbers?: boolean | undefined;
  minItems?: number | undefined;
  id?: string | undefined;
  /** proof: rendered inside a larger section, so no <section> and no padding of its own. */
  bare?: boolean;
}

const {
  locale,
  items,
  variant,
  staticNumbers = false,
  minItems = 2,
  id,
  bare = false,
} = Astro.props;

// Built-in copy, verbatim from the design (src/lib/sections/copy/statistics.ts), overridable
// per field from the CMS. `proof` has a tag only.
const copy: {
  tag: LocalizedText;
  heading?: LocalizedText;
  accent?: Accent;
  text?: LocalizedText;
} = STATISTICS_COPY[variant];
const tag = Astro.props.tag ? pickLocale(Astro.props.tag, locale) : copy.tag[locale];
const heading = Astro.props.heading
  ? pickLocale(Astro.props.heading, locale)
  : copy.heading?.[locale];
// An authored heading keeps only an authored accent (the default's word range would land
// on the wrong words).
const accent = Astro.props.heading ? Astro.props.accent : (Astro.props.accent ?? copy.accent);
const text = Astro.props.text ? pickLocale(Astro.props.text, locale) : copy.text?.[locale];

const cells = items.map((s) => {
  const n = s.value_numeric;
  const countable = typeof n === 'number' && Number.isInteger(n) && n > 0 && !staticNumbers;
  return {
    slug: s.slug,
    label: pickLocale(s.label, locale),
    numeric: typeof n === 'number' ? { n, suffix: s.value_suffix ?? '', countable } : null,
    value: s.value,
  };
});

const Tag = bare ? 'div' : 'section';
const headId = id ? `${id}-heading` : undefined;
---

{
  cells.length >= minItems && (
    <Tag
      class:list={['sb', `sb--${variant}`, { 'sb--bare': bare }]}
      id={id}
      aria-labelledby={heading ? headId : undefined}
    >
      <div class="sb__wrap">
        {variant === 'reach' ? (
          <>
            <p class="tag rv">
              <span class="dot" />
              {tag}
            </p>
            <div class="sb__head">
              <h2 class="rv" id={headId}>
                <AccentText text={heading ?? ''} locale={locale} accent={accent} />
              </h2>
              {text && <p class="rv">{text}</p>}
            </div>
          </>
        ) : variant === 'band' ? (
          <div class="sb__head">
            <div>
              <p class="tag rv">
                <span class="dot" />
                {tag}
              </p>
              {heading && (
                <h2 class="rv" id={headId}>
                  <AccentText text={heading} locale={locale} accent={accent} />
                </h2>
              )}
            </div>
            {text && <p class="rv">{text}</p>}
          </div>
        ) : (
          <p class="tag rv">
            <span class="dot" />
            {tag}
          </p>
        )}
        <ul class="sb__grid">
          {cells.map((c) => (
            <li class="sb__cell rv">
              {c.numeric ? (
                <span class="sb__n">
                  {c.numeric.countable ? (
                    <>
                      <span class="sr-only">{`${c.numeric.n}${c.numeric.suffix}`}</span>
                      <span aria-hidden="true">
                        <span data-count-to={c.numeric.n}>{c.numeric.n}</span>
                        {c.numeric.suffix && <i>{c.numeric.suffix}</i>}
                      </span>
                    </>
                  ) : (
                    <>
                      <span>{c.numeric.n}</span>
                      {c.numeric.suffix && <i>{c.numeric.suffix}</i>}
                    </>
                  )}
                </span>
              ) : (
                <span class="sb__n sb__n--text">{c.value}</span>
              )}
              <span class="sb__l">{c.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </Tag>
  )
}

<script>
  import { initCountUp } from '@/lib/client/countUp';

  initCountUp();
</script>
