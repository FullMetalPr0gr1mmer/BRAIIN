---
import type { Locale } from '@schemas/primitives';
import type { ClientsMarqueeSectionContent } from '@schemas/sections';
import { arabicIndic, pickLocale } from '@/lib/i18n';
import { getIdentity } from '@/lib/identity';
import { getMarqueeClients } from '@/lib/data/taxonomy';
import { CLIENTS_MARQUEE_COPY, CLIENTS_MARQUEE_LABELS } from '@/lib/sections/copy/clientsMarquee';
import { fillTokens } from '@/lib/sections/copy/text';

// "Selected clients" — two counter-scrolling wordmark marquees on black. CSS-only,
// compositor-only transform animation, paused on hover, static + de-duplicated under
// prefers-reduced-motion (see global.css).
//
// The names are the `clients` table's marquee clients (UI v2): only rows cleared for
// disclosure (`visible`, enforced by RLS) and flagged `show_in_marquee`, in each
// locale's own spelling. There is deliberately NO code fallback any more: the list used
// to name eight real brands from code whenever the table was empty, which is a claim no
// editor could withdraw. No cleared client, no section.

interface Props extends ClientsMarqueeSectionContent {
  locale: Locale;
}

const { locale, tag, heading, note } = Astro.props;

const clients = await getMarqueeClients();
const items = clients.map((c) => ({ slug: c.slug, name: pickLocale(c.name, locale) }));

// "Since 2019" is the studio's founding year from the public identity; no year, no note.
const { foundedYear } = await getIdentity(Astro.locals);
// The design writes the Arabic year in Arabic-Indic digits ("منذ ٢٠١٩").
const since = (year: number) =>
  fillTokens(CLIENTS_MARQUEE_LABELS.since[locale], {
    year: locale === 'ar' ? arabicIndic(year) : String(year),
  });
const noteText = note ? pickLocale(note, locale) : foundedYear !== null ? since(foundedYear) : null;
const tagText = tag ? pickLocale(tag, locale) : CLIENTS_MARQUEE_COPY.tag[locale];

// Each track is its set duplicated 2× so the CSS transform loops seamlessly (-50%);
// the second row runs reversed and slower, and is aria-hidden as a whole (pure décor).
const rowA = [...items, ...items];
const reversed = [...items].reverse();
const rowB = [...reversed, ...reversed];
---

{
  items.length > 0 && (
    <section class="clients" aria-label={tagText} id="clients">
      <div class="tag tag--sky rv">
        <span class="dot" />
        <span>{tagText}</span>
      </div>
      <div class="clients__head">
        <h2 class="rv">
          {heading ? pickLocale(heading, locale) : CLIENTS_MARQUEE_COPY.heading[locale]}
        </h2>
        {noteText && <span class="rv">{noteText}</span>}
      </div>
      <div class="marquee">
        <ul class="marquee-track">
          {rowA.map((p, i) => (
            <li class="marquee-item" aria-hidden={i >= items.length ? 'true' : undefined}>
              {p.name}
            </li>
          ))}
        </ul>
      </div>
      <div class="marquee marquee--rev" aria-hidden="true">
        <ul class="marquee-track">
          {rowB.map((p) => (
            <li class="marquee-item" aria-hidden="true">
              {p.name}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
