---
import type { Locale } from '@schemas/primitives';
import type { Accent } from '@schemas/media';
import type { LocalizedText, StatPlacement } from '@schemas/content';
import { pickLocale } from '@/lib/i18n';
import { getPublishedStatistics, type StatisticRow } from '@/lib/data/statistics';
import type { StatRating } from '@schemas/sections';
import StatBand from './StatBand.astro';
import ServicesProof from './ServicesProof.astro';

// The `statistics` section. UI v2 layouts (`band` home, `reach` About, `proof` Our Work)
// render StatBand with the counters marked for `placement`, each under that page's label;
// Round 2's `services` (the Services page proof band: a statement, an authored rating line
// and the numbers) renders ServicesProof;
// `cards` (the default — an existing composition renders unchanged) is the original grid;
// it reads only `heading` and `minItems` (default 1 there, 2 in the bands).
// The numbers always come from the statistics table; the section only chooses the layout
// and the copy around them.

interface Props {
  locale: Locale;
  variant?: 'cards' | 'band' | 'reach' | 'proof' | 'services';
  placement?: StatPlacement;
  tag?: LocalizedText;
  heading?: LocalizedText;
  accent?: Accent;
  text?: LocalizedText;
  /** `services` only (Round 2). */
  line?: LocalizedText;
  lineAccent?: Accent;
  rating?: StatRating;
  staticNumbers?: boolean;
  minItems?: number;
  /** Route-injected rows (SectionRenderer `data`) — never CMS content. */
  data?: { items?: StatisticRow[] };
}

const { locale, variant = 'cards', placement } = Astro.props;

const STR = {
  en: { heading: 'By the numbers' },
  ar: { heading: 'بالأرقام' },
}[locale];

const items =
  Astro.props.data?.items ?? (await getPublishedStatistics(placement ? { placement } : {}));
---

{
  variant === 'cards' ? (
    items.length >= (Astro.props.minItems ?? 1) && (
      <section class="statistics">
        <div class="container">
          <h2>{Astro.props.heading ? pickLocale(Astro.props.heading, locale) : STR.heading}</h2>
          <ul class="stat-grid">
            {items.map((s) => (
              <li class="stat">
                <span class="stat-value">{s.value}</span>
                <span class="stat-label">{pickLocale(s.label, locale)}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  ) : variant === 'services' ? (
    <ServicesProof
      locale={locale}
      items={items}
      line={Astro.props.line}
      lineAccent={Astro.props.lineAccent}
      rating={Astro.props.rating}
      staticNumbers={Astro.props.staticNumbers}
      minItems={Astro.props.minItems}
    />
  ) : (
    <StatBand
      locale={locale}
      items={items}
      variant={variant}
      tag={Astro.props.tag}
      heading={Astro.props.heading}
      accent={Astro.props.accent}
      text={Astro.props.text}
      staticNumbers={Astro.props.staticNumbers}
      minItems={Astro.props.minItems}
      id={variant === 'band' ? 'numbers' : undefined}
    />
  )
}
