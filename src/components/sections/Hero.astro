---
import { Picture } from 'astro:assets';
import type { Locale } from '@schemas/primitives';
import type { HeroSectionContent } from '@schemas/sections';
import { localizedHref, pickLocale } from '@/lib/i18n';
import { splitTrailingMark } from '@/lib/text/accent';
import Cta from '@/components/ui/Cta.astro';
import logo from '@/assets/braiin-logo-white.png';

// Full-viewport brand hero (design: "Brain Station UI"). Sticky, so the next section
// slides over it. The headline is split into spans SERVER-side — the indexable text
// stays in the HTML (Pillar 3) and the entrance stagger is pure CSS (nth-child custom
// properties; no inline styles — CSP). English animates per letter; Arabic per WORD,
// because splitting Arabic glyphs breaks their joining forms.
//
// The headline IS gated on the intro, and the whole hero cascade derives from two
// tokens (--bs-intro-hold / --bs-intro-fade in global.css). A previous version of this
// comment claimed gating the headline blew the 2.5s LCP budget; measured on a
// production build that is false — Chromium aggregates text LCP at the block ancestor,
// so the <h1> registers at first paint while every .letter is still transparent, and
// Lantern has no term for animation-delay (2ms delta). The LCP element here is the
// intro logo <img>. The real cliff is putting opacity:0 on the <h1> BLOCK, which makes
// Chromium record no LCP candidate at all — see the invariant on .letter in global.css.

// CMS overrides arrive via page_sections.content (HeroSectionContentSchema-validated
// by the loader); every field is optional and falls back to the built-in copy.
interface Props extends HeroSectionContent {
  locale: Locale;
  /** Local fallback loop served from public/ until the Stream account lands. */
  videoSrc?: string;
  /** Route-injected (SectionRenderer `data`, never CMS content):
      - `ctaHref`  where the CTA points — the home route's `/portfolio` when the Selected
                   work band will not render, a preset page's own form (`#inquiry`);
      - `banner`   a page preset's short banner (withHeroPreset): shorter box, the badge
                   CTA icon first, no scroll cue, never the intro plate;
      - `clip`     the window of the loop this page plays (seconds). */
  data?:
    | {
        ctaHref?: string;
        banner?: boolean;
        clip?: { start: number; end: number };
      }
    | undefined;
}

const {
  locale,
  videoUid,
  videoSrc = '/media/showreel.mp4',
  // Opt-IN, never defaulted on. `intro` now arrives through HeroSectionContent, so a
  // CMS `hero` section dropped onto another page cannot inherit an undismissable
  // full-viewport plate. The CSS reads the state off `body:has(.intro)` — one flag.
  intro: introProp = false,
  headline,
  accentFromEn,
  accentFromAr,
  sub,
  ctaLabel,
  data,
} = Astro.props;

const STR = {
  en: {
    headline: 'Creative work that performs*',
    sub: 'From the brain to the real world.',
    cta: 'See our work',
    scroll: 'Scroll',
  },
  ar: {
    headline: 'شغل إبداعي يحقّق نتائج*',
    sub: 'من الدماغ إلى أرض الواقع.',
    cta: 'شوف أعمالنا',
    scroll: 'انزل',
  },
}[locale];

type Word = { text: string; accent: boolean };
// The accent never carries the footnote asterisk ("performs*": the mark stays white, as in
// the design's `<em>performs</em>*`), so an accented word renders as body + plain mark.
const WORDS: Record<Locale, Word[]> = {
  en: [
    { text: 'Creative', accent: false },
    { text: 'work', accent: false },
    { text: 'that', accent: false },
    { text: 'performs*', accent: true },
  ],
  ar: [
    { text: 'شغل', accent: false },
    { text: 'إبداعي', accent: false },
    { text: 'يحقّق', accent: true },
    { text: 'نتائج*', accent: true },
  ],
};
// A CMS headline is split on whitespace; accent starts at the authored per-locale word
// index (no accent when omitted). Without an override, the built-in split applies.
const headlineText = headline ? pickLocale(headline, locale) : STR.headline;
const accentFrom = locale === 'ar' ? accentFromAr : accentFromEn;
const words: Word[] = headline
  ? headlineText
      .split(/\s+/)
      .filter(Boolean)
      .map((text, i) => ({ text, accent: accentFrom !== undefined && i >= accentFrom }))
  : WORDS[locale];
const subText = sub ? pickLocale(sub, locale) : STR.sub;
const ctaText = ctaLabel ? pickLocale(ctaLabel, locale) : STR.cta;
const perWord = locale === 'ar';
const parts = words.map((w) => ({
  ...w,
  ...(w.accent ? splitTrailingMark(w.text) : { body: w.text, mark: '' }),
}));
const banner = data?.banner === true;
// A banner hero never opens with the full-viewport plate, whatever its content says.
const intro = introProp && !banner;
const href = localizedHref(data?.ctaHref ?? '#selected-work', locale);
const clip = data?.clip;

// The intro logo renders at `min(46vw, 520px, 66svh)`, so `width={520}` + densities
// [1,2] emits the matching 520w/1040w pair. It was `width={1040}` with the same
// densities, which put a 1040w image in a 520px box on a 1x screen — 4x the pixels,
// and this is the LCP element.

// TEMPORARY EXCEPTION (owner: Kareem, expires: KAN-20 Stream provisioning) — the loop
// ships as a static mp4 so the launched design has its centerpiece; CLAUDE.md P2 wants
// Cloudflare Stream. Bytes stay off the critical path (poster first, video post-load).
const src = videoUid ? undefined : videoSrc;
---

{
  intro ? (
    <div class="intro" aria-hidden="true">
      <Picture
        src={logo}
        alt=""
        formats={['avif', 'webp']}
        width={520}
        densities={[1, 2]}
        decoding="async"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  ) : null
}

<section class:list={['hero', { 'hero--banner': banner }]}>
  <div
    class="hero__media"
    data-video-src={src}
    data-clip-start={clip ? String(clip.start) : undefined}
    data-clip-end={clip ? String(clip.end) : undefined}
  >
  </div>

  <div class="hero__inner">
    <h1 aria-label={headlineText}>
      {
        parts.map((w) => (
          <span class:list={['word', { accent: w.accent }]} aria-hidden="true">
            {perWord ? (
              <span class="letter">{w.body}</span>
            ) : (
              [...w.body].map((ch) => <span class="letter">{ch}</span>)
            )}
            {w.mark && <span class="letter letter--plain">{w.mark}</span>}
          </span>
        ))
      }
    </h1>
    <div class="hero__side">
      <p class="hero__sub">{subText}</p>
      {
        banner ? (
          <Cta href={href} icon="down" class="hero__cta">
            {ctaText}
          </Cta>
        ) : (
          <a class="cta hero__cta" href={href}>
            <span>{ctaText}</span>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M8 1v13M3 9l5 5 5-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        )
      }
    </div>
  </div>

  {
    !banner && (
      <div class="hero__scroll" aria-hidden="true">
        <i />
        <span>{STR.scroll}</span>
      </div>
    )
  }
</section>

<script>
  import { mountLazyVideo, setVideoInView } from '@/lib/client/lazyVideo';

  // Intro: once per tab session; any navigation intent cuts straight to the page.
  const intro = document.querySelector<HTMLElement>('.intro');
  if (intro) {
    const cut = () => document.body.classList.add('intro-cut');
    // A deep link (/#services — the header's Services item — or /ar#contact) asks for a
    // SECTION: the browser scrolls straight to it, and a logo plate over that section
    // would be in the way. It cuts without spending the once-per-session intro, so the
    // next visit to the top of home still gets the brand moment.
    if (location.hash) cut();
    else
      try {
        if (sessionStorage.getItem('bs_intro')) cut();
        else sessionStorage.setItem('bs_intro', '1');
      } catch {
        // Storage blocked: the intro still ends on its own CSS timeline.
      }
    // `focusin` covers programmatic / assistive-tech focus moves; the CSS carries a
    // JS-free `html:has(:focus-visible)` arm for the same reason.
    for (const ev of ['wheel', 'touchstart', 'keydown', 'pointerdown', 'focusin']) {
      addEventListener(ev, cut, { once: true, passive: true });
    }

    // Hold the choreography until the logo has actually PAINTED.
    //
    // The plate's timeline is a stopwatch, but the logo is a runtime Cloudflare image
    // transform: measured on production, a cold edge takes ~3.5s to return it while a
    // warm one takes ~0.7s. With a 1.8s plate the cold case lifted the plate before the
    // logo existed — you got a blank backdrop, then the headline. (The previous 4.2s
    // timeline only ever hid this by accident: it happened to outlast the cold fetch.)
    //
    // Pausing rather than retiming is deliberate, for the same reason the cut uses
    // `animation: none`: mutating a delay mid-flight remaps local time onto progress.
    // A paused animation simply holds at its current position and resumes in place.
    //
    // Degradation is safe in both directions. With JS off the class is never added and
    // the pure-CSS timeline runs exactly as before; if the image errors or stalls, the
    // cap below releases it anyway, so a broken logo can never wedge the page behind an
    // opaque plate.
    const logo = intro.querySelector('img');
    // Only a plate that is still HOLDING may be paused. With the 1.0s UI v2 hold, a module
    // that runs late (slow device, contended network) can arrive after the fade has begun
    // — pausing then would freeze a half-faded plate for up to the cap. Past the hold, the
    // moment has gone; let the CSS timeline finish.
    const ms = (v: string) => (v.trim().endsWith('ms') ? parseFloat(v) : parseFloat(v) * 1000);
    const holdMs = ms(getComputedStyle(document.body).getPropertyValue('--bs-intro-hold')) || 0;
    const fade = intro
      .getAnimations()
      .find((a) => (a as CSSAnimation).animationName === 'intro-out');
    const fading = typeof fade?.currentTime === 'number' && fade.currentTime >= holdMs;
    if (logo && !fading) {
      // Bounds the wait so time-to-content stays honest even on a cold edge: worst case
      // is CAP + hold + fade (4.45s with the UI v2 1.0s hold). Warm (the overwhelming
      // majority) releases in ~0.7s. 3s, not the 2s it was: CAP + hold must outlast the
      // measured cold transform (~3.6s) or the plate lifts before the logo exists — with
      // the old 3.5s hold, 2s had slack to spare; with a 1.0s hold it had none.
      const HOLD_CAP_MS = 3000;
      document.body.classList.add('intro-waiting');
      let released = false;
      const release = () => {
        if (released) return;
        released = true;
        document.body.classList.remove('intro-waiting');
      };
      // `complete` is true once the fetch has SETTLED — success or failure. Testing it
      // alone (rather than `complete && naturalWidth > 0`) matters: a logo that already
      // errored before this deferred module ran is complete with naturalWidth 0, and
      // waiting on an `error` event that has already fired would stall on the cap for
      // no reason. Either way there is nothing left to wait for.
      if (logo.complete) release();
      else {
        logo.addEventListener('load', release, { once: true });
        logo.addEventListener('error', release, { once: true });
      }
      setTimeout(release, HOLD_CAP_MS);
    }
  }

  const hero = document.querySelector<HTMLElement>('.hero');
  const media = document.querySelector<HTMLElement>('.hero__media');

  // NOTE: there is no visible pause control. It was removed under EXC-007
  // (docs/security-exceptions.md) to match the Brain Station UI reference hero — a
  // logged WCAG 2.2.2 regression, not an oversight. `prefers-reduced-motion` is still
  // honoured upstream in lazyVideo (it attaches no video at all), and the underlying
  // setMotionPaused()/body.motion-paused mechanism is retained, so restoring the
  // control is a button plus one listener.

  // Hero loop: the poster backdrop is the immediate paint; video bytes wait for `load`
  // so they never compete with the LCP.
  if (media) {
    const start = () => mountLazyVideo(media);
    if (document.readyState === 'complete') start();
    else addEventListener('load', () => start(), { once: true });
  }

  // The hero stays sticky-pinned behind the sections that cover it. Once covered, hide
  // its content — otherwise the CTA stays in the tab order while 100% obscured (WCAG
  // 2.4.11) — and report visibility to the video manager, which pauses the off-screen
  // loop and keeps the shared clock so the slogan band continues where this left off.
  if (hero && media) {
    let ticking = false;
    let covered = false;
    const update = () => {
      ticking = false;
      const isCovered = window.scrollY >= hero.offsetHeight;
      if (isCovered === covered) return;
      covered = isCovered;
      hero.classList.toggle('hero--covered', covered);
      setVideoInView(media, !covered);
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>
