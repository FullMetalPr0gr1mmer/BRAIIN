---
import type { Locale } from '@schemas/primitives';
import type { GallerySectionContent } from '@schemas/sections';
import { pickLocale } from '@/lib/i18n';
import type { ImageRef } from '@/lib/media/resolve';
import { galleryColumns } from '@/lib/sections/blocks';
import MediaImage from '@/components/media/MediaImage.astro';
import AccentText from '@/components/ui/AccentText.astro';

// A Gallery (Admin v2 E10, the prototype's "Borderless image grid"): up to twelve pictures
// from the media library on paper, any number of galleries a page.
//
// The pictures are media library images referenced by `mediaId`, resolved by SectionRenderer's
// one read of the page's section media (getSectionImages: 0024's and 0102's anon policy,
// PUBLIC_MEDIA_COLUMNS, a locked page's own unlocked read) and handed here as route data
// (`data.images`), so only a picture a visible section of a published page names resolves; one
// that does not is left out, and with none the section renders nothing. Each is
// a lazy <Picture> with the file's width and height, cropped to a cell of a fixed shape (CLS
// 0), with the library's alt text in the page's language: the pictures are the content here.
// The columns follow the count (galleryColumns, on the server), so two pictures are two
// halves, not two thirds and a hole.
// No lightbox: a picture is shown at its column's width, and nothing opens.

interface Props extends GallerySectionContent {
  locale: Locale;
  /** Route data (SectionRenderer): the page's section media, resolved in one read. */
  data?: { images?: ReadonlyMap<string, ImageRef> } | undefined;
}

const { locale, tag, heading, accent, items = [], data } = Astro.props;

const tagText = tag ? pickLocale(tag, locale) : '';
const headingText = heading ? pickLocale(heading, locale) : '';
const pictures = items.flatMap((item) => {
  const image = data?.images?.get(item.mediaId);
  return image ? [image] : [];
});
const columns = galleryColumns(pictures.length);
const sizes = columns === 1 ? '100vw' : `(min-width: 47.5rem) ${Math.ceil(100 / columns)}vw, 50vw`;
---

{
  pictures.length > 0 && (
    <section class="blk-gal">
      {(tagText || headingText) && (
        <div class="blk-wrap">
          {tagText && (
            <p class="tag rv">
              <span class="dot" />
              <span>{tagText}</span>
            </p>
          )}
          {headingText && (
            <h2 class="blk-head rv">
              <AccentText text={headingText} locale={locale} accent={accent} />
            </h2>
          )}
        </div>
      )}
      <ul class:list={['blk-gal__grid', `blk-gal__grid--${columns}`]} role="list">
        {pictures.map((image) => (
          <li class="blk-gal__item">
            <MediaImage image={image} locale={locale} widths={[480, 800, 1200]} sizes={sizes} />
          </li>
        ))}
      </ul>
    </section>
  )
}
