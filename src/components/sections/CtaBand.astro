---
import type { Locale } from '@schemas/primitives';
import type { CtaSectionContent } from '@schemas/sections';
import { localizedPath, pickLocale } from '@/lib/i18n';

// CMS-overridable copy (CtaSectionContentSchema); built-in defaults below.
interface Props extends CtaSectionContent {
  locale: Locale;
}

const { locale, heading, text, buttonLabel } = Astro.props;

const STR = {
  en: {
    heading: 'Have a project in mind?',
    text: "Tell us what you're building — we'll shape it.",
    button: 'Start a project',
  },
  ar: {
    heading: 'لديك مشروع؟',
    text: 'أخبرنا بما تبنيه وسنساعدك على تشكيله.',
    button: 'ابدأ مشروعًا',
  },
}[locale];
---

<section class="cta-band">
  <div class="container">
    <h2>{heading ? pickLocale(heading, locale) : STR.heading}</h2>
    <p>{text ? pickLocale(text, locale) : STR.text}</p>
    <a class="cta" href={localizedPath('/contact', locale)}>
      {buttonLabel ? pickLocale(buttonLabel, locale) : STR.button}
    </a>
  </div>
</section>
