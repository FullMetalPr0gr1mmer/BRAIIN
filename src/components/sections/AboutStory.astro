---
import type { Locale } from '@schemas/primitives';
import type { AboutStorySectionContent } from '@schemas/sections';
import { pickLocale } from '@/lib/i18n';
import { getIdentity, brandName } from '@/lib/identity';
import { ABOUT_STORY_COPY as COPY } from '@/lib/sections/copy/aboutStory';
import { fillBrand } from '@/lib/sections/copy/text';

// CMS-overridable copy (AboutStorySectionContentSchema) over the built-in story in
// src/lib/sections/copy/aboutStory.ts. The studio is named through `%brand%` — in the
// defaults AND in authored copy — so the public identity (site_profile) is the only place
// its name is spelled.
interface Props extends AboutStorySectionContent {
  locale: Locale;
}

const { locale, heading, lead, missionTitle, mission, visionTitle, vision } = Astro.props;

const brand = brandName(await getIdentity(Astro.locals), locale);
const text = (
  authored: Parameters<typeof pickLocale>[0],
  builtIn: { en: string; ar: string },
): string => fillBrand(authored ? pickLocale(authored, locale) : builtIn[locale], brand);
---

<section class="about-story">
  <div class="container">
    <h1>{text(heading, COPY.heading)}</h1>
    <p class="lead">{text(lead, COPY.lead)}</p>
    <div class="about-pillars">
      <div>
        <h2>{text(missionTitle, COPY.missionTitle)}</h2>
        <p>{text(mission, COPY.mission)}</p>
      </div>
      <div>
        <h2>{text(visionTitle, COPY.visionTitle)}</h2>
        <p>{text(vision, COPY.vision)}</p>
      </div>
    </div>
  </div>
</section>
