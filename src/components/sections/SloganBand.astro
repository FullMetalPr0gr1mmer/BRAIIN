---
import type { Locale } from '@schemas/primitives';
import type { SloganSectionContent } from '@schemas/sections';
import { pickLocale } from '@/lib/i18n';
import { SLOGAN_COPY } from '@/lib/sections/copy/slogan';

// Pinned slogan band — the ONLY overlaid section in the design. The word-by-word
// reveal is a CSS scroll-driven animation (compositor-only, zero JS) behind
// @supports; browsers without support (and reduced-motion visitors) see the slogan
// fully visible. The plain text lives in an sr-only span; the animated spans are
// presentation. Text + accent index are CMS-overridable (SloganSectionContentSchema) over
// the built-in slogan (src/lib/sections/copy/slogan.ts).

interface Props extends SloganSectionContent {
  locale: Locale;
  /** Local fallback loop (public/); a Stream source replaces it at KAN-20. */
  videoSrc?: string;
}

const { locale, videoSrc = '/media/showreel.mp4', text, accentFromEn, accentFromAr } = Astro.props;

const sloganText = text ? pickLocale(text, locale) : SLOGAN_COPY.text[locale];
const accentFrom =
  (locale === 'ar' ? accentFromAr : accentFromEn) ??
  (locale === 'ar' ? SLOGAN_COPY.accentFromAr : SLOGAN_COPY.accentFromEn);
const words = sloganText.split(/\s+/);
---

<section class="slogan">
  <div class="slogan__pin">
    <div class="slogan__media" data-video-src={videoSrc}></div>
    <div class="slogan__overlay"></div>
    <div class="slogan__inner">
      <p>
        <span class="sr-only">{sloganText}</span>
        {
          words.map((w, i) => (
            <span class:list={['sw', { ac: i >= accentFrom }]} aria-hidden="true">
              {w}
            </span>
          ))
        }
      </p>
    </div>
    <div class="slogan__rule" aria-hidden="true"></div>
  </div>
</section>

<script>
  import { mountLazyVideo, setVideoInView } from '@/lib/client/lazyVideo';

  // Two observers, two jobs. MOUNT on intersection — CLAUDE.md §6 says "zero video bytes
  // before intersection", and tests/e2e/media-bytes.e2e.ts asserts it literally. This
  // used to preload one viewport early (`rootMargin: '100% 0px'`), which fetched video
  // for a band the visitor could not yet see. The poster covers the gap until frames are
  // decodable (`.has-video` cross-fade). PLAY only while the pinned band is actually on
  // screen: the manager pauses it off-screen and, when the source matches the hero's,
  // hands over the shared clock so the loop continues instead of restarting.
  const pin = document.querySelector<HTMLElement>('.slogan__pin');
  const media = document.querySelector<HTMLElement>('.slogan__media');
  if (pin && media) {
    setVideoInView(media, false); // not on screen at load; flips when the pin arrives
    const preload = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          preload.disconnect();
          mountLazyVideo(media);
        }
      },
      { rootMargin: '0px' },
    );
    preload.observe(media);

    const visibility = new IntersectionObserver((entries) => {
      for (const e of entries) setVideoInView(media, e.isIntersecting);
    });
    visibility.observe(pin);
  }
</script>
