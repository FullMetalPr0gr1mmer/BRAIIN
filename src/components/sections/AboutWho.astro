---
import type { Locale } from '@schemas/primitives';
import type { AboutWhoSectionContent } from '@schemas/sections';
import { pickLocale } from '@/lib/i18n';
import type { SectionImages } from '@/lib/sections/blocks';
import SplitHeading from '@/components/ui/SplitHeading.astro';
import MediaFrame from '@/components/media/MediaFrame.astro';
import { ABOUT_WHO_COPY as COPY } from '@/lib/sections/copy/aboutWho';

// About "Who we are" (UI v2 PR8 — the mockup's `.who`): mist band, the page's <h1> split
// per word on the server (SplitHeading: aria-label = the plain text, the word spans are
// aria-hidden), then the media frame beside the manifesto. Copy is the design's, verbatim
// (src/lib/sections/copy/aboutWho.ts), overridable per field from the CMS
// (AboutWhoSectionContentSchema).
//
// The poster is the page's LCP element (CLAUDE.md §6): eager, fetchpriority high, real
// dimensions, and NOT reveal-gated (the mockup faded it in with `.rv`, which would delay
// LCP until an IntersectionObserver fired). With no poster the section is text only — the
// code default carries none (the poster is seeded content, never a code fallback).

interface Props extends AboutWhoSectionContent {
  locale: Locale;
  /**
   * Route data (SectionRenderer): the page's section media, resolved in one read with the
   * other sections' (src/lib/data/sectionMedia.ts), never read here.
   */
  data?: { images?: SectionImages } | undefined;
}

const { locale, tag, heading, accent, lead, paragraphs, mediaId, clip, data } = Astro.props;
// The page's section media (route data): SectionRenderer starts the one read, and only a
// section with media waits for it, here.
const images = await data?.images;

const headingText = heading ? pickLocale(heading, locale) : COPY.heading[locale];
// An authored heading keeps only an authored accent (the default's range would land on the
// wrong words).
const headingAccent = heading ? accent : (accent ?? COPY.accent);
const paras = paragraphs?.length
  ? paragraphs.map((p) => ({
      title: pickLocale(p.title, locale),
      body: pickLocale(p.body, locale),
    }))
  : COPY.paragraphs.map((p) => ({ title: p.title[locale], body: p.body[locale] }));
const image = (mediaId && images?.get(mediaId)) || null;
---

<section class:list={['about-who', { 'about-who--text': !image }]} id="who">
  <div class="about-who__wrap">
    <p class="tag">
      <span class="dot"></span><span>{tag ? pickLocale(tag, locale) : COPY.tag[locale]}</span>
    </p>
    <SplitHeading text={headingText} locale={locale} accent={headingAccent} />
    <div class="about-who__row">
      {
        image && (
          <MediaFrame
            image={image}
            locale={locale}
            clip={clip ?? null}
            ratio="who"
            threshold={0.3}
            decorative
            priority
            sizes="(min-width: 53.75rem) 52vw, 100vw"
            widths={[480, 800, 1200]}
            class="about-who__media"
          />
        )
      }
      {/* Text-only, the manifesto is the LCP block: not reveal-gated then. */}
      <div class:list={['about-who__copy', { rv: !!image }]}>
        <p class="about-who__lead">{lead ? pickLocale(lead, locale) : COPY.lead[locale]}</p>
        {
          paras.map((p) => (
            <p>
              <b>{p.title}</b> {p.body}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
