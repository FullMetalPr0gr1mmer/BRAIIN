---
import type { Locale } from '@schemas/primitives';
import type { AboutIntroSectionContent } from '@schemas/sections';
import { pickLocale } from '@/lib/i18n';
import { brandName, getIdentity } from '@/lib/identity';
import { ABOUT_INTRO_COPY as COPY } from '@/lib/sections/copy/aboutIntro';
import { fillBrand } from '@/lib/sections/copy/text';
import { splitBold } from '@/lib/text/heroLinks';

// Home "Why {brand}" — the mist block after the services list (UI v2 PR7; it used to be
// the paper "Who we are" band right under the hero). Copy is the approved design's
// (src/lib/sections/copy/aboutIntro.ts), overridable per-field from the CMS
// (page_sections.content, AboutIntroSectionContentSchema). The default tag names the brand
// from the public identity, so a rename is a CMS edit. Distinct from AboutStory, which is
// the /about page hero and owns that page's <h1>.

interface Props extends AboutIntroSectionContent {
  locale: Locale;
}

const { locale, tag, heading, lead, columns } = Astro.props;

// Normalise authored columns to {t, d} once, up here.
const colsResolved = (columns ?? []).map((c) => ({
  t: pickLocale(c.title, locale),
  d: pickLocale(c.body, locale),
}));

const brand = brandName(await getIdentity(Astro.locals), locale);

// The built-in copy (src/lib/sections/copy/aboutIntro.ts). Its heading bolds one run
// (`<b>…</b>`, split into text and a <b> element, never injected); an authored heading is
// plain text.
const tagText = tag ? pickLocale(tag, locale) : fillBrand(COPY.tag[locale], brand);
const builtInHeading = splitBold(COPY.heading[locale]);
const cols =
  colsResolved.length > 0
    ? colsResolved
    : COPY.columns.map((c) => ({ t: c.title[locale], d: c.body[locale] }));
---

<section class="about-intro" id="about">
  <div class="section-wrap">
    <div class="tag rv">
      <span class="dot"></span><span>{tagText}</span>
    </div>
    <h2 class="rv">
      {
        heading
          ? pickLocale(heading, locale)
          : builtInHeading.map((r) => (r.bold ? <b>{r.text}</b> : r.text))
      }
    </h2>
    <p class="about-intro__lead rv">{lead ? pickLocale(lead, locale) : COPY.lead[locale]}</p>
    <div class="about-intro__cols">
      {
        cols.map((c) => (
          <div class="rv">
            <h3>{c.t}</h3>
            <p>{c.d}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
