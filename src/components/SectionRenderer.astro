---
import type { Locale } from '@schemas/primitives';
import type { SectionData } from '@/lib/sections/types';
import { isRenderedSectionType, type RenderedSectionType } from '@/lib/sections/registry';
import SectionBoundary from '@/components/SectionBoundary.astro';
import Hero from '@/components/sections/Hero.astro';
import ServicesOverview from '@/components/sections/ServicesOverview.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import SocialStrip from '@/components/sections/SocialStrip.astro';
import AboutStory from '@/components/sections/AboutStory.astro';
import Statistics from '@/components/sections/Statistics.astro';
import TeamGrid from '@/components/sections/TeamGrid.astro';
import Certifications from '@/components/sections/Certifications.astro';
import ClientsMarquee from '@/components/sections/ClientsMarquee.astro';
import AboutIntro from '@/components/sections/AboutIntro.astro';
import SloganBand from '@/components/sections/SloganBand.astro';
import HomeContact from '@/components/sections/HomeContact.astro';
import ContactInquiry from '@/components/sections/ContactInquiry.astro';
import ContactChannels from '@/components/sections/ContactChannels.astro';
import FaqAccordion from '@/components/sections/FaqAccordion.astro';
import SelectedWork from '@/components/sections/SelectedWork.astro';
import TestimonialsSection from '@/components/sections/TestimonialsSection.astro';
import AboutWho from '@/components/sections/AboutWho.astro';
import LeadershipSlider from '@/components/sections/LeadershipSlider.astro';

interface Props {
  locale: Locale;
  sections: SectionData[];
}

const { locale, sections } = Astro.props;

// Type → component registry. Unknown types are skipped (forward-compatible with CMS).
//
// A section's CMS content arrives as its `props`. Data the ROUTE injects (rows it already
// loaded) arrives as `data`, passed AFTER the spread so no authored key can override it —
// content is editor input, route data is the page's own truth.
//
// Typed against src/lib/sections/registry.ts: `astro check` fails if a rendered type has
// no component here or a component has no registry entry. The value type is "any
// component" (`(props: never) => unknown` — every function is one), not `typeof Hero`:
// holding every component to Hero's Props made two sections with differently shaped
// route `data` props unassignable to each other (UI v2 PR7).
type AnyComponent = (props: never) => unknown;
const REGISTRY: Record<RenderedSectionType, AnyComponent> = {
  hero: Hero,
  servicesOverview: ServicesOverview,
  cta: CtaBand,
  social: SocialStrip,
  aboutStory: AboutStory,
  statistics: Statistics,
  team: TeamGrid,
  certifications: Certifications,
  clientsMarquee: ClientsMarquee,
  aboutIntro: AboutIntro,
  slogan: SloganBand,
  contact: HomeContact,
  contactInquiry: ContactInquiry,
  contactChannels: ContactChannels,
  faq: FaqAccordion,
  selectedWork: SelectedWork,
  testimonials: TestimonialsSection,
  aboutWho: AboutWho,
  leadership: LeadershipSlider,
};

// Every section takes `locale`, its content props and the route's `data`. The map's type
// above is what holds the registry complete; this view of it is what the template renders.
type AnySection = (props: Record<string, unknown>) => unknown;
const COMPONENTS = REGISTRY as unknown as Record<RenderedSectionType, AnySection>;
---

{
  sections
    .filter((s) => s.visible !== false)
    .map((s) => {
      if (!isRenderedSectionType(s.type)) return null;
      const Comp = COMPONENTS[s.type];
      return (
        <SectionBoundary type={s.type}>
          <Comp locale={locale} {...(s.props ?? {})} data={s.data} />
        </SectionBoundary>
      );
    })
}
