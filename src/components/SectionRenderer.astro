---
import type { Locale } from '@schemas/primitives';
import type { SectionData } from '@/lib/sections/types';
import { isRenderedSectionType, type RenderedSectionType } from '@/lib/sections/registry';
import { SECTION_MEDIA_TYPES, sectionMediaIds } from '@/lib/sections/blocks';
import { getSectionImages } from '@/lib/data/sectionMedia';
import { reportLoadError } from '@/lib/data/parse';
import type { ImageRef } from '@/lib/media/resolve';
import SectionBoundary from '@/components/SectionBoundary.astro';
import Hero from '@/components/sections/Hero.astro';
import ServicesOverview from '@/components/sections/ServicesOverview.astro';
import LeadBand from '@/components/sections/LeadBand.astro';
import SocialStrip from '@/components/sections/SocialStrip.astro';
import AboutStory from '@/components/sections/AboutStory.astro';
import Statistics from '@/components/sections/Statistics.astro';
import TeamGrid from '@/components/sections/TeamGrid.astro';
import Certifications from '@/components/sections/Certifications.astro';
import ClientsMarquee from '@/components/sections/ClientsMarquee.astro';
import AboutIntro from '@/components/sections/AboutIntro.astro';
import SloganBand from '@/components/sections/SloganBand.astro';
import HomeContact from '@/components/sections/HomeContact.astro';
import ContactInquiry from '@/components/sections/ContactInquiry.astro';
import ContactChannels from '@/components/sections/ContactChannels.astro';
import FaqAccordion from '@/components/sections/FaqAccordion.astro';
import SelectedWork from '@/components/sections/SelectedWork.astro';
import TestimonialsSection from '@/components/sections/TestimonialsSection.astro';
import AboutWho from '@/components/sections/AboutWho.astro';
import LeadershipSlider from '@/components/sections/LeadershipSlider.astro';
import WorkHero from '@/components/sections/WorkHero.astro';
import ProofBand from '@/components/sections/ProofBand.astro';
import WorkIntro from '@/components/sections/WorkIntro.astro';
import ProjectGrid from '@/components/sections/ProjectGrid.astro';
import PageHead from '@/components/sections/PageHead.astro';
import ProjectCatalog from '@/components/sections/ProjectCatalog.astro';
import Hello from '@/components/sections/Hello.astro';
import ServiceExplorer from '@/components/sections/ServiceExplorer.astro';
import JoinWhy from '@/components/sections/JoinWhy.astro';
import JoinSteps from '@/components/sections/JoinSteps.astro';
import JoinApply from '@/components/sections/JoinApply.astro';
import TextBlock from '@/components/sections/TextBlock.astro';
import Gallery from '@/components/sections/Gallery.astro';
import VideoBlock from '@/components/sections/VideoBlock.astro';

interface Props {
  locale: Locale;
  sections: SectionData[];
}

const { locale, sections } = Astro.props;
// The releases preview (Admin v2 R9) marks each section for the page editor's bridge
// (`data-pv-section`: the row's id, or `default-<n>` for a built-in composition). Only in a
// preview render: a public page's markup is unchanged.
const preview = Astro.locals.preview !== undefined;

// Type → component registry. Unknown types are skipped (forward-compatible with CMS).
//
// A section's CMS content arrives as its `props`. Data the ROUTE injects (rows it already
// loaded) arrives as `data`, passed AFTER the spread so no authored key can override it —
// content is editor input, route data is the page's own truth.
//
// Typed against src/lib/sections/registry.ts: `astro check` fails if a rendered type has
// no component here or a component has no registry entry. The value type is "any
// component" (`(props: never) => unknown` — every function is one), not `typeof Hero`:
// holding every component to Hero's Props made two sections with differently shaped
// route `data` props unassignable to each other (UI v2 PR7).
type AnyComponent = (props: never) => unknown;
const REGISTRY: Record<RenderedSectionType, AnyComponent> = {
  hero: Hero,
  servicesOverview: ServicesOverview,
  cta: LeadBand,
  social: SocialStrip,
  aboutStory: AboutStory,
  statistics: Statistics,
  team: TeamGrid,
  certifications: Certifications,
  clientsMarquee: ClientsMarquee,
  aboutIntro: AboutIntro,
  slogan: SloganBand,
  contact: HomeContact,
  contactInquiry: ContactInquiry,
  contactChannels: ContactChannels,
  faq: FaqAccordion,
  selectedWork: SelectedWork,
  testimonials: TestimonialsSection,
  aboutWho: AboutWho,
  leadership: LeadershipSlider,
  // UI v2 PR10 — Our Work and All projects
  workHero: WorkHero,
  proof: ProofBand,
  workIntro: WorkIntro,
  projectGrid: ProjectGrid,
  pageHead: PageHead,
  projectCatalog: ProjectCatalog,
  // Round 2 (services)
  hello: Hello,
  serviceExplorer: ServiceExplorer,
  // Join
  joinWhy: JoinWhy,
  joinSteps: JoinSteps,
  joinApply: JoinApply,
  // Admin v2 E10: blocks any page may take
  textBlock: TextBlock,
  gallery: Gallery,
  video: VideoBlock,
};

// Every section takes `locale`, its content props and the route's `data`. The map's type
// above is what holds the registry complete; this view of it is what the template renders.
type AnySection = (props: Record<string, unknown>) => unknown;
const COMPONENTS = REGISTRY as unknown as Record<RenderedSectionType, AnySection>;

const shown = sections.filter((s) => s.visible !== false);

// The page's section media in ONE read (Admin v2 E10 review): every media library id the shown
// sections name (a Gallery's pictures, a Video's still, About's poster, Our Work's frames),
// resolved together through the gated read (src/lib/data/sectionMedia.ts: PUBLIC_MEDIA_COLUMNS,
// 0024's and 0102's anon policy, a password page's own unlocked read), so the page's
// subrequests do not grow with its blocks. Pages whose sections name no media ask nothing.
//
// STARTED HERE, AWAITED IN THE MEDIA SECTIONS (E10 code review, CR3). The read starts before
// any section renders (its page scope is read synchronously, as the loaders' rule asks), and
// only a media section awaits it, inside its own SectionBoundary: the hero and every section
// without media render without waiting for it, and a failed read (a throw anywhere on its way,
// reported once) is an empty map, so the media sections render without their pictures and the
// page is never at stake. Each media section gets the promise as route data (`images`), after
// its authored props, so no content can supply or replace it.
const images: Promise<ReadonlyMap<string, ImageRef>> = (async () =>
  getSectionImages(sectionMediaIds(shown)))().catch((err: unknown) => {
  reportLoadError('section_media', err);
  return new Map<string, ImageRef>();
});

// The first shown section is the top of the page (no route renders a hero outside the
// sections), so a media section there is told so (`first`): the Video's still is then eager
// and high priority, as MediaBanner's poster is (E10 code review, CR10).
const dataOf = (s: SectionData, index: number): Record<string, unknown> | undefined =>
  SECTION_MEDIA_TYPES.includes(s.type) ? { ...s.data, images, first: index === 0 } : s.data;
---

{
  shown.map((s, i) => {
    if (!isRenderedSectionType(s.type)) return null;
    const Comp = COMPONENTS[s.type];
    return (
      <SectionBoundary
        type={s.type}
        {...(preview ? { previewId: s.id ?? `default-${String(i)}` } : {})}
      >
        <Comp locale={locale} {...(s.props ?? {})} data={dataOf(s, i)} />
      </SectionBoundary>
    );
  })
}
