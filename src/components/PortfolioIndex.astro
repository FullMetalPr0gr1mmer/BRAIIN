---
import type { Locale } from '@schemas/primitives';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildBreadcrumbSchema } from '@/lib/seo/jsonld';
import { localizedPath, pickLocale } from '@/lib/i18n';
import { PUBLIC_SITE_URL } from 'astro:env/client';
import type { PortfolioRow } from '@/lib/data/portfolio';
import { loadHead } from '@/lib/seo/head';

interface Props {
  locale: Locale;
  items: PortfolioRow[];
}

const { locale, items } = Astro.props;

const STR = {
  en: {
    title: 'Portfolio',
    intro: 'Selected work from across our fourteen creative services.',
    empty: 'Case studies will appear here once published.',
    home: 'Home',
  },
  ar: {
    title: 'أعمالنا',
    intro: 'مختارات من أعمالنا عبر خدماتنا الإبداعية الأربع عشرة.',
    empty: 'ستظهر دراسات الحالة هنا بعد نشرها.',
    home: 'الرئيسية',
  },
}[locale];

const base = PUBLIC_SITE_URL.replace(/\/$/, '');
const breadcrumb = buildBreadcrumbSchema([
  { name: STR.home, url: base + localizedPath('/', locale) },
  { name: STR.title, url: base + localizedPath('/portfolio', locale) },
]);
// Tenant defaults + this route's own title/blurb, the brand from the public identity
// through the title template — one concurrent round (src/lib/seo/head.ts).
const { seo } = await loadHead(Astro.locals, {
  locale,
  fallbackTitle: STR.title,
  fallbackDescription: STR.intro,
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  logicalPath="/portfolio"
  jsonLd={[breadcrumb]}
  robots={seo.robots}
  {...seo.ogImage ? { ogImage: seo.ogImage } : {}}
>
  <main class="container">
    <h1>{STR.title}</h1>
    <p class="lead">{STR.intro}</p>
    {
      items.length === 0 ? (
        <p class="notice">{STR.empty}</p>
      ) : (
        <ul class="service-grid">
          {items.map((p) => (
            <li class="service-card">
              <a href={localizedPath(`/portfolio/${p.slug}`, locale)}>
                <h2>{pickLocale(p.title, locale, p.slug)}</h2>
                {p.summary ? <p>{pickLocale(p.summary, locale)}</p> : null}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
