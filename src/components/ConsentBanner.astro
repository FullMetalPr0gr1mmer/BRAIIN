---
// PDPL consent banner. Server-rendered, fixed-position (no CLS), hidden until the
// bundled script (CSP-safe, external) decides a current choice is missing. Writes
// the __Host-consent cookie and dispatches `consent-updated` to start analytics.
//
// Localized with the page: an Arabic page asks in Arabic and links to the Arabic cookie
// policy (it used to be English-only on /ar, linking to the English policy — a consent
// request the visitor may not be able to read is not informed consent). The copy is legal
// / system text, so the Arabic is MSA (owner decision 6); it inherits lang/dir from <html>.
import type { Locale } from '@schemas/primitives';
import { CONSENT_VERSION } from '@consent/gate';
import { localizedPath } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const STR = {
  en: {
    region: 'Cookie consent',
    before:
      'We use functional cookies to run the site, and — only with your consent — first-party analytics to improve it. See our',
    policy: 'Cookie Policy',
    after: '.',
    reject: 'Reject non-essential',
    accept: 'Accept analytics',
  },
  ar: {
    region: 'الموافقة على ملفات تعريف الارتباط',
    before:
      'نستخدم ملفات تعريف الارتباط الوظيفية لتشغيل الموقع، ولا نستخدم التحليلات الخاصة بنا لتحسينه إلا بموافقتك. اطّلع على',
    policy: 'سياسة ملفات تعريف الارتباط',
    after: '.',
    reject: 'رفض غير الضرورية',
    accept: 'قبول التحليلات',
  },
}[locale];
---

<div
  id="consent-banner"
  class="consent-banner"
  data-version={CONSENT_VERSION}
  hidden
  role="region"
  aria-label={STR.region}
>
  <p class="consent-text">
    {STR.before}
    <a href={localizedPath('/cookie-policy', locale)}>{STR.policy}</a>{STR.after}
  </p>
  <div class="consent-actions">
    <button type="button" data-consent="reject">{STR.reject}</button>
    <button type="button" data-consent="accept">{STR.accept}</button>
  </div>
</div>

<script>
  const banner = document.getElementById('consent-banner');
  if (banner) {
    const VERSION = Number(banner.dataset.version || '1');
    const COOKIE = '__Host-consent';

    const read = () => {
      const match = document.cookie.split('; ').find((c) => c.startsWith(COOKIE + '='));
      if (!match) return null;
      try {
        return JSON.parse(decodeURIComponent(match.slice(COOKIE.length + 1)));
      } catch {
        return null;
      }
    };

    const write = (analytics: boolean) => {
      const state = {
        functional: true,
        analytics,
        marketing: false,
        v: VERSION,
        ts: Math.floor(Date.now() / 1000),
      };
      const value = encodeURIComponent(JSON.stringify(state));
      // __Host- requires Secure + Path=/ + no Domain. (Not set over http://localhost.)
      document.cookie = `${COOKIE}=${value}; Path=/; Secure; SameSite=Lax; Max-Age=15552000`;
      banner.hidden = true;
      document.dispatchEvent(new CustomEvent('consent-updated', { detail: state }));
    };

    const current = read();
    if (!current || current.v !== VERSION) banner.hidden = false;

    banner.querySelector('[data-consent="accept"]')?.addEventListener('click', () => write(true));
    banner.querySelector('[data-consent="reject"]')?.addEventListener('click', () => write(false));
  }
</script>
