---
// Emits one JSON-LD block. `application/ld+json` is non-executable data, so it is
// not subject to script-src and passes the strict, no-unsafe-inline CSP.
//
// Serialised with serializeForScript, never a bare JSON.stringify: this is `set:html`,
// so a CMS string containing `</script>` would otherwise close the element and inject
// markup into the page (see src/lib/seo/serialize.ts).
import type { JsonLdNode } from '@/lib/seo/jsonld';
import { serializeForScript } from '@/lib/seo/serialize';

interface Props {
  data: JsonLdNode;
}

const { data } = Astro.props;
const json = serializeForScript(data);
---

<script type="application/ld+json" is:inline set:html={json} />
