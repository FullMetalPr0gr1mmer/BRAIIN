---
import { Picture } from 'astro:assets';
import type { Locale } from '@schemas/primitives';
import { getNavigation, type NavNode } from '@/lib/data/navigation';
import { HEADER_FALLBACK } from '@/lib/nav/fallback';
import { isCurrentNav } from '@/lib/nav/current';
import { getIdentity, brandName } from '@/lib/identity';
import { localizedHref, localizedPath } from '@/lib/i18n';
import logo from '@/assets/braiin-logo-white.png';

// Sitewide header. Renders CMS-authored navigation (`public.navigation`, edited under
// /admin/navigation) with a code fallback (src/lib/nav/fallback.ts) so the site is never
// navigation-less before the content team authors it — or if the database is unreachable.
//
// ── Tier A, zero hydration ───────────────────────────────────────────────────────
// Server-rendered, no island. Navigation is indexable content and the indexability hard
// rule (Pillar 3) puts it in the HTML; it is also on every route, so any framework JS
// here would be JS on every route (Pillar 2). The small-screen menu is a `<details>`
// element — native disclosure, keyboard-accessible, zero bytes. The one script below is
// a scroll enhancement on top of a header that is fully usable without it.
//
// ── Two variants ─────────────────────────────────────────────────────────────────
//   overlay  the UI v2 header (every mockup page): fixed, transparent over the page's
//            hero, a dark blurred backdrop once past it, hidden while scrolling down.
//   solid    legacy interior pages with no hero: a sticky black bar that still hides on
//            the way down and returns on the way up.
// The mockup has no scrim on the bar itself; legibility over bright video comes from the
// hero's own top gradient (.hero__media::after), which is where it belongs.

export type HeaderVariant = 'overlay' | 'solid';

interface Props {
  locale: Locale;
  variant?: HeaderVariant;
  /** Overrides the language switch target (the 404 pages: see below). */
  langHref?: string;
}

const { locale, variant = 'solid', langHref } = Astro.props;

const identity = await getIdentity(Astro.locals);
const brand = brandName(identity, locale);

const authored = await getNavigation('header');
const items: NavNode[] = authored.length > 0 ? authored : HEADER_FALLBACK;
const key = items.find((i) => i.is_key);

const current = Astro.url.pathname;
const href = (raw: string) => localizedHref(raw, locale);
const ariaCurrent = (raw: string) => (isCurrentNav(href(raw), current) ? 'page' : undefined);
const label = (item: NavNode) => item.label[locale] ?? item.label.en;

// The language switch points at the SAME logical page in the other language, which is
// what makes it a language switch rather than a link home. Stripping the '/ar' prefix is
// the inverse of what localizedPath added.
const logical = current.replace(/^\/ar(?=\/|$)/, '') || '/';
const otherLocale: Locale = locale === 'ar' ? 'en' : 'ar';
// A page with no twin — a 404 — passes `langHref` (the other locale's home): switching the
// language of "this page does not exist" would otherwise link to itself, or to another 404.
const switchHref = langHref ?? localizedPath(logical, otherLocale);

const STR = {
  en: { skip: 'Skip to content', menu: 'Menu', nav: 'Main navigation' },
  ar: { skip: 'تخطَّ إلى المحتوى', menu: 'القائمة', nav: 'التنقل الرئيسي' },
}[locale];
---

<header class:list={['site-header', `site-header--${variant}`]} data-header={variant}>
  <a class="skip-link" href="#main">{STR.skip}</a>

  <div class="site-header__bar">
    <a class="site-header__brand" href={localizedPath('/', locale)} aria-label={brand}>
      <Picture
        src={logo}
        alt={brand}
        formats={['avif', 'webp']}
        width={264}
        densities={[1, 2]}
        decoding="async"
        loading="eager"
      />
    </a>

    {
      /* The mockup keeps exactly one link in the bar at <=900px — the key link. It is a
         second copy OUTSIDE the <details>, shown only at that width (global.css), so it
         stays one tap away while the full list lives in the menu. It sits BEFORE the
         toggle so the tab order runs logo → key link → menu → its panel → language. */
      key ? (
        <a class="site-header__key" href={href(key.href)} aria-current={ariaCurrent(key.href)}>
          {label(key)}
        </a>
      ) : null
    }

    {
      /*
      The <nav> is a SIBLING of the disclosure, not its content. A <details> hides
      everything except its <summary> whenever it is closed — and on wide screens the
      summary is `display: none` and nothing ever opens the element, so nesting the nav
      inside it made the entire main navigation invisible on every desktop viewport.
      As siblings, the small-screen panel is revealed with `.site-nav[open] ~
      .site-nav__panel` — a plain subsequent-sibling combinator, zero JS.
    */
    }
    <details class="site-nav">
      <summary class="site-nav__toggle" aria-label={STR.menu}>
        <span aria-hidden="true">☰</span>
      </summary>
    </details>

    <nav class="site-nav__panel" aria-label={STR.nav}>
      <ul class="site-nav__list">
        {
          items.map((item) => (
            <li class:list={{ 'is-key': item.is_key }}>
              <a href={href(item.href)} aria-current={ariaCurrent(item.href)}>
                {label(item)}
              </a>
              {item.children.length > 0 && (
                <ul class="site-nav__sub">
                  {item.children.map((child) => (
                    <li>
                      <a href={href(child.href)} aria-current={ariaCurrent(child.href)}>
                        {label(child)}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="site-header__lang" href={switchHref} hreflang={otherLocale} lang={otherLocale}>
      {otherLocale === 'ar' ? 'العربية' : 'English'}
    </a>
  </div>
</header>

<script>
  // Solid backdrop once past the page's hero, hidden while scrolling down, back on any
  // scroll up — the mockup's behaviour (±4px dead band), on both variants. rAF-throttled
  // and passive; everything here is enhancement.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const overlay = header.dataset.header === 'overlay';
    const menu = header.querySelector('details');
    // Following a link from the small-screen menu closes it. A same-page anchor
    // (/#services, on home) does not reload, so a <details> left open would stay pinned
    // over the very section the visitor asked for. The panel is the disclosure's SIBLING,
    // so the listener sits on the panel, not inside <details>.
    header.querySelector('.site-nav__panel')?.addEventListener('click', (event) => {
      if (menu?.open && (event.target as Element | null)?.closest('a')) menu.open = false;
    });
    let lastY = window.scrollY;
    let ticking = false;

    // Measure the hero rather than assuming it fills the viewport: the contact hero is a
    // banner (clamp(400px, 64svh, 760px)), and against a viewport-height threshold the
    // bar would stay transparent long past it — white-on-white over the paper below.
    // The solid bar has no hero to clear; it only needs to be out of the way of the top.
    // `[data-hero]`: a page that opens with another kind of head (Our Work's banner, All
    // projects' page head) marks it for this measurement.
    const hero = overlay ? document.querySelector<HTMLElement>('.hero, [data-hero]') : null;
    const measure = () => (overlay ? (hero?.offsetHeight ?? window.innerHeight) * 0.9 : 160);
    let threshold = measure();
    addEventListener('resize', () => (threshold = measure()), { passive: true });

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const past = y > threshold;
      if (overlay) header.classList.toggle('is-solid', past);
      // Never hide a header the visitor is using: an open menu, or focus inside it.
      const inUse = menu?.open === true || header.contains(document.activeElement);
      if (past && y - lastY > 4 && !inUse) header.classList.add('is-hidden');
      else if (y - lastY < -4 || y < threshold * 0.55) header.classList.remove('is-hidden');
      lastY = y;
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
