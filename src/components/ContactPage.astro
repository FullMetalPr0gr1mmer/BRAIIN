---
import type { Locale } from '@schemas/primitives';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getPageComposition } from '@/lib/data/pageSections';
import { getPublishedServices } from '@/lib/data/services';
import { buildBreadcrumbSchema, buildFaqSchema } from '@/lib/seo/jsonld';
import { localizedPath } from '@/lib/i18n';
import { loadHead } from '@/lib/seo/head';
import { PAGE_META } from '@/lib/seo/pageMeta';
import { CONTACT_FAQ } from '@/lib/content/contactFaq';
import {
  DEFAULT_CONTACT_SECTIONS,
  ensureContactInquiry,
  withHeroPreset,
} from '@/lib/sections/types';
import { faqShown, withContactData } from '@/lib/sections/contact';
import { PUBLIC_SITE_URL } from 'astro:env/client';

// Contact (UI v2 PR9) — a CMS-composed section page (`pages` slug 'contact' +
// `page_sections`, authored under /admin/pages + /admin/sections): banner hero → inquiry →
// channels → FAQ. The default composition renders until the page is composed.
//
// Three route-level guarantees sit on top of whatever the CMS says:
//   withHeroPreset('contact')  the hero is the contact banner with the contact copy — before
//                              PR9 it fell back to the HOME headline and "See our work";
//   ensureContactInquiry       the inquiry form (the one public write path) cannot be hidden
//                              or removed;
//   withContactData            the published services reach the form as route data.

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const STR = { en: { home: 'Home' }, ar: { home: 'الرئيسية' } }[locale];
const meta = PAGE_META.contact[locale];

// The composition, the head (whose per-page SEO override needs the page id, so it is handed
// the composition query rather than its result) and the services load together.
const compositionQuery = getPageComposition('contact');
const [composition, { seo }, services] = await Promise.all([
  compositionQuery,
  loadHead(Astro.locals, {
    locale,
    fallbackTitle: meta.title,
    fallbackDescription: meta.description,
    entity: compositionQuery.then((c) => (c ? { type: 'page' as const, id: c.page.id } : null)),
  }),
  getPublishedServices(),
]);
// A published page with no sections yet renders the default composition (its SEO override,
// keyed by the page id above, still applies).
const composed = composition?.sections.length ? composition.sections : DEFAULT_CONTACT_SECTIONS;
const sections = withContactData(ensureContactInquiry(withHeroPreset(composed, 'contact')), {
  services,
});

const base = PUBLIC_SITE_URL.replace(/\/$/, '');
const breadcrumb = buildBreadcrumbSchema([
  { name: STR.home, url: base + localizedPath('/', locale) },
  { name: meta.title, url: base + localizedPath('/contact', locale) },
]);

// FAQPage, built from the SAME array FaqAccordion renders — see contactFaq.ts — and only
// while the FAQ band renders. If the two ever disagree, the structured data describes
// content the page does not visibly contain, which is a manual-action category.
const jsonLd = faqShown(sections)
  ? [breadcrumb, buildFaqSchema(CONTACT_FAQ[locale].map((i) => ({ question: i.q, answer: i.a })))]
  : [breadcrumb];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  logicalPath="/contact"
  jsonLd={jsonLd}
  robots={seo.robots}
  {...seo.ogImage ? { ogImage: seo.ogImage } : {}}
  {...seo.canonicalOverride ? { canonicalOverride: seo.canonicalOverride } : {}}
  header="overlay"
>
  <main>
    <SectionRenderer locale={locale} sections={sections} />
  </main>
</BaseLayout>
