---
import type { Locale } from '@schemas/primitives';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { ogImageCandidates } from '@/lib/seo/ogImage';
import type { ContactPageData } from '@/lib/sections/contactPage';

// Contact (UI v2 PR9) — a CMS-composed section page (`pages` slug 'contact' +
// `page_sections`, authored under /admin/pages + /admin/sections): banner hero → inquiry →
// channels → FAQ. The default composition renders until the page is composed. Its data is
// loaded by the route (src/lib/sections/contactPage.ts, with the route-level guarantees), so
// the route can tag the sections it renders before it sets its headers (Admin v2 R7).

interface Props {
  locale: Locale;
  page: ContactPageData;
}

const { locale, page } = Astro.props;
const { sections, jsonLd } = page;
const { seo } = page.head;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  logicalPath="/contact"
  jsonLd={jsonLd}
  robots={seo.robots}
  ogImages={ogImageCandidates(seo)}
  {...seo.canonicalOverride ? { canonicalOverride: seo.canonicalOverride } : {}}
  header="overlay"
>
  <main>
    <SectionRenderer locale={locale} sections={sections} />
  </main>
</BaseLayout>
