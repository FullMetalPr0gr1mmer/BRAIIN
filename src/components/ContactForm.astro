---
import type { Locale } from '@schemas/primitives';
import { BUDGET_BANDS } from '@schemas/lead';
import { getIdentity } from '@/lib/identity';
import { CONTACT_FORM_COPY } from '@/lib/forms/contactCopy';
import Cta from '@/components/ui/Cta.astro';
import type { ContactFormVariant, ContactKind } from '@/lib/forms/contactPayload';
import { inquiryView } from '@/lib/forms/config';
import { formSettingsFor } from '@/lib/data/forms';
import { REQUIRED_CLAIM_INPUT, requiredClaimValue } from '@/lib/forms/requiredClaim';
import {
  initialServiceValue,
  serviceOptionGroups,
  type ServiceGroupInput,
} from '@/lib/forms/serviceSelect';

// The lead form — the site's one public write path (/api/contact: same-origin check, Zod,
// honeypot, tenant resolved server-side, PII envelope-encrypted).
//
//   compact  the home form of the UI v2 design: name, email, company, service, message;
//            "Send message" with a trailing arrow, the button before the note.
//   full     /contact's form (UI v2 PR9): the same plus the budget range and the
//            free-text deadline; the badge "Send a message", icon first, before the note.
//   hello    the services pages' "Say hello" form (Round 2): name, email, company, phone
//            (type=tel, dir=ltr — envelope-encrypted server-side), service, budget and
//            message; the full form's two columns and badge.
//
// The service select is grouped by discipline (Round 2, src/lib/forms/serviceSelect.ts):
// "Not sure yet", then per discipline an <optgroup label="01 Branding"> opening with
// "Branding, help me choose" (value `discipline:branding` → disciplineOfInterest) and its
// services (value = slug → serviceOfInterest). `selected` preselects one server-side (a
// service page preselects itself); a `[data-preselect="discipline:<slug>"]` link anywhere
// on the page sets it on click, but only while the select is empty or on a discipline.
// With no groups (a database outage) the select offers only "Not sure yet".
//
// ONE form per page: its ids (contact-form, cf-*) are fixed, and the scripts find it by
// them.
//
// Both carry the PDPL consent checkbox and the honeypot, post valued options (never a
// visible label — the budget bands are BUDGET_BAND_LABELS, the one map the admin and the
// CSV read too), and report the REAL outcome with per-field errors
// (src/lib/client/formErrors.ts). Which fields exist, and the JSON they become, is one
// list: src/lib/forms/contactPayload.ts — tested against LeadInputSchema's keys. The
// form's words are src/lib/forms/contactCopy.ts: the design's copy verbatim (its
// Saudi-voice Arabic); validation and system copy stays MSA (owner decision 6).
//
// Admin v2 E8: the forms config (Settings › Forms, `form_settings.inquiry`) may relabel the
// fields, reorder them, hide or require the optional ones, relabel the budget bands (their
// KEYS stay what is posted and stored) and reword the button. The form renders the published
// config server-side (src/lib/forms/config.ts inquiryView); /api/contact holds a submission
// to the same config, by the variant it names (`form`, the form's `data-form-variant`) and the
// optional fields it showed as required (the hidden `required_fields`, so a page drawn before
// a field became required still sends: src/lib/forms/requiredClaim.ts). A required select
// opens on "Choose one", never on the words of an answer ("Not sure yet", "Prefer to
// discuss") that the server would refuse.

export interface Props {
  locale: Locale;
  /** The disciplines with their services, in order (getPublishedDisciplines()). */
  groups: readonly ServiceGroupInput[];
  /** Preselect a service slug or `discipline:<slug>`; ignored when the select lacks it. */
  selected?: string | undefined;
  fields?: ContactFormVariant;
  /** Posted as the lead's `kind`. */
  kind?: ContactKind;
  /** CMS overrides from the surrounding section, already in this locale. */
  note?: string | undefined;
  okMessage?: string | undefined;
  submitLabel?: string | undefined;
}

const {
  locale,
  groups,
  selected,
  fields = 'full',
  kind = 'contact',
  note,
  okMessage,
  submitLabel,
} = Astro.props;
const compact = fields === 'compact';

// What this variant asks, in what order, with which labels, from the published forms config
// (Admin v2 E8, src/lib/forms/config.ts): with no row, exactly the built-in form.
const view = inquiryView((await formSettingsFor(Astro.locals)).inquiry, fields, locale);

// The form's words: src/lib/forms/contactCopy.ts (two differ by layout).
const COPY = CONTACT_FORM_COPY[locale];
const STR = {
  ...COPY,
  messagePh: compact ? COPY.messagePhCompact : COPY.messagePh,
  submit: compact ? COPY.submitCompact : COPY.submit,
};

const noteText = note ?? STR.note;
const okText = okMessage ?? STR.ok;
// The section's own button text, then the forms config's, then the variant's built-in one.
const submitText = submitLabel ?? view.button ?? STR.submit;

// The fallback mailbox in the 'form unavailable' message is the public identity's, so
// the one message shown when the form is down never names a stale address.
const { contactEmail } = await getIdentity(Astro.locals);

// The design's bands, in its order; "Prefer to discuss" is the empty option (no answer).
// The legacy bands stay accepted on input (cached pages) but are never offered.
const budgets = BUDGET_BANDS.map((k) => ({ value: k, label: view.budgets[k] }));

// The empty first option: an answer of its own while the field is optional ("Not sure yet,
// let's talk"), plainly not one when the config requires it (review finding CR2).
const emptyService = view.requiredOptional.includes('service') ? STR.chooseOne : STR.chooseService;
const emptyBudget = view.requiredOptional.includes('budget') ? STR.chooseOne : STR.chooseBudget;

const serviceGroups = serviceOptionGroups(groups, locale);
const serviceValue = initialServiceValue(serviceGroups, selected);
---

<form
  id="contact-form"
  class:list={[
    'contact-form',
    compact ? 'contact-form--compact' : 'contact-form--full',
    fields === 'hello' && 'contact-form--hello',
  ]}
  data-locale={locale}
  data-kind={kind}
  data-form-variant={fields}
  data-err-required={STR.errRequired}
  data-err-email={STR.errEmail}
  data-err-too-long={STR.errTooLong}
  data-err-invalid={STR.errInvalid}
  novalidate
>
  {
    view.fields.map(({ field, label, required }) =>
      field === 'name' ? (
        <div class="field">
          <label for="cf-name">{label}</label>
          <input
            id="cf-name"
            name="name"
            type="text"
            required
            maxlength="120"
            autocomplete="name"
            placeholder={STR.namePh}
          />
        </div>
      ) : field === 'email' ? (
        <div class="field">
          <label for="cf-email">{label}</label>
          <input
            id="cf-email"
            name="email"
            type="email"
            required
            maxlength="254"
            autocomplete="email"
            placeholder={STR.emailPh}
          />
        </div>
      ) : field === 'company' ? (
        <div class="field">
          <label for="cf-company">{label}</label>
          <input
            id="cf-company"
            name="company"
            type="text"
            required={required}
            maxlength="120"
            autocomplete="organization"
            placeholder={required ? undefined : STR.companyPh}
          />
        </div>
      ) : field === 'phone' ? (
        <div class="field">
          <label for="cf-phone">{label}</label>
          <input
            id="cf-phone"
            name="phone"
            type="tel"
            dir="ltr"
            required={required}
            maxlength="32"
            autocomplete="tel"
            inputmode="tel"
            placeholder={STR.phonePh}
          />
        </div>
      ) : field === 'service' ? (
        <div class="field">
          <label for="cf-service">{label}</label>
          <select id="cf-service" name="service" required={required}>
            <option value="" selected={serviceValue === ''}>
              {emptyService}
            </option>
            {serviceGroups.map((g) => (
              <optgroup label={g.label}>
                {g.options.map((o) => (
                  <option value={o.value} selected={o.value === serviceValue}>
                    {o.label}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>
      ) : field === 'budget' ? (
        <div class="field">
          <label for="cf-budget">{label}</label>
          <select id="cf-budget" name="budget" required={required}>
            <option value="">{emptyBudget}</option>
            {budgets.map((b) => (
              <option value={b.value}>{b.label}</option>
            ))}
          </select>
        </div>
      ) : field === 'deadline' ? (
        <div class="field">
          <label for="cf-deadline">{label}</label>
          <input
            id="cf-deadline"
            name="deadline"
            type="text"
            required={required}
            maxlength="120"
            autocomplete="off"
            placeholder={STR.deadlinePh}
          />
        </div>
      ) : (
        <div class="field field-full">
          <label for="cf-message">{label}</label>
          <textarea
            id="cf-message"
            name="message"
            required
            maxlength="5000"
            placeholder={STR.messagePh}
          />
        </div>
      ),
    )
  }
  <div class="field field-full field-check">
    <input id="cf-consent" name="consent" type="checkbox" />
    <label for="cf-consent">{STR.consent}</label>
  </div>
  {/* Honeypot — visually hidden; bots fill it, the schema rejects a non-empty value. */}
  <div class="hp-field" aria-hidden="true">
    <label for="cf-hp">Leave this field empty</label>
    <input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input
    type="hidden"
    name={REQUIRED_CLAIM_INPUT}
    value={requiredClaimValue(view.requiredOptional)}
  />
  <div class="contact-form__foot field-full">
    {
      compact ? (
        <button type="submit" class="cta cta--trail">
          <span>{submitText}</span>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path
              d="M2 8h12M9 3l5 5-5 5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      ) : (
        <Cta type="submit" icon="go">
          {submitText}
        </Cta>
      )
    }
    <p class="contact-form__note">{noteText}</p>
  </div>
  <p
    id="contact-status"
    class="form-status"
    role="status"
    aria-live="polite"
    tabindex="-1"
    hidden
    data-sending={STR.sending}
    data-ok={okText}
    data-invalid={STR.invalid}
    data-rate-limited={STR.rateLimited}
    data-unavailable={STR.unavailable.replace('{email}', () => contactEmail)}
    data-error={STR.error}
  >
  </p>
</form>

<script>
  import {
    checkForm,
    clearErrorsOnInput,
    showFieldErrors,
    showStatus,
    statusFromHttp,
    type FieldProblem,
  } from '@/lib/client/formErrors';
  import { buildContactPayload, leadKeysToFields, variantOfForm } from '@/lib/forms/contactPayload';
  import { preselectValue } from '@/lib/forms/serviceSelect';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status') as HTMLElement | null;
  const service = document.getElementById('cf-service') as HTMLSelectElement | null;

  // "Start your Branding project" (S3's explorer CTA) and any other
  // [data-preselect="discipline:<slug>"] link: the click still follows the link (to the
  // form's #inquiry), and the select takes the discipline unless the visitor already chose
  // a specific service. Delegated, so links rendered anywhere on the page are covered.
  if (service) {
    document.addEventListener('click', (e) => {
      const link = e.target instanceof Element ? e.target.closest('[data-preselect]') : null;
      const wanted = link?.getAttribute('data-preselect');
      if (!wanted) return;
      const available = [...service.options].map((o) => o.value);
      const next = preselectValue(service.value, wanted, available);
      if (next === null) return;
      service.value = next;
      service.dispatchEvent(new Event('change', { bubbles: true }));
    });
  }

  if (form && status) {
    const d = form.dataset;
    const messages: Record<FieldProblem, string> = {
      required: d['errRequired'] ?? '',
      email: d['errEmail'] ?? '',
      tooLong: d['errTooLong'] ?? '',
      invalid: d['errInvalid'] ?? '',
      // No link fields on this form (the https rule is the Join application's).
      url: d['errInvalid'] ?? '',
    };
    let busy = false;
    clearErrorsOnInput(form);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return;

      // The client check mirrors the server's bounds, so most mistakes are named before a
      // round trip; the server remains the gate.
      const problems = checkForm(form);
      showFieldErrors(form, problems, messages);
      if (problems.size > 0) {
        showStatus(form, status, 'invalid');
        return;
      }

      const fd = new FormData(form);
      const payload = buildContactPayload((k) => fd.get(k), {
        kind: d['kind'] === 'project_inquiry' ? 'project_inquiry' : 'contact',
        locale: d['locale'] ?? 'en',
        form: variantOfForm(d['formVariant']),
      });
      busy = true;
      showStatus(form, status, 'sending');
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const outcome = statusFromHttp(res.status);
        if (outcome === 'invalid') {
          // The server names the schema keys it refused; mark those controls too.
          const body = (await res.json().catch(() => null)) as { fields?: unknown } | null;
          const named = leadKeysToFields(Array.isArray(body?.fields) ? body.fields : []);
          showFieldErrors(form, new Map(named.map((f) => [f, 'invalid' as const])), messages);
        }
        if (outcome === 'ok') form.reset();
        showStatus(form, status, outcome);
      } catch {
        showStatus(form, status, 'error');
      } finally {
        busy = false;
      }
    });
  }
</script>
