---
import { visibleNav } from '@/lib/admin/nav';

// Tier C shell (CLAUDE.md §2): on-demand, `private, no-store` (set in middleware),
// never indexable. Deliberately NOT built on BaseLayout — that one carries <SeoHead>,
// the consent banner, the RUM beacon and the public stylesheet, none of which belong on
// a page that must not be indexed, must not be measured as a public route, and has no
// visitor to ask for consent.

interface Props {
  title: string;
  // `| undefined` on both: under exactOptionalPropertyTypes a caller computing
  // `subtitle` from an optional value passes an explicit undefined, which `?:` alone
  // rejects.
  subtitle?: string | undefined;
  /** `bare` drops the sidebar — used by the login screen, which has no session yet. */
  layout?: 'app' | 'bare' | undefined;
}

const { title, subtitle, layout = 'app' } = Astro.props;
const session = Astro.locals.session;
const nav = session ? visibleNav(session.role) : [];
const current = Astro.url.pathname;
const csrfToken = Astro.locals.csrfToken;

function isCurrent(href: string): boolean {
  if (href === '/admin') return current === '/admin';
  return current === href || current.startsWith(`${href}/`);
}

// Breadcrumb: Admin / <section> / <this page>. The section is the longest nav href
// that prefixes the current path — derived from the ROLE-FILTERED nav, so a page a
// role reaches through a capability its sidebar does not show (Developer on
// /admin/pages via maintenance.manage) simply gets a shorter trail, never a link the
// sidebar would not have offered. The terminal crumb is the page's own title, which
// also means detail pages ("Edit post") need no extra wiring.
const sectionLinks = nav.flatMap((group) => group.links).filter((link) => link.href !== '/admin');
const section =
  sectionLinks
    .filter((link) => current === link.href || current.startsWith(`${link.href}/`))
    .sort((a, b) => b.href.length - a.href.length)[0] ?? null;

// Avatar initials from the email's local part. Nothing profound — "ka" for kareem@ —
// but it matches what the account menu expands to, and needs no profile fetch.
const initials = session ? session.email.slice(0, 2) : '';
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} · Braiin Station Admin</title>
    <!--
      Belt AND braces on indexability. The middleware already sends `no-store` and
      /admin is behind auth, but a crawler that reaches the login page still should not
      list it, and `noarchive` keeps it out of caches that ignore the rest.
    -->
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
    <link rel="stylesheet" href="/styles/admin.css" />
    <!--
      The CSRF token reaches the client in a meta tag rather than an inline script:
      `script-src` carries no 'unsafe-inline', so an inline bootstrap would simply be
      blocked. `adminFetch()` reads it from here.
    -->
    <meta name="csrf-token" content={csrfToken} />
  </head>
  <body class="admin-body" data-layout={layout}>
    {
      layout === 'app' && session && (
        <nav class="admin-sidebar admin-nav" aria-label="Admin sections">
          <a class="admin-brand" href="/admin">
            Braiin Station
          </a>
          {nav.map((group) => (
            <div class="admin-nav-group">
              <p class="admin-nav-title">{group.title}</p>
              {group.links.map((link) => (
                <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              ))}
            </div>
          ))}
        </nav>
      )
    }

    <main class="admin-main">
      {
        layout === 'app' && session && (
          <div class="admin-topbar">
            <nav class="crumbs" aria-label="Breadcrumb">
              <ol>
                <li>
                  <a href="/admin">Admin</a>
                </li>
                {section && current !== section.href && (
                  <li>
                    <a href={section.href}>{section.label}</a>
                  </li>
                )}
                <li aria-current="page">{title}</li>
              </ol>
            </nav>
            {/* A plain GET form, not a live combobox: Enter lands on the server-rendered
                results page, which costs zero client JS and cannot show a result the
                server did not authorize. */}
            <form class="topbar-search" role="search" action="/admin/search" method="get">
              <label class="visually-hidden" for="topbar-q">
                Search the admin
              </label>
              <input
                id="topbar-q"
                type="search"
                name="q"
                placeholder="Search…"
                minlength="2"
                maxlength="64"
              />
            </form>
            <details class="menu account-menu">
              <summary class="avatar" aria-label={`Account: ${session.email}`}>
                {initials}
              </summary>
              <div class="menu-panel">
                <p class="menu-id">
                  {session.email}
                  <br />
                  Role: <strong>{session.role.replace('_', ' ')}</strong>
                </p>
                <button type="button" data-action="logout">
                  Sign out
                </button>
              </div>
            </details>
          </div>
        )
      }
      <header class="admin-header">
        <div>
          <h1>{title}</h1>
          {subtitle && <p class="admin-sub">{subtitle}</p>}
        </div>
        <slot name="actions" />
      </header>
      <slot />
    </main>

    <!--
      The toast live region is server-rendered, not created on demand: a live region
      announces CHANGES to its contents, so one appended together with its first toast
      announces nothing. src/lib/admin/toast.ts appends into it.
    -->
    <div id="admin-toasts" class="toasts" aria-live="polite"></div>

    <script>
      // Sign-out is a POST, never a GET link: a GET logout can be fired by any <img src>
      // on any page — a nuisance CSRF that signs people out mid-edit.
      import { adminFetch } from '@/lib/admin/client';

      document.querySelector('[data-action="logout"]')?.addEventListener('click', async () => {
        await adminFetch('/api/admin/auth/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      });

      // <details class="menu"> gives the dropdown for free, but native details only
      // closes on its own summary. Light-dismiss (outside click) and Escape are the two
      // behaviours users expect of a menu and the element does not supply.
      document.addEventListener('click', (event) => {
        const target = event.target as Node;
        for (const menu of document.querySelectorAll('details.menu[open]')) {
          if (!menu.contains(target)) menu.removeAttribute('open');
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        for (const menu of document.querySelectorAll('details.menu[open]')) {
          menu.removeAttribute('open');
          // Focus back on the trigger, else focus falls to <body> and a keyboard user
          // is teleported to the top of the page.
          menu.querySelector<HTMLElement>('summary')?.focus();
        }
      });
    </script>
  </body>
</html>
