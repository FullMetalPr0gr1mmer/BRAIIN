---
import { env } from 'cloudflare:workers';
import { can } from '@/lib/authz/matrix';
import { currentLink, currentTab, visibleNav } from '@/lib/admin/nav';
import { initialsOf, loadShellState, type ShellState } from '@/lib/admin/shell';
import { getIdentity } from '@/lib/identity';
import Sidebar from '@/components/admin/ui/Sidebar.astro';
import Topbar from '@/components/admin/ui/Topbar.astro';
import PageHead from '@/components/admin/ui/PageHead.astro';
import AdminChrome from '@/components/admin/islands/AdminChrome';
import { paletteGroupsFor } from '@/lib/admin/paletteSources';

// Tier C shell (CLAUDE.md §2): on-demand, `private, no-store` (set in middleware),
// never indexable. Deliberately NOT built on BaseLayout — that one carries <SeoHead>,
// the consent banner, the RUM beacon and the public stylesheet, none of which belong on
// a page that must not be indexed, must not be measured as a public route, and has no
// visitor to ask for consent.
//
// Admin v2 (F2): the prototype's shell — a midnight sidebar (a popover below 900px), a
// white topbar, and a page head with the area's tabs (docs/admin-v2/ui.md §2.2, §3).

interface Props {
  title: string;
  // `| undefined` on both: under exactOptionalPropertyTypes a caller computing
  // `subtitle` from an optional value passes an explicit undefined, which `?:` alone
  // rejects.
  subtitle?: string | undefined;
  /** `bare` drops the shell — used by the login screen, which has no session yet. */
  layout?: 'app' | 'bare' | undefined;
}

const { title, subtitle, layout = 'app' } = Astro.props;
const session = Astro.locals.session;
const supabase = Astro.locals.supabase;
const nav = session ? visibleNav(session.role) : [];
const path = Astro.url.pathname;
const csrfToken = Astro.locals.csrfToken;
// The CMS names the studio it edits from the same identity row the public site renders.
const brand = (await getIdentity(Astro.locals)).brandName.en;

const app = layout === 'app' && session !== null;
const section = currentLink(nav, path);
const tab = section ? currentTab(section, path) : null;

const shell: ShellState =
  app && session && supabase
    ? await loadShellState(supabase, session, nav, env)
    : { displayName: null, maintenance: false, counts: {} };
const initials = session ? initialsOf(shell.displayName, session.email) : '';
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{`${title} · ${brand} Admin`}</title>
    <!--
      Belt AND braces on indexability. The middleware already sends `no-store` and
      /admin is behind auth, but a crawler that reaches the login page still should not
      list it, and `noarchive` keeps it out of caches that ignore the rest.
    -->
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
    <link rel="stylesheet" href="/styles/admin.css" />
    <!--
      The CSRF token reaches the client in a meta tag rather than an inline script:
      `script-src` carries no 'unsafe-inline', so an inline bootstrap would simply be
      blocked. `adminFetch()` reads it from here.
    -->
    <meta name="csrf-token" content={csrfToken} />
  </head>
  <body class="admin-body" data-layout={app ? 'app' : 'bare'}>
    {
      app && (
        <a class="skip-link" href="#content">
          Skip to content
        </a>
      )
    }
    {
      app && session && (
        <Sidebar
          nav={nav}
          current={section}
          brand={brand}
          shell={shell}
          email={session.email}
          role={session.role}
          initials={initials}
        />
      )
    }

    <main class="admin-main" id="content" tabindex="-1">
      {
        app && session && (
          <Topbar
            section={section}
            title={title}
            current={path}
            maintenance={shell.maintenance}
            canManageMaintenance={can(session.role, 'maintenance.manage') === 'full'}
          />
        )
      }
      {
        app ? (
          <PageHead
            title={title}
            subtitle={subtitle}
            tabs={section?.tabs}
            currentTab={tab}
            area={section?.label}
          >
            <slot name="actions" slot="actions" />
          </PageHead>
        ) : null
      }
      <slot />
    </main>

    <!--
      The toast live region is server-rendered, not created on demand: a live region
      announces CHANGES to its contents, so one appended together with its first toast
      announces nothing. src/lib/admin/toast.ts appends into it.
    -->
    <div id="admin-toasts" class="toasts" aria-live="polite"></div>

    {
      /* The shell's one island: the command palette (F3). `client:load`, because ⌘K must
         work the moment the page is usable. Its sources are built here, on the server. */
      app && session && <AdminChrome client:load palette={paletteGroupsFor(session.role)} />
    }

    <script>
      // Sign-out is a POST, never a GET link: a GET logout can be fired by any <img src>
      // on any page — a nuisance CSRF that signs people out mid-edit.
      import { adminFetch } from '@/lib/admin/client';

      document.querySelector('[data-action="logout"]')?.addEventListener('click', async () => {
        await adminFetch('/api/admin/auth/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      });

      // <details class="menu"> gives the dropdown for free, but native details only
      // closes on its own summary. Light-dismiss (outside click) and Escape are the two
      // behaviours users expect of a menu and the element does not supply.
      document.addEventListener('click', (event) => {
        const target = event.target as Node;
        for (const menu of document.querySelectorAll('details.menu[open]')) {
          if (!menu.contains(target)) menu.removeAttribute('open');
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        for (const menu of document.querySelectorAll('details.menu[open]')) {
          menu.removeAttribute('open');
          // Focus back on the trigger, else focus falls to <body> and a keyboard user
          // is teleported to the top of the page.
          menu.querySelector<HTMLElement>('summary')?.focus();
        }
      });

      // The sidebar is a popover only below 900px. A window widened while it is open would
      // leave it in the top layer over the page, so it is closed at the breakpoint.
      const side = document.getElementById('admin-side');
      const wide = window.matchMedia('(min-width: 900px)');
      wide.addEventListener('change', (event) => {
        if (event.matches && side?.matches(':popover-open')) side.hidePopover();
      });
    </script>
  </body>
</html>
