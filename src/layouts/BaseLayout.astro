---
import type { Locale } from '@schemas/primitives';
import type { JsonLdNode } from '@/lib/seo/jsonld';
import SeoHead from '@/components/SeoHead.astro';
import type { HeroFace } from '@/lib/seo/fonts';
import SiteHeader, { type HeaderVariant } from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';
import WebVitals from '@/components/WebVitals.astro';
import PageView from '@/components/PageView.astro';
import ErrorReporter from '@/components/ErrorReporter.astro';
import { dir } from '@/lib/i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  logicalPath: string;
  jsonLd?: JsonLdNode[];
  robots?: string;
  ogImage?: string;
  /** CMS-authored canonical override (`entity_seo.canonical_override`). */
  canonicalOverride?: string;
  /** Set on routes that render their own chrome (none today) or a bare error page. */
  chrome?: boolean;
  /** `overlay`: the UI v2 header, transparent over the page's hero (home, contact).
      `solid` (default): the sticky bar for pages with no hero. See SiteHeader. */
  header?: HeaderVariant;
  /** The header's language switch target, when it is NOT this page in the other locale —
      a 404 has no twin, so its switch goes to the other locale's home. */
  langHref?: string;
  /** Route stylesheets under /styles/, linked after global.css (UI v2: `work.css` on Our
      Work + All projects; `banner.css` — MediaBanner + its caption — there and on the case
      study, with `case-study.css`; Round 2: `services.css` — the "Say hello" block and the
      services hero links — on /services and the service pages; `join.css` — the Join bands
      and the application form — on /join). A known name, never a URL —
      the sheet is same-origin, so the CSP's `style-src 'self'` covers it with no nonce. */
  styles?: readonly RouteStylesheet[];
  /** The Arabic hero face SeoHead preloads — the weight the route's above-the-fold heading
      renders in (default `almarai-800`, Home's hero). EN always preloads Archivo. */
  heroFace?: HeroFace;
}

/** Every route stylesheet in public/styles/ (a closed list: a typo fails `astro check`). */
type RouteStylesheet =
  'about.css' | 'work.css' | 'banner.css' | 'case-study.css' | 'services.css' | 'join.css';

const {
  title,
  description,
  locale,
  logicalPath,
  jsonLd = [],
  robots = 'index,follow',
  ogImage,
  canonicalOverride,
  chrome = true,
  header = 'solid',
  langHref,
  styles = [],
  heroFace,
} = Astro.props;
const direction = dir(locale);
---

<!doctype html>
<html lang={locale} dir={direction}>
  <head>
    <SeoHead
      title={title}
      description={description}
      locale={locale}
      logicalPath={logicalPath}
      jsonLd={jsonLd}
      robots={robots}
      {...ogImage ? { ogImage } : {}}
      {...canonicalOverride ? { canonicalOverride } : {}}
      {...heroFace ? { heroFace } : {}}
    />
    <link rel="stylesheet" href="/styles/global.css" />
    {styles.map((sheet) => <link rel="stylesheet" href={`/styles/${sheet}`} />)}
  </head>
  <body>
    {chrome && <SiteHeader locale={locale} variant={header} {...(langHref ? { langHref } : {})} />}
    {
      /*
      The skip link's target. It lives here rather than on each page's own <main>
      because the pages render that element themselves — a skip link pointing at an id
      no page defines is worse than no skip link: it passes a visual review, focuses
      nothing, and leaves a keyboard user tabbing through the whole nav on every page.
      `tabindex="-1"` is what makes a non-interactive element actually take focus when
      jumped to (Safari and older Chrome ignore the jump without it).
    */
    }
    <div id="main" tabindex="-1">
      <slot />
    </div>
    {chrome && <SiteFooter locale={locale} />}
    <ConsentBanner locale={locale} />
    <WebVitals />
    <PageView />
    <ErrorReporter />
    <script>
      // Reveal-on-scroll enhancement. Elements opt in with class="rv" and are FULLY
      // visible without JS (crawlers and no-JS visitors always get the content —
      // Pillar 3); arming happens here (.rv-init) so only script-running browsers ever
      // hide anything. Stagger is set through the CSSOM (el.style), which the CSP
      // permits — inline style ATTRIBUTES would be blocked.
      const els = [...document.querySelectorAll<HTMLElement>('.rv')];
      if (els.length > 0 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('on');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );
        for (const [i, el] of els.entries()) {
          el.style.setProperty('--rv-delay', `${Math.min(i % 8, 6) * 55}ms`);
          el.classList.add('rv-init');
          io.observe(el);
        }
        // Keyboard focus must never land on a still-hidden element: the IO's bottom
        // rootMargin means a link focus-scrolled to the viewport's bottom edge may not
        // intersect yet, leaving the focused link invisible (WCAG 2.4.7).
        document.addEventListener('focusin', (e) => {
          const el = e.target instanceof Element ? e.target.closest('.rv-init:not(.on)') : null;
          if (el) {
            el.classList.add('on');
            io.unobserve(el);
          }
        });
      }
    </script>
  </body>
</html>
