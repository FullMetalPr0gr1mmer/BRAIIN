---
export const prerender = false;

// The disciplines are the Services overview now (Admin v2 U5, AV-14): /admin/services lists
// them in the site's order, with their drawer and their services. This address answers there,
// inside the admin, so a bookmark or an old link still works. A 302, not a 301: an admin
// route is never cached, and a later screen may take the address back. A discipline's own
// page stays at /admin/disciplines/<id>, and the no-JS form at /admin/disciplines/new.
return Astro.redirect('/admin/services', 302);
---
