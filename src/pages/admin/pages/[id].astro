---
import AdminLayout from '@/layouts/AdminLayout.astro';
import ResourceForm from '@/components/admin/ResourceForm';
import { uiFor } from '@/lib/admin/uiSchema';

export const prerender = false;

// Astro resolves the static `new.astro` before this dynamic route, so /admin/pages/new
// reaches the create form rather than being read as an id.
const ui = uiFor('pages');
const id = Astro.params.id ?? null;
---

<AdminLayout title={`Edit ${ui.singular.toLowerCase()}`} subtitle={ui.title}>
  <ResourceForm client:load resource="pages" id={id} />
</AdminLayout>
