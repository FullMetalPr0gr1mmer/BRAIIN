---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminUsers from '@/components/admin/islands/AdminUsers';

export const prerender = false;

const selfId = Astro.locals.session?.userId ?? '';
---

<AdminLayout
  title="Users & roles"
  subtitle="Admin only. Role changes end the affected session immediately."
>
  <AdminUsers client:load selfId={selfId} />
</AdminLayout>
