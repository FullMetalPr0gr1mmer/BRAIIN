---
import AuthLayout from '@/layouts/AuthLayout.astro';
import { CSRF_FIELD_NAME } from '@/lib/http/csrf';
import { safeNext } from '@/lib/auth/next';
import { INVITE_READY, LOGIN_MESSAGES, RESET_DONE, messageFor } from '@/lib/auth/messages';

export const prerender = false;

// Sign in (Admin v2 F7). A plain form, no script: it posts to /api/admin/auth/login,
// which answers a form post with a 303 (to `next`, or back here with an `error` code this
// page turns into fixed copy). The middleware lets it through without a session and puts
// the CSRF token in `Astro.locals`, which the hidden field carries.

// Already signed in? Skip the form. `next` is validated before it is used as a redirect
// target (src/lib/auth/next.ts: an open redirect otherwise).
const next = safeNext(Astro.url.searchParams.get('next') ?? '/admin');
if (Astro.locals.session) return Astro.redirect(next, 302);

const error = messageFor(LOGIN_MESSAGES, Astro.url.searchParams.get('error'));
// A finished reset (F7) or an accepted invite (U12b) says so; neither ever names the account.
const notice = error
  ? null
  : Astro.url.searchParams.get('reset') === 'done'
    ? RESET_DONE
    : Astro.url.searchParams.get('invite') === 'ready'
      ? INVITE_READY
      : null;
const csrfToken = Astro.locals.csrfToken;
---

<AuthLayout title="Sign in" styles={['login.css']}>
  <h1>Welcome back</h1>
  <p class="login__lead">Sign in to your admin.</p>

  {
    error && (
      <p class="msg" data-kind="error" role="alert">
        {error.text}
      </p>
    )
  }
  {
    notice && (
      <p class="msg" data-kind="ok" role="status">
        {notice.text}
      </p>
    )
  }

  <form class="login__form" method="post" action="/api/admin/auth/login">
    <input type="hidden" name={CSRF_FIELD_NAME} value={csrfToken} />
    <input type="hidden" name="next" value={next} />

    <label class="field">
      <span>Email</span>
      <input type="email" name="email" autocomplete="username" required maxlength="254" />
    </label>

    <label class="field">
      <span>Password</span>
      <input
        type="password"
        name="password"
        autocomplete="current-password"
        required
        minlength="8"
        maxlength="256"
      />
    </label>

    <div class="login__row">
      {/* On by default (owner item O-14): a 7-day session; unticked, until the browser closes. */}
      <label class="field-inline">
        <input type="checkbox" name="remember" value="1" checked />
        <span>Keep me signed in</span>
      </label>
      <a class="login__link" href="/admin/forgot">Forgot password?</a>
    </div>

    <button type="submit" data-variant="primary">Sign in</button>
  </form>
</AuthLayout>
