---
export const prerender = false;

// The redirects list lives on the SEO screen's Redirects tab now (Admin v2 U10, AV-19 D10),
// with its drawer; this address answers there, inside the admin, so a bookmark or an old
// link still works. A 302, not a 301: an admin route is never cached, and a later screen may
// take the address back. /admin/redirects/new and /admin/redirects/<id> stay as the no-JS
// pages. The SEO page decides who may open the tab.
return Astro.redirect('/admin/seo?tab=redirects', 302);
---
