---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminTheme from '@/components/admin/islands/AdminTheme';
import Refused from '@/components/admin/ui/Refused.astro';
import { can } from '@/lib/authz/matrix';
import { createReleaseMode } from '@/lib/admin/releasesFlag';
import { findThemeId } from '@/lib/admin/theme';

export const prerender = false;

// The theme editor (Admin v2 E4, docs/admin-v2/ui.md "Theme (/admin/appearance/theme; AV-27;
// theme.edit)"). theme.edit (Admin, Developer): any other role gets the layout with the
// refusal and a 403, and nothing is read. The island edits the tenant's one v1 theme (its id
// found here under the person's own RLS, a pending create included), or creates it on the
// first save.

const session = Astro.locals.session;
const supabase = Astro.locals.supabase;
const allowed = Boolean(session && can(session.role, 'theme.edit') === 'full');
if (!allowed) Astro.response.status = 403;

const releaseMode = allowed ? await createReleaseMode(Astro.locals, 'themes') : false;
const id = allowed && supabase ? await findThemeId(supabase, releaseMode) : null;
---

<AdminLayout
  title="Theme"
  subtitle="Colours and motion for the whole site. This admin follows the same colours."
  styles={['theme.css']}
>
  {!allowed ? <Refused /> : <AdminTheme client:load id={id} releaseMode={releaseMode} />}
</AdminLayout>
