---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminLeadsBoard from '@/components/admin/islands/AdminLeadsBoard';
import Icon from '@/components/admin/ui/Icon.astro';
import Refused from '@/components/admin/ui/Refused.astro';
import { can } from '@/lib/authz/matrix';
import { readBoardInitial, readLeadsFrame } from '@/lib/crm/leadPage';
import { boardFilters, parseLeadFilters } from '@/lib/crm/leadUrl';

export const prerender = false;

// The pipeline board (Admin v2 C4b, crm.md §11 screen 2; the Leads area's Pipeline tab,
// decision D2): a column per stage with its non-spam leads, "Move to…" on every card. The
// first view is rendered here for the filters the address carries (whose, where from, which
// discipline, since when; never a search), so the page is complete without JavaScript.
// `leads.manage` (Admin + Developer): any other role is refused with a 403 and reads nothing.
// The flags handed to the island are UX hints; every route re-checks its capability.

const session = Astro.locals.session;
const sb = Astro.locals.supabase;
const allowed = session !== null && can(session.role, 'leads.manage') === 'full';
if (!allowed) Astro.response.status = 403;

// Only what the board's toolbar shows (no chip, sort or page): see boardFilters.
const filters = boardFilters(parseLeadFilters(Astro.url.searchParams));
const now = new Date();
const permissions = {
  canSeePii: allowed && can(session.role, 'leads.pii') === 'full',
  canExport: allowed && can(session.role, 'export.csv') === 'full',
  canErase: allowed && can(session.role, 'crm.erase') === 'full',
  canEditServices: allowed && can(session.role, 'services.write') === 'full',
};

const [frame, initial] =
  allowed && session && sb
    ? await Promise.all([
        readLeadsFrame(sb, session).catch(() => null),
        readBoardInitial(sb, session, filters, now),
      ])
    : [null, null];
---

<AdminLayout
  title="Pipeline"
  subtitle="Use Move to… on a card to change its stage. Won cards add up at the top of their column."
  styles={['leads.css']}
>
  {
    allowed && permissions.canSeePii && (
      <button slot="actions" type="button" data-variant="primary" data-lead-add hidden>
        <Icon name="plus" size={16} />
        Add lead manually
      </button>
    )
  }
  {
    !allowed ? (
      <Refused />
    ) : frame === null ? (
      <p class="msg" data-kind="error" role="alert">
        The pipeline could not be loaded just now. Try again in a moment.
      </p>
    ) : (
      <AdminLeadsBoard
        client:load
        frame={frame}
        initial={initial}
        filters={filters}
        permissions={permissions}
        now={now.toISOString()}
      />
    )
  }
</AdminLayout>
