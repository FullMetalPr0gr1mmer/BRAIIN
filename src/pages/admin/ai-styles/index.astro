---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminResourceTable from '@/components/admin/islands/AdminResourceTable';
import { uiFor } from '@/lib/admin/uiSchema';
import { can } from '@/lib/authz/matrix';

export const prerender = false;

// Move up and Move down write an archived row only for a role that may archive (hotfix H12):
// the UX half of `content.archiveDelete`, as `canAdvanced` is on the section form. The
// reorder route refuses such a move whatever this says.
const role = Astro.locals.session?.role;
const canArchive = role !== undefined && can(role, 'content.archiveDelete') === 'full';

const ui = uiFor('ai-styles');
---

<AdminLayout title={ui.title}>
  <!--
  `client:load` rather than `client:visible`: this island IS the page, so deferring it
  to intersection just adds a blank frame. Public routes use visible/idle — /admin is
  exempt from the CWV budgets (CLAUDE.md §6) and is gated on bundle size instead.
-->
  <AdminResourceTable client:load resource="ai-styles" canArchive={canArchive} />
</AdminLayout>
