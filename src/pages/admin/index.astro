---
import { env } from 'cloudflare:workers';
import { PUBLIC_SITE_URL } from 'astro:env/client';
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminDashboard from '@/components/admin/islands/AdminDashboard';
import Icon from '@/components/admin/ui/Icon.astro';
import Banners from '@/components/admin/ui/dashboard/Banners.astro';
import Board from '@/components/admin/ui/dashboard/Board.astro';
import { ROLES } from '@/lib/auth/types';
import { can } from '@/lib/authz/matrix';
import { ROLE_LABELS } from '@/lib/authz/capLabels';
import { greeting, subLine } from '@/lib/admin/dashboard/greeting';
import { shownWidgets } from '@/lib/admin/dashboard/layout';
import { loadDashboard, type Dashboard } from '@/lib/admin/dashboard/loaders';
import { WIDGETS, widgetsFor } from '@/lib/admin/dashboard/widgets';
import { libraryFor, QUICK_DEFAULTS } from '@/lib/admin/quickActions';
import type { ShellPreload } from '@/lib/admin/shell';
import { getMaintenanceState, type MaintenanceState } from '@/lib/http/maintenance';
import type { DashboardIslandProps } from '@/components/admin/screens/dashboard/types';

export const prerender = false;

// The dashboard (Admin v2 U1, docs/admin-v2/ui.md §4 "Dashboard", AV-09): server-rendered and
// complete without JS. The greeting in the studio's time zone, the banners, then the board
// from the widget registry (src/lib/admin/dashboard): the person's layout, else their role's
// preset, else the code's default, and only the widgets it shows are read. One island
// (AdminDashboard) adds Customize, the quick-actions editor, the notes editor and, for Admin,
// the role presets; it never fetches widget data. The maintenance snapshot and the person's
// name the page reads anyway are handed to the shell (`preload`), which would read them again.

const session = Astro.locals.session;
const sb = Astro.locals.supabase;
const now = new Date();

let dashboard: Dashboard | null = null;
let maintenance: MaintenanceState | null = null;
let displayName: string | null = null;
if (session && sb) {
  const [loaded, state, profile] = await Promise.all([
    loadDashboard({ sb, auth: session, now, siteUrl: PUBLIC_SITE_URL }),
    getMaintenanceState(env).catch(() => null),
    Promise.resolve(
      sb.from('profiles').select('display_name').eq('id', session.userId).maybeSingle(),
    ).catch(() => null),
  ]);
  dashboard = loaded;
  maintenance = state;
  const name = (profile?.data as { display_name?: unknown } | null)?.display_name;
  displayName = typeof name === 'string' ? name.trim() || null : null;
}
const preload: ShellPreload = { maintenance, displayName };

const title = session ? greeting(now, displayName, session.email) : 'Dashboard';
const shown = dashboard ? shownWidgets(dashboard.layout) : [];

const island: DashboardIslandProps | null =
  session && dashboard
    ? {
        editable: dashboard.prefs !== null,
        version: dashboard.prefs?.version ?? 0,
        layout: dashboard.layout,
        source: dashboard.source,
        storedQuickSet:
          typeof dashboard.prefs?.dashboard === 'object' &&
          dashboard.prefs?.dashboard !== null &&
          (dashboard.prefs.dashboard as { quickSet?: unknown }).quickSet === true,
        catalog: widgetsFor(session.role).map((id) => ({
          id,
          label: WIDGETS[id].label,
          description: WIDGETS[id].description,
        })),
        quick: {
          items: dashboard.quick,
          library: libraryFor(session.role).map((a) => ({ id: a.id, label: a.label, icon: a.icon })),
          defaults: [...QUICK_DEFAULTS[session.role]],
        },
        notesShown: shown.includes('notes'),
        quickShown: shown.includes('quick'),
        presets:
          can(session.role, 'users.manage') === 'full'
            ? ROLES.map((role) => ({
                role,
                label: ROLE_LABELS[role],
                widgets: widgetsFor(role),
                library: libraryFor(role).map((a) => a.id),
              }))
            : null,
      }
    : null;
---

<AdminLayout
  title={title}
  subtitle={subLine(PUBLIC_SITE_URL)}
  styles={['dashboard.css', 'health.css']}
  preload={preload}
>
  <Fragment slot="actions">
    {island && <AdminDashboard client:load {...island} />}
    <a class="btn" href="/" target="_blank" rel="noopener noreferrer">
      <Icon name="ext" size={14} />
      View site<span class="visually-hidden"> (opens in a new tab)</span>
    </a>
    {
      dashboard?.homeHref && (
        <a class="btn" data-variant="primary" href={dashboard.homeHref}>
          <Icon name="edit" size={14} />
          Edit homepage
        </a>
      )
    }
  </Fragment>

  {
    session && dashboard && (
      <>
        <Banners
          maintenance={maintenance?.active === true}
          canManageMaintenance={can(session.role, 'maintenance.manage') === 'full'}
          placeholdersLive={dashboard.banners.placeholdersLive}
          attentionShown={shown.includes('attention')}
        />
        <Board layout={dashboard.layout} results={dashboard.widgets} now={now.getTime()} />
      </>
    )
  }
</AdminLayout>
