---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminProjects from '@/components/admin/islands/AdminProjects';
import Icon from '@/components/admin/ui/Icon.astro';
import { servicesAreaAccess } from '@/lib/admin/servicesArea';

export const prerender = false;

// The Projects list (Admin v2 U6, AV-15): every project with its poster, services, sector and
// client, a search over the name and the type, the chips (All, Featured, the sectors, Hidden),
// the order, Manage tags and Add project. What the role may do is decided here from ROLE_CAPS
// (the buttons only: every route checks again): portfolio.write adds, edits and orders, and
// opens the clients; categories.manage edits the sectors; content.archiveDelete moves an
// archived row. SEO reaches this screen through seo.entityMeta and reads it, to open a project
// for its SEO.
const access = servicesAreaAccess(Astro.locals.session?.role);
const tags = access.portfolio || access.sectors;
---

<AdminLayout
  title="Projects"
  subtitle="The case studies in the catalogue. Featured ones lead Our Work and can be picked for the home page."
  styles={['projects.css']}
>
  <a slot="actions" class="btn" href="/portfolio" target="_blank" rel="noopener">
    <Icon name="ext" size={16} />
    Open Our Work
  </a>
  {
    tags && (
      <a slot="actions" class="btn" href="/admin/sectors" data-projects-tags>
        <Icon name="tag" size={16} />
        Manage tags
      </a>
    )
  }
  {
    access.portfolio && (
      <a
        slot="actions"
        class="btn"
        data-variant="primary"
        href="/admin/portfolio/new"
        data-project-add
      >
        <Icon name="plus" size={16} />
        Add project
      </a>
    )
  }
  <!--
  `client:load`: this island IS the page. /admin is exempt from the CWV budgets (CLAUDE.md
  §6) and is gated on bundle size instead.
-->
  <AdminProjects
    client:load
    write={access.portfolio}
    archive={access.archive}
    sectors={access.sectors}
  />
</AdminLayout>
