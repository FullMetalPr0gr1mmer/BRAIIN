---
export const prerender = false;

// The theme editor lives at /admin/appearance/theme now (Admin v2 E4, ui.md §3.1: the retired
// /admin/themes/** routes answer there, inside the admin). A 302, not a 301: an admin route is
// never cached, and the address may be taken back. The editor's page decides who may open it.
return Astro.redirect('/admin/appearance/theme', 302);
---
