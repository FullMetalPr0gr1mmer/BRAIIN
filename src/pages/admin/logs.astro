---
export const prerender = false;

// The system log moved into site health (Admin v2 U2): its Errors tab lists the same rows,
// and Clear logs is there for Admin. An old link or bookmark lands on that tab. A 302, not a
// 301: an admin route is never cached, and a later screen may take the address back. The
// tab itself decides who may read it (logs.view).
return Astro.redirect('/admin/site-health?tab=errors', 302);
---
