---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { DEFAULT_ABOUT_SECTIONS } from '@/lib/sections/types';
import { leadershipJsonLd, showsSection, withLeaders } from '@/lib/sections/about';
import { getPageComposition } from '@/lib/data/pageSections';
import { getLeadership, getPublishedTeam } from '@/lib/data/team';
import { loadHead } from '@/lib/seo/head';
import { PAGE_META } from '@/lib/seo/pageMeta';
import { buildPersonSchema, buildBreadcrumbSchema, orgRef } from '@/lib/seo/jsonld';
import { setTierA } from '@/lib/http/cacheTags';
import { localizedPath, pickLocale } from '@/lib/i18n';
import { PUBLIC_SITE_URL } from 'astro:env/client';

// Tier A (indexable, edge-cached SSR). Composed from CMS sections (`pages` slug 'about'
// + `page_sections`; the UI v2 default composition until authored — who we are →
// leadership → our reach → follow). Purges on `route:about`, and on the tables its
// sections read: team (leadership), statistics (our reach).
const locale = 'en' as const;
const base = PUBLIC_SITE_URL.replace(/\/$/, '');
const HOME = { en: 'Home', ar: 'الرئيسية' }[locale];
const meta = PAGE_META.about[locale];

// Leadership, composition and head in one concurrent round (the page's SEO override needs
// the page id, so the head loader is handed the composition query). The leaders drive both
// the visible slider (injected as route data, no second read) and their Person JSON-LD.
const compositionQuery = getPageComposition('about');
const [leaders, composition, { seo, identity }] = await Promise.all([
  getLeadership(),
  compositionQuery,
  loadHead(Astro.locals, {
    locale,
    fallbackTitle: meta.title,
    fallbackDescription: meta.description,
    entity: compositionQuery.then((c) => (c ? { type: 'page' as const, id: c.page.id } : null)),
  }),
]);
// A published page with no sections yet renders the default composition (its SEO override,
// keyed by the page id above, still applies).
const authored = composition?.sections.length ? composition.sections : DEFAULT_ABOUT_SECTIONS;
// The pre-UI-v2 team grid (named authors) is still a section type an editor may compose.
const team = showsSection(authored, 'team') ? await getPublishedTeam() : [];
const sections = withLeaders(authored, leaders).map((s) =>
  s.type === 'team' ? { ...s, props: { ...(s.props ?? {}), members: team } } : s,
);

const org = orgRef(identity, locale);
const jsonLd = [
  buildBreadcrumbSchema([
    { name: HOME, url: base + localizedPath('/', locale) },
    { name: meta.title, url: base + localizedPath('/about', locale) },
  ]),
  // Only the people the page shows (no anonymous authorship — Pillar 3 — and no one a
  // visitor cannot see).
  ...leadershipJsonLd(authored, leaders, { locale, org, siteBase: base }),
  ...team.map((m) => {
    // `exactOptionalPropertyTypes` — omit the key entirely rather than pass undefined.
    const bio = pickLocale(m.bio, locale);
    return buildPersonSchema({
      name: pickLocale(m.name, locale, m.slug),
      org,
      ...(bio ? { description: bio } : {}),
      ...(m.avatar_url ? { image: m.avatar_url } : {}),
    });
  }),
];

setTierA(Astro.response, {
  route: 'about',
  locale,
  entities: ['page:about', 'team:all', 'statistics:all'],
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  logicalPath="/about"
  jsonLd={jsonLd}
  robots={seo.robots}
  styles={['about.css']}
  {...seo.ogImage ? { ogImage: seo.ogImage } : {}}
  {...seo.canonicalOverride ? { canonicalOverride: seo.canonicalOverride } : {}}
>
  <main>
    <SectionRenderer locale={locale} sections={sections} />
  </main>
</BaseLayout>
