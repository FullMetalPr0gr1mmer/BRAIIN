---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import {
  DEFAULT_HOME_SECTIONS,
  homeHeroCtaHref,
  withHomeData,
  withHomeIntro,
} from '@/lib/sections/types';
import { getPageComposition } from '@/lib/data/pageSections';
import { getPortfolioCards } from '@/lib/data/portfolio';
import { getPublishedDisciplines } from '@/lib/data/disciplines';
import { loadHead } from '@/lib/seo/head';
import { ogImageCandidates } from '@/lib/seo/ogImage';
import { PAGE_META } from '@/lib/seo/pageMeta';
import { buildOrganizationSchema, buildWebSiteSchema, orgRef } from '@/lib/seo/jsonld';
import { setTierA } from '@/lib/http/cacheTags';
import { HOME_CACHE_ENTITIES } from '@/lib/sections/home';
import { PUBLIC_SITE_URL } from 'astro:env/client';

// Tier A. Home is composed from CMS sections (`pages` slug 'home' + `page_sections`,
// authored under /admin/pages + /admin/sections); the default composition renders until
// that page is authored. Publish purges the `route:home` cache tag.
const locale = 'en' as const;
const meta = PAGE_META.home[locale];

// The composition and the head load together; the page's SEO override needs the page id,
// so the head loader is handed the composition query rather than its result.
// The featured projects load alongside: the Selected work band shows them, and whether
// there are any decides where the hero's "See our work" points. The disciplines load once
// for the discipline cards and the lead form's grouped select (Round 2).
const compositionQuery = getPageComposition('home');
const [composition, { seo, identity }, featured, disciplines] = await Promise.all([
  compositionQuery,
  loadHead(Astro.locals, {
    locale,
    fallbackTitle: meta.title,
    fallbackDescription: meta.description,
    entity: compositionQuery.then((c) => (c ? { type: 'page' as const, id: c.page.id } : null)),
  }),
  getPortfolioCards({ featuredOnly: true }),
  getPublishedDisciplines(),
]);
// A published page with no sections yet renders the default composition (its SEO override,
// keyed by the page id above, still applies).
const composed = composition?.sections.length ? composition.sections : DEFAULT_HOME_SECTIONS;
const sections = withHomeData(withHomeIntro(composed), {
  featured,
  ctaHref: homeHeroCtaHref(composed, featured.length),
  disciplines,
});

const jsonLd = [
  buildOrganizationSchema(PUBLIC_SITE_URL, identity, locale),
  buildWebSiteSchema(PUBLIC_SITE_URL, orgRef(identity, locale)),
];
setTierA(Astro.response, { route: 'home', locale, entities: HOME_CACHE_ENTITIES });
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  logicalPath="/"
  jsonLd={jsonLd}
  robots={seo.robots}
  ogImages={ogImageCandidates(seo)}
  {...seo.canonicalOverride ? { canonicalOverride: seo.canonicalOverride } : {}}
  header="overlay"
>
  <main>
    <SectionRenderer locale={locale} sections={sections} />
  </main>
</BaseLayout>
