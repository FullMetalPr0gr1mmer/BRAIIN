---
import CaseStudyPage from '@/components/case-study/CaseStudyPage.astro';
import { loadCaseStudyPage } from '@/lib/portfolio/casePage';
import { setTierA } from '@/lib/http/cacheTags';

// A case study, Arabic twin (UI v2 PR11) — see src/pages/portfolio/[slug].astro. An
// unknown or unpublished slug is a REAL 404 (status 404) on the ARABIC 404 page.
const locale = 'ar' as const;
const { slug } = Astro.params;
const page = slug ? await loadCaseStudyPage(slug, Astro.locals, locale) : null;
if (!page) return Astro.rewrite('/ar/404');

setTierA(Astro.response, {
  route: 'portfolio-item',
  locale,
  entities: [
    `portfolio:${page.study.slug}`,
    'portfolio:all',
    'sectors:all',
    'clients:all',
    'services:all',
    'testimonials:all',
  ],
});
---

<CaseStudyPage locale={locale} page={page} />
