---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getIdentity, brandName } from '@/lib/identity';
import { siteTitle } from '@/lib/seo/title';
import { PAGE_META } from '@/lib/seo/pageMeta';
import { noEdgeCache } from '@/lib/http/cacheTags';

// AR twin of the 404 so /ar/* misses render in Arabic/RTL: the AR detail routes rewrite
// here on an unknown slug, and src/pages/ar/[...path].astro (the lowest-priority /ar/
// route) rewrites every other unmatched /ar/* path here — Astro itself serves only the
// root (English) 404. noindex; the language switch goes to the English home.
Astro.response.status = 404;
// Never edge-cached (Round 3, design-port R3-1): the middleware consults the authored
// redirects only when the render answered 404, so a 404 that stuck in the edge cache
// would shadow a rule authored afterwards for that URL. It had no Cache-Control at all.
noEdgeCache(Astro.response);

// siteTitle, not loadHead: a 404 is noindex and answers every mistyped or probing URL,
// so it skips the seo_defaults read. The identity is shared with the header and footer.
const brand = brandName(await getIdentity(Astro.locals), 'ar');
const title = siteTitle(PAGE_META.notFound.ar.title, brand);
---

<BaseLayout
  title={title}
  description="الصفحة التي تبحث عنها غير موجودة."
  locale="ar"
  logicalPath="/404"
  robots="noindex,follow"
  langHref="/"
>
  <main class="container">
    <h1>404</h1>
    <p>هذه الصفحة غير موجودة. <a href="/ar">العودة إلى الرئيسية</a>.</p>
  </main>
</BaseLayout>
