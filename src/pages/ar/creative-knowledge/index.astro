---
import BlogIndex from '@/components/BlogIndex.astro';
import { getPublishedPosts } from '@/lib/data/blog';
import { setTierA } from '@/lib/http/cacheTags';

const posts = await getPublishedPosts();
setTierA(Astro.response, { route: 'blog', locale: 'ar', entities: ['blog:all'] });
---

<BlogIndex locale="ar" posts={posts} />
