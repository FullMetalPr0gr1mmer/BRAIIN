---
import BlogIndex from '@/components/BlogIndex.astro';
import { getPublishedPosts } from '@/lib/data/blog';
import { setTierA } from '@/lib/http/cacheTags';
import { BLOG_CACHE_ENTITIES } from '@/lib/http/routeTags';

// Tier A (indexable, edge-cached SSR). Publish purges the `blog:all` cache tag.
const posts = await getPublishedPosts();
setTierA(Astro.response, { route: 'blog', locale: 'en', entities: BLOG_CACHE_ENTITIES });
---

<BlogIndex locale="en" posts={posts} />
