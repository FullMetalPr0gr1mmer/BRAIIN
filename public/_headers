# Security headers for static files (Workers Static Assets, CLAUDE.md section 2, amendment 2026-10).
# The asset worker serves dist/client without running the Worker, so neither
# src/middleware.ts nor the src/worker.ts backstop ever sees these responses.
#
# The values are STATIC_SECURITY_HEADERS and ASSET_CSP in src/lib/http/securityHeaders.ts;
# tests/lib/headersFile.spec.ts fails when this file and those constants differ.
#
# Rules for editing:
# - NEVER set (or detach) Cache-Control here. The adapter adds `/_astro/*` immutable
#   caching to the built copy of this file only when no rule here already sets it for
#   that path, and `/*` matches it.
# - Header lines stay indented: the adapter reads every unindented line as a path.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'
