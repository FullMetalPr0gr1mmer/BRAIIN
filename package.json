{
  "name": "braiin-station",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/check-site-url.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "size": "size-limit && node scripts/admin-bundle.mjs",
    "lhci": "lhci autorun",
    "lhci:desktop": "lhci autorun --config=lighthouserc.desktop.json",
    "audit": "node scripts/audit-gate.mjs",
    "audit:all": "node scripts/audit-gate.mjs --include-dev",
    "cf:types": "wrangler types",
    "a11y:contrast": "node scripts/contrast-audit.mjs",
    "seo-ci": "vitest run tests/seo",
    "cf:secrets": "node scripts/push-secrets.mjs",
    "seed:gen": "node scripts/gen-seeds.mjs && node scripts/round2-cutover.mjs",
    "og:gen": "node scripts/gen-og-image.mjs",
    "postbuild": "node scripts/minify-css.mjs && node scripts/verify-build-origin.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^6.0.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "astro": "^7.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-vitals": "^4.2.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.49.0",
    "@size-limit/file": "^11.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "sharp": "0.35.5",
    "size-limit": "^11.1.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "tmp": "^0.2.7",
    "nanoid@3": "^3.3.18",
    "undici@7": "^7.29.0",
    "fast-uri@3": "^3.1.8",
    "js-yaml@3": "^3.15.2",
    "devalue": "^5.9.4",
    "brace-expansion@1": "^1.1.21"
  }
}
