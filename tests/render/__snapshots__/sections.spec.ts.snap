503%26origFormat%3Dpng&amp;w=520&amp;h=266&amp;f=png 520w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=780&amp;h=399&amp;f=png 780w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=1040&amp;h=532&amp;f=png 1040w" data-image-component="true" alt sizes="min(46vw, 520px)" decoding="async" loading="eager" fetchpriority="high" width="520" height="266"></picture></div><section class="hero"><div class="hero__media" data-video-src="/media/showreel.mp4"></div><div class="hero__inner"><h1 aria-label="شغل إبداعي يحقّق نتائج*"><span class="word" aria-hidden="true"><span class="letter">شغل</span></span> <span class="word" aria-hidden="true"><span class="letter">إبداعي</span></span> <span class="word accent" aria-hidden="true"><span class="letter">يحقّق</span></span> <span class="word accent" aria-hidden="true"><span class="letter">نتائج</span></span><span class="word word--mark" aria-hidden="true"><span class="letter letter--plain">*</span></span></h1><div class="hero__side"><p class="hero__sub">من الدماغ إلى أرض الواقع.</p><a class="cta hero__cta" href="#selected-work"><span>شوف أعمالنا</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="hero__scroll" aria-hidden="true"><i></i><span>انزل</span></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script><section class="clients" aria-label="عملاء مختارون" id="clients"><div class="tag tag--sky rv"><span class="dot"></span><span>عملاء مختارون</span></div><div class="clients__head"><h2 class="rv">بثقة العقول خلف أكبر لحظات المنطقة.</h2><span class="rv">منذ ٢٠١٩</span></div><div class="marquee"><ul class="marquee-track"><li class