at%3Djpg&amp;w=640&amp;h=360&amp;f=jpg 640w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=960&amp;h=540&amp;f=jpg 960w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1280&amp;h=720&amp;f=jpg 1280w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1600&amp;h=900&amp;f=jpg 1600w" data-image-component="true" alt sizes="100vw" loading="eager" decoding="async" fetchpriority="high" width="1600" height="900" class="mbanner__poster"></picture></div><a class="work-cap" href="/ar/portfolio/the-rider"><span class="work-cap__tag"><span class="work-cap__live" aria-hidden="true"></span><span>أحدث مشروع</span></span><span class="work-cap__t">الفارس | فيلم علامة</span><span class="work-cap__d">فيلم إطلاق.</span><span class="work-cap__m"><span>أكمي</span><span>2025</span></span></a></section><script type="module" src="<root>/src/components/media/MediaBanner.astro?astro&type=script&index=0&lang.ts"></script><section class="proof"><div class="proof__wrap"><div class="sb sb--proof sb--bare"><div class="sb__wrap"><p class="tag rv"><span class="dot"></span>بالأرقام</p><ul class="sb__grid"><li class="sb__cell rv"><span class="sb__n"><span class="sr-only">250+</span><span aria-hidden="true"><span data-count-to="250">250</span><i>+</i></span></span><span class="sb__l">مشروع منجز</span></li><li class="sb__cell rv"><span class="sb__n"><span class="sr-only">80</span><span aria-hidden="true"><span data-count-to="80">80</span></span></span><span class="sb__l">عميل</span></li><li class="sb__cell rv"><span class="sb__n sb__n--text">TBD</span><span class="sb__l">سنوات</span></li></ul></div></div><script type="module" src="<root>/src/components/sections/StatBand.astro?astro&type=script&index=0&lang.ts"></script><div id="quotes" role="group" aria-roledescription="عرض دوّار" aria-labelledby="quotes-heading" data-carousel class="tm tm--light"><div class="tm__grid"><div class="tm__side"><p class="tag rv"><span class="dot"></span>آراء العملاء</p><h2 class="rv" id="quotes-heading">بكلماتهم <em>هم</em></h2><div class="tm__nav rv" data-controls hidden><button class="tm__btn" type="button" data-prev aria-label="الرأي السابق"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H2M7 3L2 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button class="tm__btn" type="button" data-next aria-label="الرأي التالي"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button class="tm__btn tm__toggle" type="button" data-toggle data-label-pause="إيقاف تبديل الآراء" data-label-play="تشغيل تبديل الآراء" aria-label="إيقاف تبديل الآراء" hidden><svg class="tm__pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg><svg class="tm__play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l8 5-8 5z" fill="currentColor"></path></svg></button><span class="tm__count" data-counter aria-hidden="true"></span></div></div><div class="tm__main rv"><div class="tm__stage" data-stage aria-live="polite"><figure class="tm__q is-active" data-slide role="group" aria-roledescription="شريحة" aria-label="1 من 2"><svg class="tm__mark" viewBox="0 0 40 30" aria-hidden="true"><path fill="currentColor" d="M0 30V17.6C0 7.4 5.3 1.5 15.8 0l1.6 4.4C11.7 6 9 9.4 8.8 14.5H16V30H0Zm22.6 0V17.6C22.6 7.4 27.9 1.5 38.4 0L40 4.4c-5.7 1.6-8.4 5-8.6 10.1h7.2V30H22.6Z"></path></svg><blockquote class="tm__text"><p>سمعونا أول.</p></blockquote><figcaption class="tm__who"><span class="tm__av" aria-hidden="true">سم</span><span><span class="tm__n">سام مثال</span><span class="tm__r">رئيس العلامة، أكمي</span></span></figcaption></figure><figure class="tm__q" data-slide role="group" aria-roledescription="شريحة" aria-label="2 من 2"><svg class="tm__mark" viewBox="0 0 40 30" aria-hidden="true"><path fill="currentColor" d="M0 30V17.6C0 7.4 5.3 1.5 15.8 0l1.6 4.4C11.7 6 9 9.4 8.8 14.5H16V30H0Zm22.6 0V17.6C22.6 7.4 27.9 1.5 38.4 0L40 4.4c-5.7 1.6-8.4 5-8.6 10.1h7.2V30H22.6Z"></path></svg><blockquote class="tm__text"><p>في الموعد كل مرة.</p></blockquote><figcaption class="tm__who"><span class="tm__av" aria-hidden="true">لع</span><span><span class="tm__n">لي عينة</span></span></figcaption></figure></div><div class="tm__bar" aria-hidden="true"><i data-bar></i></div></div></div></div><script type="module" src="<root>/src/components/sections/Testimonials.astro?astro&type=script&index=0&lang.ts"></script></div></section><section class="work-intro work-intro--text"><div class="work-intro__grid"><div class="work-intro__txt rv"><p>كل مشروع هنا بدأ كرسمة في دفتر، وانتهى في مكان يقدر الناس يشوفونه أو يلمسونه أو يسمعونه. هذه مختارات من الشغل اللي نفتخر فيه أكثر.</p><a class="work-intro__link" href="#projects">شوف المشاريع</a></div></div></section><section class="pgrid catalog" id="projects" aria-labelledby="projects-heading" data-catalog="featured" data-base="/ar/portfolio" data-fragment="#projects" data-locale="ar" data-state="{}" data-pool="3"><div class="pgrid__head"><div><p class="tag tag--sky rv"><span class="dot"></span>أعمال مختارة</p><h2 class="rv" id="projects-heading">المشاريع</h2></div><span class="pgrid__count rv" data-count tabindex="-1" aria-live="polite">03 من 03 مختارة</span></div><div class="fb" data-filter-bar data-labels="{&quot;service&quot;:{&quot;animation&quot;:&quot;الرسوم المتحركة&quot;},&quot;sector&quot;:{&quot;retail&quot;:&quot;التجزئة&quot;,&quot;food&quot;:&quot;الأغذية&quot;},&quot;client&quot;:{&quot;acme&quot;:&quot;أكمي&quot;},&quot;year&quot;:{&quot;2023&quot;: