exports[`Hello rendered directly, as a service page does > service page (ar) 1`] = `"<section class="hello" id="inquiry" aria-labelledby="hello-heading"><div class="hello__wrap"><div class="hello__grid"><div class="hello__side"><div class="tag tag--sky rv"><span class="dot"></span><span>طلب مشروع</span></div><h2 class="hello__h rv hello__h--svc" id="hello-heading">خلّنا نتكلم عن <em>تصميم الشعار</em></h2><p class="hello__p rv">قل لنا وش تحتاج ووين لازم يظهر. يوصلك رد خلال يوم عمل واحد فيه أسئلتنا ونطاق سعري مبدئي.</p><div class="hello__rule rv" aria-hidden="true"></div><ul class="hello__pts rv"><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>رد خلال يوم عمل واحد</span></li><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>سعر ثابت بعد الاتفاق على النطاق</span></li><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>فريق واحد من أول رسمة إلى الإطلاق</span></li></ul></div><form id="contact-form" class="contact-form contact-form--full contact-form--hello" data-locale="ar" data-kind="project_inquiry" data-err-required="هذا الحقل مطلوب." data-err-email="أدخل بريدًا إلكترونيًا صحيحًا، مثل name@company.com." data-err-too-long="النص أطول من الحد المسموح." data-err-invalid="يرجى مراجعة هذا الحقل." novalidate><div class="field"><label for="cf-name">الاسم</label><input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="اسمك الكامل"></div><div class="field"><label for="cf-email">البريد الإلكتروني</label><input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@company.com"></div><div class="field"><label for="cf-company">الشركة</label><input id="cf-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="اختياري"></div><div class="field"><label for="cf-phone">الجوال أو واتساب</label><input id="cf-phone" name="phone" type="tel" dir="ltr" maxlength="32" autocomplete="tel" inputmode="tel" placeholder="+966 5X XXX XXXX"></div><div class="field"><label for="cf-service">وش تحتاج؟</label><select id="cf-service" name="service"><option value="">لسه ما قررت، خلّنا نتكلم</option><optgroup label="01 الهوية البصرية"><option value="discipline:branding">الهوية البصرية، ساعدوني أختار</option><option value="logo" selected>تصميم الشعار</option><option value="packaging">التغليف</option></optgroup><optgroup label="02 الإنتاج"><option value="discipline:production">الإنتاج، ساعدوني أختار</option><option value="animation">الرسوم المتحركة</option></optgroup></select></div><div class="field"><label for="cf-budget">نطاق الميزانية</label><select id="cf-budget" name="budget"><option value="">أفضّل نتناقش فيها</option><option value="lt_25k">أقل من ٢٥ ألف ريال</option><option value="25k_75k">٢٥ إلى ٧٥ ألف ريال</option><option value="75k_200k">٧٥ إلى ٢٠٠ ألف ريال</option><option value="gt_200k">٢٠٠ ألف ريال فأكثر</option><option value="not_sure">لسه ما حددنا</option></select></div><div class="field field-full"><label for="cf-message">احكِ لنا عن المشروع</label><textarea id="cf-message" name="message" required maxlength="5000" placeholder="وش تصنع، ولمين، ومتى لازم يكون جاهز؟"></textarea></div><div class="field field-full field-check"><input id="cf-consent" name="consent" type="checkbox"><label for="cf-consent">أوافق على التواصل معي بخصوص طلبي.</label></div><div class="hp-field" aria-hidden="true"><label for="cf-hp">Leave this field empty</label><input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><div class="contact-form__foot field-full"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>أرسل رسالتك</span></button><p class="contact-form__note">نقرأ كل رسالة ونرد خلال يوم عمل واحد.</p></div><p id="contact-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="جارٍ الإرسال…" data-ok="وصلتنا. بنتواصل معك خلال يوم عمل واحد." data-invalid="يرجى تصحيح الحقول المشار إليها والمحاولة مرة أخرى." data-rate-limited="محاولات كثيرة. يرجى الانتظار دقيقة ثم المحاولة مرة أخرى." data-unavailable="النموذج غير مُفعّل بعد — راسلنا على hello@braiinstatiion.com." data-error="حدث خطأ ما. حاول مرة أخرى."></p></form><script type="module" src="<root>/src/components/ContactForm.astro?astro&type=script&index=0&lang.ts"></script></div></div></section>"`;

exports[`Hello rendered directly, as a service page does > service page (en) 1`] = `"<section class="hello" id="inquiry" aria-labelledby="hello-heading"><div class="hello__wrap"><div class="hello__grid"><div class="hello__side"><div class="tag tag--sky rv"><span class="dot"></span><span>Project inquiry</span></div><h2 class="hello__h rv hello__h--svc" id="hello-heading">Let&#39;s talk <em>Logo Design</em></h2><p class="hello__p rv">Tell us what you need and where it has to show up. You&#39;ll hear back within one business day with our questions and a rough range.</p><div class="hello__rule rv" aria-hidden="true"></div><ul class="hello__pts rv"><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>A reply within one business day</span></li><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>A fixed price once the scope is agreed</span></li><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>One team from the first sketch to launch</span></li></ul></div><form id="contact-form" class="contact-form contact-form--full contact-form--hello" data-locale="en" data-kind="project_inquiry" data-err-required="This field is required." data-err-email="Enter a valid email address, like name@company.com." data-err-too-long="This is longer than we can accept." data-err-invalid="Please check this field." novalidate><div class="field"><label for="cf-name">Name</label><input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="Your full name"></div><div class="field"><label for="cf-email">Email</label><input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@company.com"></div><div class="field"><label for="cf-company">Company</label><input id="cf-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="Optional"></div><div class="field"><label for="cf-phone">Phone or WhatsApp</label><input id="cf-phone" name="phone" type="tel" dir="ltr" maxlength="32" autocomplete="tel" inputmode="tel" placeholder="+966 5X XXX XXXX"></div><div class="field"><label for="cf-service">What do you need?</label><select id="cf-service" name="service"><option value="">Not sure yet, let&#39;s talk</option><optgroup label="01 Branding"><option value="discipline:branding">Branding, help me choose</option><option value="logo" selected>Logo Design</option><option value="packaging">Packaging</option></optgroup><optgroup label="02 Production"><option value="discipline:production">Production, help me choose</option><option value="animation">Animation</option></optgroup></select></div><div class="field"><label for="cf-budget">Budget range</label><select id="cf-budget" name="budget"><option value="">Prefer to discuss</option><option value="lt_25k">Under 25k SAR</option><option value="25k_75k">25k to 75k SAR</option><option value="75k_200k">75k to 200k SAR</option><option value="gt_200k">200k SAR and up</option><option value="not_sure">Not sure yet</option></select></div><div class="field field-full"><label for="cf-message">Tell us about the project</label><textarea id="cf-message" name="message" required maxlength="5000" placeholder="What are you making, who is it for, and when does it need to be ready?"></textarea></div><div class="field field-full field-check"><input id="cf-consent" name="consent" type="checkbox"><label for="cf-consent">I agree to be contacted about my inquiry.</label></div><div class="hp-field" aria-hidden="true"><label for="cf-hp">Leave this field empty</label><input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><div class="contact-form__foot field-full"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Send a message</span></button><p class="contact-form__note">We read everything and reply within one business day.</p></div><p id="contact-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="Sending…" data-ok="Got it. We'll be in touch within one business day." data-invalid="Please correct the marked fields and try again." data-rate-limited="Too many attempts. Please wait a minute and try again." data-unavailable="The form isn’t live yet — please email hello@braiinstatiion.com." data-error="Something went wrong. Please try again."></p></form><script type="module" src="<root>/src/components/ContactForm.astro?astro&type=script&index=0&lang.ts"></script></div></div></section>"`;

