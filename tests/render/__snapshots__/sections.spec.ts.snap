exports[`every content field authored > contactInquiry (ar) 1`] = `"<section class="contact-inquiry" id="inquiry" aria-labelledby="inquiry-heading"><div class="section-wrap"><div class="tag tag--sky rv"><span class="dot"></span><span>وسم مكتوب</span></div><div class="sec-head"><h2 class="rv" id="inquiry-heading">عنوان <em>الطلب المكتوب</em></h2><p class="rv">مقدمة مكتوبة.</p></div><form id="contact-form" class="contact-form contact-form--full" data-locale="ar" data-kind="project_inquiry" data-err-required="هذا الحقل مطلوب." data-err-email="أدخل بريدًا إلكترونيًا صحيحًا، مثل name@company.com." data-err-too-long="النص أطول من الحد المسموح." data-err-invalid="يرجى مراجعة هذا الحقل." novalidate><div class="field"><label for="cf-name">الاسم</label><input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="اسمك الكامل"></div><div class="field"><label for="cf-email">البريد الإلكتروني</label><input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@company.com"></div><div class="field"><label for="cf-company">الشركة</label><input id="cf-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="اختياري"></div><div class="field"><label for="cf-service">وش تحتاج؟</label><select id="cf-service" name="service"><option value="" selected>لسه ما قررت، خلّنا نتكلم</option><optgroup label="01 الهوية البصرية"><option value="discipline:branding">الهوية البصرية، ساعدوني أختار</option><option value="logo">تصميم الشعار</option><option value="packaging">التغليف</option></optgroup><optgroup label="02 الإنتاج"><option value="discipline:production">الإنتاج، ساعدوني أختار</option><option value="animation">الرسوم المتحركة</option></optgroup></select></div><div class="field"><label for="cf-budget">نطاق الميزانية</label><select id="cf-budget" name="budget"><option value="">أفضّل نتناقش فيها</option><option value="lt_25k">أقل من ٢٥ ألف ريال</option><option value="25k_75k">٢٥ إلى ٧٥ ألف ريال</option><option value="75k_200k">٧٥ إلى ٢٠٠ ألف ريال</option><option value="gt_200k">٢٠٠ ألف ريال فأكثر</option><option value="not_sure">لسه ما حددنا</option></select></div><div class="field"><label for="cf-deadline">متى تحتاجه؟</label><input id="cf-deadline" name="deadline" type="text" maxlength="120" autocomplete="off" placeholder="تاريخ، أو موسم، أو في أقرب وقت"></div><div class="field field-full"><label for="cf-message">احكِ لنا عن المشروع</label><textarea id="cf-message" name="message" required maxlength="5000" placeholder="وش تصنع، ولمين، ومتى لازم يكون جاهز؟"></textarea></div><div class="field field-full field-check"><input id="cf-consent" name="consent" type="checkbox"><label for="cf-consent">أوافق على التواصل معي بخصوص طلبي.</label></div><div class="hp-field" aria-hidden="true"><label for="cf-hp">Leave this field empty</label><input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><div class="contact-form__foot field-full"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>إرسال مكتوب</span></button><p class="contact-form__note">ملاحظة مكتوبة.</p></div><p id="contact-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="جارٍ الإرسال…" data-ok="نجاح مكتوب." data-invalid="يرجى تصحيح الحقول المشار إليها والمحاولة مرة أخرى." data-rate-limited="محاولات كثيرة. يرجى الانتظار دقيقة ثم المحاولة مرة أخرى." data-unavailable="النموذج غير مُفعّل بعد — راسلنا على hello@braiinstatiion.com." data-error="حدث خطأ ما. حاول مرة أخرى."></p></form><script type="module" src="<root>/src/components/ContactForm.astro?astro&type=script&index=0&lang.ts"></script></div></section>"`;

exports[`every content field authored > contactInquiry (en) 1`] = `"<section class="contact-inquiry" id="inquiry" aria-labelledby="inquiry-heading"><div class="section-wrap"><div class="tag tag--sky rv"><span class="dot"></span><span>Authored tag</span></div><div class="sec-head"><h2 class="rv" id="inquiry-heading">Authored <em>inquiry heading</em></h2><p class="rv">Authored lead.</p></div><form id="contact-form" class="contact-form contact-form--full" data-locale="en" data-kind="project_inquiry" data-err-required="This field is required." data-err-email="Enter a valid email address, like name@company.com." data-err-too-long="This is longer than we can accept." data-err-invalid="Please check this field." novalidate><div class="field"><label for="cf-name">Name</label><input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="Your full name"></div><div class="field"><label for="cf-email">Email</label><input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@company.com"></div><div class="field"><label for="cf-company">Company</label><input id="cf-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="Optional"></div><div class="field"><label for="cf-service">What do you need?</label><select id="cf-service" name="service"><option value="" selected>Not sure yet, let&#39;s talk</option><optgroup label="01 Branding"><option value="discipline:branding">Branding, help me choose</option><option value="logo">Logo Design</option><option value="packaging">Packaging</option></optgroup><optgroup label="02 Production"><option value="discipline:production">Production, help me choose</option><option value="animation">Animation</option></optgroup></select></div><div class="field"><label for="cf-budget">Budget range</label><select id="cf-budget" name="budget"><option value="">Prefer to discuss</option><option value="lt_25k">Under 25k SAR</option><option value="25k_75k">25k to 75k SAR</option><option value="75k_200k">75k to 200k SAR</option><option value="gt_200k">200k SAR and up</option><option value="not_sure">Not sure yet</option></select></div><div class="field"><label for="cf-deadline">When do you need it?</label><input id="cf-deadline" name="deadline" type="text" maxlength="120" autocomplete="off" placeholder="A date, a season, or ASAP"></div><div class="field field-full"><label for="cf-message">Tell us about the project</label><textarea id="cf-message" name="message" required maxlength="5000" placeholder="What are you making, who is it for, and when does it need to be ready?"></textarea></div><div class="field field-full field-check"><input id="cf-consent" name="consent" type="checkbox"><label for="cf-consent">I agree to be contacted about my inquiry.</label></div><div class="hp-field" aria-hidden="true"><label for="cf-hp">Leave this field empty</label><input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><div class="contact-form__foot field-full"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Authored submit</span></button><p class="contact-form__note">Authored note.</p></div><p id="contact-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="Sending…" data-ok="Authored success." data-invalid="Please correct the marked fields and try again." data-rate-limited="Too many attempts. Please wait a minute and try again." data-unavailable="The form isn’t live yet — please email hello@braiinstatiion.com." data-error="Something went wrong. Please try again."></p></form><script type="module" src="<root>/src/components/ContactForm.astro?astro&type=script&index=0&lang.ts"></script></div></section>"`;

exports[`every content field authored > cta (ar) 1`] = `"<section class="lead-band klein-band" aria-labelledby="lead-band-heading"><div class="lead-band__wrap"><p class="tag rv"><span class="dot"></span>وسم مكتوب</p><h2 class="rv" id="lead-band-heading">عنوان <em>مكتوب للطلب</em></h2><div class="lead-band__row"><p class="rv">نص مكتوب.</p><div class="lead-band__acts rv"><a href="/ar/services" class="cta cta--badge cta--light cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>زر مكتوب</span></a><a class="lead-band__mail" href="mailto:hello@braiinstatiion.com" dir="ltr" data-track="email">hello@braiinstatiion.com</a></div></div></div></section>"`;

exports[`every content field authored > cta (en) 1`] = `"<section class="lead-band klein-band" aria-labelledby="lead-band-heading"><div class="lead-band__wrap"><p class="tag rv"><span class="dot"></span>Authored tag</p><h2 class="rv" id="lead-band-heading">Authored <em>lead heading</em></h2><div class="lead-band__row"><p class="rv">Authored text.</p><div class="lead-band__acts rv"><a href="/services" class="cta cta--badge cta--light cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Authored button</span></a><a class="lead-band__mail" href="mailto:hello@braiinstatiion.com" dir="ltr" data-track="email">hello@braiinstatiion.com</a></div></div></div></section>"`;

exports[`every content field authored > faq (ar) 1`] = `"<section class="faq-section" id="faq" aria-labelledby="faq-heading"><div class="section-wrap"><div class="tag tag--sky rv"><span class="dot"></span><span>وسم مكتوب</span></div><div class="sec-head"><h2 class="rv" id="faq-heading">عنوان <em>الأسئلة المكتوب</em></h2></div><div class="faq-list"><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">وش تشمل الهوية البصرية الكاملة؟</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>الاستراتيجية، واتجاه التسمية إذا احتجته، ونظام شعار متكامل، والخطوط والألوان، والإخراج الفني، ودليل استخدام. تخرج بملفات يقدر فريقك أو أي جهة مستقبلية يشتغلون عليها فعلاً، مو مجلد صور.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">كم اتجاه نشوف؟</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>اتجاهين أو ثلاثة، وكل واحد منها اتجاه نسعد ببنائه. ما نحشو العرض بخيارات ما نؤمن فيها عشان يبان أكبر.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">كم جولة تعديلات تجي معها؟</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>جولتان مضمّنتان في كل مرحلة. وإذا احتجت أكثر نحسبها بالساعة، ونخبرك قبل ما يبدأ العداد، لا بعده.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">كم ياخذ المشروع وقت؟</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>الهوية البصرية عادةً من ستة إلى عشرة أسابيع. الفيلم يعتمد على التصوير. الحملة الاجتماعية ممكن تتحرك في أسبوعين. تستلم جدولاً بتواريخ قبل بداية الشغل، مو بعد ما يتأخر.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">نقدر نطلب خدمة واحدة بس؟</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>أكيد. خذ واحدة من الثمان والعشرين أو خذها كلها. ما في شيء مربوط ببعضه عشان تكبر الفاتورة.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">تشتغلون مع علامات قائمة أصلاً؟</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>كثير. أحياناً الجواب إعادة بناء كاملة، وأحياناً مجرد ضبط، وبنقول لك بصراحة أي واحدة تحتاجها حتى لو كان الشغل الأصغر هو الصح.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">بأي لغات تشتغلون؟</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>العربية والإنجليزية داخل الاستوديو وبشكل أصلي. وأي لغة ثانية عبر شركاء مجرَّبين، ويبقى التنسيق والإخراج الفني عندنا حتى ما تطلع النتيجة وكأنها ترجمة.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">كيف تُحسب الأسعار؟</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>سعر ثابت للمشروع بعد الاتفاق على النطاق، أو عقد شهري للشغل المستمر. بدون مفاجآت بالساعة في النهاية.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">لمن تعود ملكية الشغل؟</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>لك أنت. نقل كامل للحقوق عند السداد النهائي، وملفات المصدر مشمولة.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">كيف نبدأ؟</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>أرسل النموذج فوق أو راسلنا مباشرة. يوصلك رد خلال يوم عمل واحد فيه أسئلتنا، ونطاق سعري مبدئي، وموعد للمكالمة.</p></div></details></div></div></section>"`;

exports[`every content field authored > faq (en) 1`] = `"<section class="faq-section" id="faq" aria-labelledby="faq-heading"><div class="section-wrap"><div class="tag tag--sky rv"><span class="dot"></span><span>Authored tag</span></div><div class="sec-head"><h2 class="rv" id="faq-heading">Authored <em>FAQ heading</em></h2></div><div class="faq-list"><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">What does a full brand identity include?</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>Strategy, naming direction if you need it, a logo system, type and colour, art direction, and a usage guide. You leave with files your own team and any future vendor can actually work from, not a folder of JPEGs.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">How many concepts do we see?</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>Two or three routes, and every one of them is a direction we would be happy to build. We don&#39;t pad a presentation with options we don&#39;t believe in just to make the deck look fuller.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">How many rounds of revisions come with that?</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>Two rounds are built into every stage. If you want more we bill by the hour, and we tell you before the clock starts, never after.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">How long does a project take?</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>A brand identity usually runs six to ten weeks. A film depends on the shoot. A social campaign can move in two. You get a dated schedule before the work starts, not once it&#39;s already late.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">Can we hire you for just one service?</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>Yes. Take one of the twenty-eight or take all of them. Nothing is bundled together to force a bigger invoice.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">Do you work with brands that already exist?</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>Often. Sometimes the answer is a full rebuild and sometimes it&#39;s a tune-up, and we&#39;ll tell you honestly which one you need even when the smaller job is the right call.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">What languages do you work in?</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>Arabic and English are handled natively in house. Anything else runs through partners we&#39;ve vetted, with our team still owning the typesetting and art direction so the result doesn&#39;t read like a translation.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">How is pricing structured?</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>A fixed price per project once the scope is agreed, or a monthly retainer for ongoing work. No hourly surprises at the end.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">Who owns the finished work?</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>You do. Full rights transfer on final payment, source files included.</p></div></details><details class="faq-item rv" name="faq"><summary class="faq-item__q"><span class="faq-item__t">How do we get started?</span><span class="faq-item__i" aria-hidden="true"></span></summary><div class="faq-item__a"><p>Send the form above or email us directly. You&#39;ll get a reply within one business day with our questions, a rough range, and a time to talk.</p></div></details></div></div></section>"`;

exports[`every content field authored > hello (ar) 1`] = `"<section class="hello" id="inquiry" aria-labelledby="hello-heading"><div class="hello__wrap"><div class="hello__grid"><div class="hello__side"><div class="tag tag--sky rv"><span class="dot"></span><span>وسم مكتوب</span></div><h2 class="hello__h rv" id="hello-heading">عنوان <em>الترحيب المكتوب</em></h2><p class="hello__p rv">مقدمة مكتوبة.</p><div class="hello__rule rv" aria-hidden="true"></div><ul class="hello__pts rv"><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>النقطة الأولى</span></li></ul></div><form id="contact-form" class="contact-form contact-form--full contact-form--hello" data-locale="ar" data-kind="project_inquiry" data-err-required="هذا الحقل مطلوب." data-err-email="أدخل بريدًا إلكترونيًا صحيحًا، مثل name@company.com." data-err-too-long="النص أطول من الحد المسموح." data-err-invalid="يرجى مراجعة هذا الحقل." novalidate><div class="field"><label for="cf-name">الاسم</label><input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="اسمك الكامل"></div><div class="field"><label for="cf-email">البريد الإلكتروني</label><input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@company.com"></div><div class="field"><label for="cf-company">الشركة</label><input id="cf-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="اختياري"></div><div class="field"><label for="cf-phone">الجوال أو واتساب</label><input id="cf-phone" name="phone" type="tel" dir="ltr" maxlength="32" autocomplete="tel" inputmode="tel" placeholder="+966 5X XXX XXXX"></div><div class="field"><label for="cf-service">وش تحتاج؟</label><select id="cf-service" name="service"><option value="" selected>لسه ما قررت، خلّنا نتكلم</option><optgroup label="01 الهوية البصرية"><option value="discipline:branding">الهوية البصرية، ساعدوني أختار</option><option value="logo">تصميم الشعار</option><option value="packaging">التغليف</option></optgroup><optgroup label="02 الإنتاج"><option value="discipline:production">الإنتاج، ساعدوني أختار</option><option value="animation">الرسوم المتحركة</option></optgroup></select></div><div class="field"><label for="cf-budget">نطاق الميزانية</label><select id="cf-budget" name="budget"><option value="">أفضّل نتناقش فيها</option><option value="lt_25k">أقل من ٢٥ ألف ريال</option><option value="25k_75k">٢٥ إلى ٧٥ ألف ريال</option><option value="75k_200k">٧٥ إلى ٢٠٠ ألف ريال</option><option value="gt_200k">٢٠٠ ألف ريال فأكثر</option><option value="not_sure">لسه ما حددنا</option></select></div><div class="field field-full"><label for="cf-message">احكِ لنا عن المشروع</label><textarea id="cf-message" name="message" required maxlength="5000" placeholder="وش تصنع، ولمين، ومتى لازم يكون جاهز؟"></textarea></div><div class="field field-full field-check"><input id="cf-consent" name="consent" type="checkbox"><label for="cf-consent">أوافق على التواصل معي بخصوص طلبي.</label></div><div class="hp-field" aria-hidden="true"><label for="cf-hp">Leave this field empty</label><input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><div class="contact-form__foot field-full"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>أرسل رسالتك</span></button><p class="contact-form__note">نقرأ كل رسالة ونرد خلال يوم عمل واحد.</p></div><p id="contact-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="جارٍ الإرسال…" data-ok="وصلتنا. بنتواصل معك خلال يوم عمل واحد." data-invalid="يرجى تصحيح الحقول المشار إليها والمحاولة مرة أخرى." data-rate-limited="محاولات كثيرة. يرجى الانتظار دقيقة ثم المحاولة مرة أخرى." data-unavailable="النموذج غير مُفعّل بعد — راسلنا على hello@braiinstatiion.com." data-error="حدث خطأ ما. حاول مرة أخرى."></p></form><script type="module" src="<root>/src/components/ContactForm.astro?astro&type=script&index=0&lang.ts"></script></div></div></section>"`;

exports[`every content field authored > hello (en) 1`] = `"<section class="hello" id="inquiry" aria-labelledby="hello-heading"><div class="hello__wrap"><div class="hello__grid"><div class="hello__side"><div class="tag tag--sky rv"><span class="dot"></span><span>Authored tag</span></div><h2 class="hello__h rv" id="hello-heading">Authored <em>hello heading</em></h2><p class="hello__p rv">Authored lead.</p><div class="hello__rule rv" aria-hidden="true"></div><ul class="hello__pts rv"><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>Point one</span></li></ul></div><form id="contact-form" class="contact-form contact-form--full contact-form--hello" data-locale="en" data-kind="project_inquiry" data-err-required="This field is required." data-err-email="Enter a valid email address, like name@company.com." data-err-too-long="This is longer than we can accept." data-err-invalid="Please check this field." novalidate><div class="field"><label for="cf-name">Name</label><input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="Your full name"></div><div class="field"><label for="cf-email">Email</label><input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@company.com"></div><div class="field"><label for="cf-company">Company</label><input id="cf-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="Optional"></div><div class="field"><label for="cf-phone">Phone or WhatsApp</label><input id="cf-phone" name="phone" type="tel" dir="ltr" maxlength="32" autocomplete="tel" inputmode="tel" placeholder="+966 5X XXX XXXX"></div><div class="field"><label for="cf-service">What do you need?</label><select id="cf-service" name="service"><option value="" selected>Not sure yet, let&#39;s talk</option><optgroup label="01 Branding"><option value="discipline:branding">Branding, help me choose</option><option value="logo">Logo Design</option><option value="packaging">Packaging</option></optgroup><optgroup label="02 Production"><option value="discipline:production">Production, help me choose</option><option value="animation">Animation</option></optgroup></select></div><div class="field"><label for="cf-budget">Budget range</label><select id="cf-budget" name="budget"><option value="">Prefer to discuss</option><option value="lt_25k">Under 25k SAR</option><option value="25k_75k">25k to 75k SAR</option><option value="75k_200k">75k to 200k SAR</option><option value="gt_200k">200k SAR and up</option><option value="not_sure">Not sure yet</option></select></div><div class="field field-full"><label for="cf-message">Tell us about the project</label><textarea id="cf-message" name="message" required maxlength="5000" placeholder="What are you making, who is it for, and when does it need to be ready?"></textarea></div><div class="field field-full field-check"><input id="cf-consent" name="consent" type="checkbox"><label for="cf-consent">I agree to be contacted about my inquiry.</label></div><div class="hp-field" aria-hidden="true"><label for="cf-hp">Leave this field empty</label><input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><div class="contact-form__foot field-full"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Send a message</span></button><p class="contact-form__note">We read everything and reply within one business day.</p></div><p id="contact-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="Sending…" data-ok="Got it. We'll be in touch within one business day." data-invalid="Please correct the marked fields and try again." data-rate-limited="Too many attempts. Please wait a minute and try again." data-unavailable="The form isn’t live yet — please email hello@braiinstatiion.com." data-error="Something went wrong. Please try again."></p></form><script type="module" src="<root>/src/components/ContactForm.astro?astro&type=script&index=0&lang.ts"></script></div></div></section>"`;

exports[`every content field authored > hero (ar) 1`] = `"<section class="hero"><div class="hero__media" data-video-src="/media/showreel.mp4"></div><div class="hero__inner"><h1 aria-label="عنوان رئيسي مكتوب هنا"><span class="word" aria-hidden="true"><span class="letter">عنوان</span></span> <span class="word accent" aria-hidden="true"><span class="letter">رئيسي</span></span> <span class="word accent" aria-hidden="true"><span class="letter">مكتوب</span></span> <span class="word accent" aria-hidden="true"><span class="letter">هنا</span></span></h1><div class="hero__side"><p class="hero__sub">سطر فرعي مكتوب.</p><a class="cta hero__cta" href="#selected-work"><span>زر مكتوب</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="hero__scroll" aria-hidden="true"><i></i><span>انزل</span></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script>"`;

exports[`every content field authored > hero (en) 1`] = `"<section class="hero"><div class="hero__media" data-video-src="/media/showreel.mp4"></div><div class="hero__inner"><h1 aria-label="Authored hero headline here"><span class="word" aria-hidden="true"><span class="letter">A</span><span class="letter">u</span><span class="letter">t</span><span class="letter">h</span><span class="letter">o</span><span class="letter">r</span><span class="letter">e</span><span class="letter">d</span></span> <span class="word" aria-hidden="true"><span class="letter">h</span><span class="letter">e</span><span class="letter">r</span><span class="letter">o</span></span> <span class="word accent" aria-hidden="true"><span class="letter">h</span><span class="letter">e</span><span class="letter">a</span><span class="letter">d</span><span class="letter">l</span><span class="letter">i</span><span class="letter">n</span><span class="letter">e</span></span> <span class="word accent" aria-hidden="true"><span class="letter">h</span><span class="letter">e</span><span class="letter">r</span><span class="letter">e</span></span></h1><div class="hero__side"><p class="hero__sub">An authored sub line.</p><a class="cta hero__cta" href="#selected-work"><span>Authored CTA</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="hero__scroll" aria-hidden="true"><i></i><span>Scroll</span></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script>"`;

exports[`every content field authored > hero, a Stream loop and the intro plate (ar) 1`] = `"<div class="intro" aria-hidden="true"><picture><source srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=260&amp;h=133&amp;f=avif 260w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=520&amp;h=266&amp;f=avif 520w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=780&amp;h=399&amp;f=avif 780w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=1040&amp;h=532&amp;f=avif 1040w" type="image/avif" sizes="min(46vw, 520px)"><source srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=260&amp;h=133&amp;f=webp 260w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=520&amp;h=266&amp;f=webp 520w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=780&amp;h=399&amp;f=webp 780w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=1040&amp;h=532&amp;f=webp 1040w" type="image/webp" sizes="min(46vw, 520px)"><img src="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=520&amp;h=266&amp;f=png" srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=260&amp;h=133&amp;f=png 260w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=520&amp;h=266&amp;f=png 520w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=780&amp;h=399&amp;f=png 780w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=1040&amp;h=532&amp;f=png 1040w" data-image-component="true" alt sizes="min(46vw, 520px)" decoding="async" loading="eager" fetchpriority="high" width="520" height="266"></picture></div><section class="hero"><div class="hero__media"></div><div class="hero__inner"><h1 aria-label="شغل إبداعي يحقّق نتائج*"><span class="word" aria-hidden="true"><span class="letter">شغل</span></span> <span class="word" aria-hidden="true"><span class="letter">إبداعي</span></span> <span class="word accent" aria-hidden="true"><span class="letter">يحقّق</span></span> <span class="word accent" aria-hidden="true"><span class="letter">نتائج</span></span><span class="word word--mark" aria-hidden="true"><span class="letter letter--plain">*</span></span></h1><div class="hero__side"><p class="hero__sub">من الدماغ إلى أرض الواقع.</p><a class="cta hero__cta" href="#selected-work"><span>شوف أعمالنا</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="hero__scroll" aria-hidden="true"><i></i><span>انزل</span></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script>"`;

exports[`every content field authored > hero, a Stream loop and the intro plate (en) 1`] = `"<div class="intro" aria-hidden="true"><picture><source srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=260&amp;h=133&amp;f=avif 260w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=520&amp;h=266&amp;f=avif 520w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=780&amp;h=399&amp;f=avif 780w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=1040&amp;h=532&amp;f=avif 1040w" type="image/avif" sizes="min(46vw, 520px)"><source srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=260&amp;h=133&amp;f=webp 260w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=520&amp;h=266&amp;f=webp 520w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=780&amp;h=399&amp;f=webp 780w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=1040&amp;h=532&amp;f=webp 1040w" type="image/webp" sizes="min(46vw, 520px)"><img src="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=520&amp;h=266&amp;f=png" srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=260&amp;h=133&amp;f=png 260w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=520&amp;h=266&amp;f=png 520w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=780&amp;h=399&amp;f=png 780w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=1040&amp;h=532&amp;f=png 1040w" data-image-component="true" alt sizes="min(46vw, 520px)" decoding="async" loading="eager" fetchpriority="high" width="520" height="266"></picture></div><section class="hero"><div class="hero__media"></div><div class="hero__inner"><h1 aria-label="Creative work that performs*"><span class="word" aria-hidden="true"><span class="letter">C</span><span class="letter">r</span><span class="letter">e</span><span class="letter">a</span><span class="letter">t</span><span class="letter">i</span><span class="letter">v</span><span class="letter">e</span></span> <span class="word" aria-hidden="true"><span class="letter">w</span><span class="letter">o</span><span class="letter">r</span><span class="letter">k</span></span> <span class="word" aria-hidden="true"><span class="letter">t</span><span class="letter">h</span><span class="letter">a</span><span class="letter">t</span></span> <span class="word accent" aria-hidden="true"><span class="letter">p</span><span class="letter">e</span><span class="letter">r</span><span class="letter">f</span><span class="letter">o</span><span class="letter">r</span><span class="letter">m</span><span class="letter">s</span></span><span class="word word--mark" aria-hidden="true"><span class="letter letter--plain">*</span></span></h1><div class="hero__side"><p class="hero__sub">From the brain to the real world.</p><a class="cta hero__cta" href="#selected-work"><span>See our work</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="hero__scroll" aria-hidden="true"><i></i><span>Scroll</span></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script>"`;

exports[`every content field authored > joinApply (ar) 1`] = `"<section class="join-apply" id="apply" aria-labelledby="join-apply-heading"><div class="section-wrap"><div class="tag tag--sky rv"><span class="dot"></span><span>وسم مكتوب</span></div><div class="sec-head"><h2 class="rv" id="join-apply-heading">عنوان <em>التقديم المكتوب</em></h2><div class="join-apply__lead rv" id="apply-lead" data-closed="false"><p class="join-apply__p">مقدمة مكتوبة.</p><p class="join-apply__closed">لا نستقبل طلبات التوظيف حاليًا. عُد إلينا قريبًا.</p></div></div><form id="apply-form" class="apply-form is-sent" method="post" action="/api/apply" enctype="multipart/form-data" novalidate data-locale="ar" data-status-url="/api/apply/status" data-closed-target="apply-lead" data-err-required="هذا الحقل مطلوب." data-err-email="أدخل بريدًا إلكترونيًا صحيحًا، مثل you@email.com." data-err-url="أدخل رابطًا كاملًا يبدأ بـ https://" data-err-too-long="النص أطول من الحد المسموح." data-err-invalid="يرجى مراجعة هذا الحقل." data-err-consent="يرجى تحديد هذا المربع لنحتفظ بطلبك ونراجعه."><p id="apply-status" class="form-status af-status is-ok" role="status" aria-live="polite" tabindex="-1" data-sending="جارٍ الإرسال…" data-ok="نجاح مكتوب." data-invalid="بعض الإجابات ناقصة أو تحتاج إلى مراجعة. يرجى مراجعة النموذج والمحاولة مرة أخرى." data-too-large="حجم الملف أكبر من المسموح. يمكن أن يصل حجم سيرتك الذاتية إلى ١٠ ميجابايت." data-bad-type="لا يمكن قبول هذا الملف. استخدم ملف PDF أو Word ‏(.docx) أقل من ١٠ ميجابايت." data-rate-limited="محاولات كثيرة. يرجى الانتظار قليلًا ثم المحاولة مرة أخرى." data-unavailable="لا يمكننا استقبال الطلبات في الوقت الحالي. يرجى المحاولة لاحقًا." data-closed="لا نستقبل طلبات التوظيف حاليًا. عُد إلينا قريبًا." data-error="حدث خطأ ما. حاول مرة أخرى.">نجاح مكتوب.</p><fieldset class="af-group"><legend class="af-group__t">عنك</legend><div class="af-grid"><div class="field"><label for="af-name">الاسم الكامل</label><input id="af-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="اسمك الكامل"></div><div class="field"><label for="af-email">البريد الإلكتروني</label><input id="af-email" name="email" type="email" required maxlength="254" autocomplete="email" dir="ltr" placeholder="you@email.com"></div><div class="field"><label for="af-phone">الجوال</label><input id="af-phone" name="phone" type="tel" required minlength="6" maxlength="32" autocomplete="tel" inputmode="tel" dir="ltr" placeholder="+966 5X XXX XXXX"></div><div class="field"><label for="af-city">المدينة</label><input id="af-city" name="city" type="text" required maxlength="80" autocomplete="address-level2" placeholder="جدة، الرياض، أي مكان"></div></div></fieldset><fieldset class="af-group"><legend class="af-group__t">الدور</legend><div class="af-grid"><div class="field"><label for="af-role">الوظيفة اللي تهمّك</label><input id="af-role" name="role" type="text" required maxlength="120" autocomplete="off" placeholder="مصمم موشن، كاتب محتوى، منتج"></div><div class="field"><label for="af-experience">الخبرة</label><select id="af-experience" name="experience" required><option value="">اختر واحداً</option><option value="student">طالب أو خريج</option><option value="1-3">من سنة إلى ٣ سنوات</option><option value="3-6">من ٣ إلى ٦ سنوات</option><option value="6-plus">أكثر من ٦ سنوات</option></select></div><div class="field"><label for="af-work-type">كيف تحب تشتغل</label><select id="af-work-type" name="work_type" required><option value="">اختر واحداً</option><option value="full-time">دوام كامل</option><option value="freelance">عمل حر</option><option value="internship">تدريب</option><option value="any">أي شكل</option></select></div><div class="field"><label for="af-availability">متى تقدر تبدأ؟</label><select id="af-availability" name="availability" required><option value="">اختر واحداً</option><option value="immediately">فوراً</option><option value="two-weeks">خلال أسبوعين</option><option value="month">خلال شهر</option><option value="later">بعد أكثر من شهر</option></select></div><div class="af-chips af-full" role="group" aria-labelledby="af-skills-label"><p class="af-label" id="af-skills-label">الحِرف اللي تشتغل فيها</p><div class="af-chips__row"><label class="af-chip"><input type="checkbox" name="skills" value="branding"><span>الهوية البصرية</span></label><label class="af-chip"><input type="checkbox" name="skills" value="animation"><span>الرسوم المتحركة</span></label><label class="af-chip"><input type="checkbox" name="skills" value="motion-graphics"><span>الموشن جرافيك</span></label><label class="af-chip"><input type="checkbox" name="skills" value="videography"><span>الإنتاج المرئي</span></label><label class="af-chip"><input type="checkbox" name="skills" value="photography"><span>التصوير الفوتوغرافي</span></label><label class="af-chip"><input type="checkbox" name="skills" value="montage"><span>المونتاج</span></label><label class="af-chip"><input type="checkbox" name="skills" value="event-planning"><span>تنظيم الفعاليات</span></label><label class="af-chip"><input type="checkbox" name="skills" value="advertising"><span>الإعلان</span></label><label class="af-chip"><input type="checkbox" name="skills" value="social-media"><span>السوشيال ميديا</span></label><label class="af-chip"><input type="checkbox" name="skills" value="web-development"><span>تطوير المواقع</span></label><label class="af-chip"><input type="checkbox" name="skills" value="seo-geo-aeo"><span>تحسين الظهور</span></label><label class="af-chip"><input type="checkbox" name="skills" value="music"><span>الموسيقى</span></label><label class="af-chip"><input type="checkbox" name="skills" value="merchandise"><span>المنتجات الترويجية</span></label><label class="af-chip"><input type="checkbox" name="skills" value="gaming"><span>الألعاب</span></label><label class="af-chip"><input type="checkbox" name="skills" value="copywriting"><span>كتابة المحتوى</span></label><label class="af-chip"><input type="checkbox" name="skills" value="strategy"><span>الاستراتيجية</span></label></div></div></div></fieldset><fieldset class="af-group"><legend class="af-group__t">العمل</legend><div class="af-grid"><div class="field"><label for="af-portfolio">رابط أعمالك</label><input id="af-portfolio" name="portfolio" type="url" required maxlength="2048" autocomplete="url" inputmode="url" dir="ltr" placeholder="https://behance.net/yourname"></div><div class="field"><label for="af-linkedin">لينكدإن<span class="af-opt">اختياري</span></label><input id="af-linkedin" name="linkedin" type="url" maxlength="2048" autocomplete="url" inputmode="url" dir="ltr" placeholder="https://linkedin.com/in/yourname"></div><div class="af-drop af-full" data-cv-drop data-state="empty" data-kb="كيلوبايت" data-mb="ميجابايت"><input id="af-cv" class="af-drop__input" name="cv" type="file" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" aria-describedby="af-cv-hint"><span class="af-drop__ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5M4 20h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="af-drop__txt"><label for="af-cv" class="af-drop__t"><span class="af-drop__default">اسحب سيرتك الذاتية هنا، أو اضغط للاختيار</span><span class="af-drop__name" data-cv-name dir="auto"></span></label><span class="af-drop__s"><span id="af-cv-hint" class="af-drop__hint" data-cv-hint>PDF أو Word ‏(.docx)، حتى ١٠ ميجابايت</span><span id="af-cv-size" class="af-drop__size" data-cv-size></span><span id="af-cv-bad" class="af-drop__bad" data-cv-bad>هذا الملف ما ينفع. استخدم ملف PDF أو Word ‏(.docx) أقل من ١٠ ميجابايت.</span></span></span><button type="button" class="af-drop__x" data-cv-remove>إزالة</button></div><div class="field af-full"><label for="af-message">العمل اللي تفتخر فيه أكثر، وليش</label><textarea id="af-message" name="message" required maxlength="4000" placeholder="حط رابطه أو وصفه. قل لنا وش كان دورك فيه ووش بتسوي بشكل مختلف الحين."></textarea></div></div></fieldset><div class="af-consents"><div class="field af-consent"><input id="af-consent-application" name="consent_application" type="checkbox" value="yes" required><label for="af-consent-application">أوافق على أن تحفظ بريّن ستيشن هذا الطلب وتراجعه، بما في ذلك سيرتي الذاتية، للنظر في ترشيحي لهذه الوظيفة.</label></div><div class="field af-consent"><input id="af-consent-future" name="consent_future" type="checkbox" value="yes"><label for="af-consent-future">احتفظوا بطلبي أيضاً وتواصلوا معي بخصوص وظائف مستقبلية.</label></div><p class="af-privacy"><a href="/ar/privacy#recruitment" target="_blank" rel="noopener">كيف نتعامل مع طلبات التوظيف<span class="sr-only"> (يفتح في علامة تبويب جديدة)</span></a></p></div><div class="hp-field" aria-hidden="true"><label for="af-hp">Leave this field empty</label><input id="af-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><input type="hidden" name="locale" value="ar"><input type="hidden" name="policy_version" value="2026-10-04"><div class="af-foot"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>أرسل الطلب</span></button><p class="af-note">ملاحظة مكتوبة.</p></div></form><script type="module" src="<root>/src/components/ApplicationForm.astro?astro&type=script&index=0&lang.ts"></script></div></section>"`;

exports[`every content field authored > joinApply (en) 1`] = `"<section class="join-apply" id="apply" aria-labelledby="join-apply-heading"><div class="section-wrap"><div class="tag tag--sky rv"><span class="dot"></span><span>Authored tag</span></div><div class="sec-head"><h2 class="rv" id="join-apply-heading">Authored <em>apply heading</em></h2><div class="join-apply__lead rv" id="apply-lead" data-closed="false"><p class="join-apply__p">Authored lead.</p><p class="join-apply__closed">We&#39;re not taking applications right now. Check back soon.</p></div></div><form id="apply-form" class="apply-form is-sent" method="post" action="/api/apply" enctype="multipart/form-data" novalidate data-locale="en" data-status-url="/api/apply/status" data-closed-target="apply-lead" data-err-required="This field is required." data-err-email="Enter a valid email address, like you@email.com." data-err-url="Enter a full link that starts with https://" data-err-too-long="This is longer than we can accept." data-err-invalid="Please check this field." data-err-consent="Tick this box so we can keep and review your application."><p id="apply-status" class="form-status af-status is-ok" role="status" aria-live="polite" tabindex="-1" data-sending="Sending…" data-ok="Authored success." data-invalid="Some answers are missing or need another look. Please check the form and try again." data-too-large="That file is too large. Your CV can be up to 10 MB." data-bad-type="That file won't work. Use a PDF or Word (.docx) file under 10 MB." data-rate-limited="Too many attempts. Please wait a little and try again." data-unavailable="We can't receive applications at the moment. Please try again later." data-closed="We're not taking applications right now. Check back soon." data-error="Something went wrong. Please try again.">Authored success.</p><fieldset class="af-group"><legend class="af-group__t">About</legend><div class="af-grid"><div class="field"><label for="af-name">Full name</label><input id="af-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="Your full name"></div><div class="field"><label for="af-email">Email</label><input id="af-email" name="email" type="email" required maxlength="254" autocomplete="email" dir="ltr" placeholder="you@email.com"></div><div class="field"><label for="af-phone">Phone</label><input id="af-phone" name="phone" type="tel" required minlength="6" maxlength="32" autocomplete="tel" inputmode="tel" dir="ltr" placeholder="+966 5X XXX XXXX"></div><div class="field"><label for="af-city">City</label><input id="af-city" name="city" type="text" required maxlength="80" autocomplete="address-level2" placeholder="Jeddah, Riyadh, anywhere"></div></div></fieldset><fieldset class="af-group"><legend class="af-group__t">Role</legend><div class="af-grid"><div class="field"><label for="af-role">Role you&#39;re interested in</label><input id="af-role" name="role" type="text" required maxlength="120" autocomplete="off" placeholder="Motion designer, copywriter, producer"></div><div class="field"><label for="af-experience">Experience</label><select id="af-experience" name="experience" required><option value="">Choose one</option><option value="student">Student or graduate</option><option value="1-3">1 to 3 years</option><option value="3-6">3 to 6 years</option><option value="6-plus">6+ years</option></select></div><div class="field"><label for="af-work-type">How you&#39;d like to work</label><select id="af-work-type" name="work_type" required><option value="">Choose one</option><option value="full-time">Full-time</option><option value="freelance">Freelance</option><option value="internship">Internship</option><option value="any">Open to any</option></select></div><div class="field"><label for="af-availability">When could you start?</label><select id="af-availability" name="availability" required><option value="">Choose one</option><option value="immediately">Immediately</option><option value="two-weeks">Within two weeks</option><option value="month">Within a month</option><option value="later">In more than a month</option></select></div><div class="af-chips af-full" role="group" aria-labelledby="af-skills-label"><p class="af-label" id="af-skills-label">Crafts you work in</p><div class="af-chips__row"><label class="af-chip"><input type="checkbox" name="skills" value="branding"><span>Branding</span></label><label class="af-chip"><input type="checkbox" name="skills" value="animation"><span>Animation</span></label><label class="af-chip"><input type="checkbox" name="skills" value="motion-graphics"><span>Motion Graphics</span></label><label class="af-chip"><input type="checkbox" name="skills" value="videography"><span>Videography</span></label><label class="af-chip"><input type="checkbox" name="skills" value="photography"><span>Photography</span></label><label class="af-chip"><input type="checkbox" name="skills" value="montage"><span>Montage</span></label><label class="af-chip"><input type="checkbox" name="skills" value="event-planning"><span>Event Planning</span></label><label class="af-chip"><input type="checkbox" name="skills" value="advertising"><span>Advertising</span></label><label class="af-chip"><input type="checkbox" name="skills" value="social-media"><span>Social Media</span></label><label class="af-chip"><input type="checkbox" name="skills" value="web-development"><span>Web Development</span></label><label class="af-chip"><input type="checkbox" name="skills" value="seo-geo-aeo"><span>SEO / GEO / AEO</span></label><label class="af-chip"><input type="checkbox" name="skills" value="music"><span>Music</span></label><label class="af-chip"><input type="checkbox" name="skills" value="merchandise"><span>Merchandise</span></label><label class="af-chip"><input type="checkbox" name="skills" value="gaming"><span>Gaming</span></label><label class="af-chip"><input type="checkbox" name="skills" value="copywriting"><span>Copywriting</span></label><label class="af-chip"><input type="checkbox" name="skills" value="strategy"><span>Strategy</span></label></div></div></div></fieldset><fieldset class="af-group"><legend class="af-group__t">Work</legend><div class="af-grid"><div class="field"><label for="af-portfolio">Portfolio link</label><input id="af-portfolio" name="portfolio" type="url" required maxlength="2048" autocomplete="url" inputmode="url" dir="ltr" placeholder="https://behance.net/yourname"></div><div class="field"><label for="af-linkedin">LinkedIn<span class="af-opt">optional</span></label><input id="af-linkedin" name="linkedin" type="url" maxlength="2048" autocomplete="url" inputmode="url" dir="ltr" placeholder="https://linkedin.com/in/yourname"></div><div class="af-drop af-full" data-cv-drop data-state="empty" data-kb="KB" data-mb="MB"><input id="af-cv" class="af-drop__input" name="cv" type="file" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" aria-describedby="af-cv-hint"><span class="af-drop__ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5M4 20h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="af-drop__txt"><label for="af-cv" class="af-drop__t"><span class="af-drop__default">Drop your CV here, or click to browse</span><span class="af-drop__name" data-cv-name dir="auto"></span></label><span class="af-drop__s"><span id="af-cv-hint" class="af-drop__hint" data-cv-hint>PDF or Word (.docx), up to 10 MB</span><span id="af-cv-size" class="af-drop__size" data-cv-size></span><span id="af-cv-bad" class="af-drop__bad" data-cv-bad>That file won&#39;t work. Use a PDF or Word (.docx) file under 10 MB.</span></span></span><button type="button" class="af-drop__x" data-cv-remove>Remove</button></div><div class="field af-full"><label for="af-message">The piece you&#39;re proudest of, and why</label><textarea id="af-message" name="message" required maxlength="4000" placeholder="Link it or