exports[`pages, as their routes compose them > home (en) 1`] = `"<div class="intro" aria-hidden="true"><picture><source srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=260&amp;h=133&amp;f=avif 260w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=520&amp;h=266&amp;f=avif 520w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=780&amp;h=399&amp;f=avif 780w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=1040&amp;h=532&amp;f=avif 1040w" type="image/avif" sizes="min(46vw, 520px)"><source srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=260&amp;h=133&amp;f=webp 260w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=520&amp;h=266&amp;f=webp 520w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=780&amp;h=399&amp;f=webp 780w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=1040&amp;h=532&amp;f=webp 1040w" type="image/webp" sizes="min(46vw, 520px)"><img src="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=520&amp;h=266&amp;f=png" srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=260&amp;h=133&amp;f=png 260w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=520&amp;h=266&amp;f=png 520w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=780&amp;h=399&amp;f=png 780w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fbraiin-logo-white.png%3ForigWidth%3D2943%26origHeight%3D1503%26origFormat%3Dpng&amp;w=1040&amp;h=532&amp;f=png 1040w" data-image-component="true" alt sizes="min(46vw, 520px)" decoding="async" loading="eager" fetchpriority="high" width="520" height="266"></picture></div><section class="hero"><div class="hero__media" data-video-src="/media/showreel.mp4"></div><div class="hero__inner"><h1 aria-label="Creative work that performs*"><span class="word" aria-hidden="true"><span class="letter">C</span><span class="letter">r</span><span class="letter">e</span><span class="letter">a</span><span class="letter">t</span><span class="letter">i</span><span class="letter">v</span><span class="letter">e</span></span> <span class="word" aria-hidden="true"><span class="letter">w</span><span class="letter">o</span><span class="letter">r</span><span class="letter">k</span></span> <span class="word" aria-hidden="true"><span class="letter">t</span><span class="letter">h</span><span class="letter">a</span><span class="letter">t</span></span> <span class="word accent" aria-hidden="true"><span class="letter">p</span><span class="letter">e</span><span class="letter">r</span><span class="letter">f</span><span class="letter">o</span><span class="letter">r</span><span class="letter">m</span><span class="letter">s</span></span><span class="word word--mark" aria-hidden="true"><span class="letter letter--plain">*</span></span></h1><div class="hero__side"><p class="hero__sub">From the brain to the real world.</p><a class="cta hero__cta" href="#selected-work"><span>See our work</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="hero__scroll" aria-hidden="true"><i></i><span>Scroll</span></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script><section class="clients" aria-label="Selected clients" id="clients"><div class="tag tag--sky rv"><span class="dot"></span><span>Selected clients</span></div><div class="clients__head"><h2 class="rv">Trusted by the minds behind the region&#39;s biggest moments.</h2><span class="rv">Since 2019</span></div><div class="marquee"><ul class="marquee-track"><li class="marquee-item">Acme</li><li class="marquee-item">Globex</li><li class="marquee-item" aria-hidden="true">Acme</li><li class="marquee-item" aria-hidden="true">Globex</li></ul></div><div class="marquee marquee--rev" aria-hidden="true"><ul class="marquee-track"><li class="marquee-item" aria-hidden="true">Globex</li><li class="marquee-item" aria-hidden="true">Acme</li><li class="marquee-item" aria-hidden="true">Globex</li><li class="marquee-item" aria-hidden="true">Acme</li></ul></div></section><section class="sel-work" id="selected-work" aria-labelledby="sel-work-heading"><p class="tag rv"><span class="dot"></span>Selected work</p><div class="sel-work__top"><div class="mf mf--feature sel-work__media rv"><picture><source srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=480&amp;h=270&amp;f=avif 480w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=800&amp;h=450&amp;f=avif 800w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1200&amp;h=675&amp;f=avif 1200w" type="image/avif" sizes="(min-width: 53.75rem) 52vw, 100vw"><source srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=480&amp;h=270&amp;f=webp 480w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=800&amp;h=450&amp;f=webp 800w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1200&amp;h=675&amp;f=webp 1200w" type="image/webp" sizes="(min-width: 53.75rem) 52vw, 100vw"><img src="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1600&amp;h=900&amp;f=jpg" srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=480&amp;h=270&amp;f=jpg 480w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=800&amp;h=450&amp;f=jpg 800w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1200&amp;h=675&amp;f=jpg 1200w" data-image-component="true" alt sizes="(min-width: 53.75rem) 52vw, 100vw" loading="lazy" decoding="async" fetchpriority="auto" width="1600" height="900"></picture></div><script type="module" src="<root>/src/components/media/MediaFrame.astro?astro&type=script&index=0&lang.ts"></script><div class="sel-work__copy rv"><p class="sel-work__blurb"><b>The Rider</b><span>A launch film.</span></p><div class="facets facets--light"><div class="facets__f"><span class="facets__k">Service</span><div class="facets__tags"><a class="ftag" href="/portfolio/all?service=animation" data-f="service" data-v="animation">Animation</a></div></div><div class="facets__f"><span class="facets__k">Sector</span><div class="facets__tags"><a class="ftag" href="/portfolio/all?sector=retail" data-f="sector" data-v="retail">Retail</a></div></div><div class="facets__f"><span class="facets__k">Client</span><div class="facets__tags"><a class="ftag" href="/portfolio/all?client=acme" data-f="client" data-v="acme">Acme</a></div></div><div class="facets__f"><span class="facets__k">Year</span><div class="facets__tags"><a class="ftag" href="/portfolio/all?year=2025" data-f="year" data-v="2025">2025</a></div></div></div><a class="sel-work__link" href="/portfolio/the-rider" data-track="project_card">See the project<span class="sr-only">: The Rider</span></a></div></div><div class="sel-work__state"><h2 class="rv" id="sel-work-heading">Ideas that <em>leave the brain</em> and land in the world.</h2><ol class="sel-work__lines rv"><li><span aria-hidden="true">01</span><span>Made to be remembered, not just seen.</span></li><li><span aria-hidden="true">02</span><span>Built to perform on every screen and stage.</span></li><li><span aria-hidden="true">03</span><span>Delivered by one team, start to finish.</span></li></ol></div><div class="sel-work__grid"><article class="pcard pcard--home rv"><a class="pcard__link" href="/portfolio/quiet-mark" data-clip-trigger data-track="project_card"><div class="mf mf--card"></div><span class="pcard__t">Quiet Mark</span></a><div class="facets facets--light"><div class="facets__f"><span class="facets__k">Client</span><div class="facets__tags"><span class="ftag ftag--note">Confidential client</span></div></div><div class="facets__f"><span class="facets__k">Year</span><div class="facets__tags"><a class="ftag" href="/portfolio/all?year=2024" data-f="year" data-v="2024">2024</a></div></div></div></article><article class="pcard pcard--home rv"><a class="pcard__link" href="/portfolio/third-light" data-clip-trigger data-track="project_card"><div class="mf mf--card"></div><span class="pcard__t">Third Light | Identity</span></a><div class="facets facets--light"><div class="facets__f"><span class="facets__k">Sector</span><div class="facets__tags"><a class="ftag" href="/portfolio/all?sector=food" data-f="sector" data-v="food">Food</a></div></div><div class="facets__f"><span class="facets__k">Year</span><div class="facets__tags"><a class="ftag" href="/portfolio/all?year=2023" data-f="year" data-v="2023">2023</a></div></div></div></article></div><div class="sel-work__foot rv"><a href="/portfolio" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>See all our work</span></a></div></section><section id="numbers" aria-labelledby="numbers-heading" class="sb sb--band"><div class="sb__wrap"><div class="sb__head"><div><p class="tag rv"><span class="dot"></span>In numbers</p><h2 class="rv" id="numbers-heading">The work, <em>counted</em></h2></div><p class="rv">Every number here is a brief someone trusted us with, and a result they could measure.</p></div><ul class="sb__grid"><li class="sb__cell rv"><span class="sb__n"><span class="sr-only">250+</span><span aria-hidden="true"><span data-count-to="250">250</span><i>+</i></span></span><span class="sb__l">Projects delivered</span></li><li class="sb__cell rv"><span class="sb__n"><span class="sr-only">80</span><span aria-hidden="true"><span data-count-to="80">80</span></span></span><span class="sb__l">Clients</span></li><li class="sb__cell rv"><span class="sb__n sb__n--text">TBD</span><span class="sb__l">Years</span></li></ul></div></section><script type="module" src="<root>/src/components/sections/StatBand.astro?astro&type=script&index=0&lang.ts"></script><section id="testimonials" aria-roledescription="carousel" aria-labelledby="testimonials-heading" data-carousel class="tm tm--klein klein-band"><div class="tm__grid"><div class="tm__side"><p class="tag rv"><span class="dot"></span>Testimonials</p><h2 class="rv" id="testimonials-heading">In their <em>words</em></h2><div class="tm__nav rv" data-controls hidden><button class="tm__btn" type="button" data-prev aria-label="Previous testimonial"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H2M7 3L2 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button class="tm__btn" type="button" data-next aria-label="Next testimonial"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button class="tm__btn tm__toggle" type="button" data-toggle data-label-pause="Pause the testimonials" data-label-play="Play the testimonials" aria-label="Pause the testimonials" hidden><svg class="tm__pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg><svg class="tm__play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l8 5-8 5z" fill="currentColor"></path></svg></button><span class="tm__count" data-counter aria-hidden="true"></span></div></div><div class="tm__main rv"><div class="tm__stage" data-stage aria-live="polite"><figure class="tm__q is-active" data-slide role="group" aria-roledescription="slide" aria-label="1 of 2"><svg class="tm__mark" viewBox="0 0 40 30" aria-hidden="true"><path fill="currentColor" d="M0 30V17.6C0 7.4 5.3 1.5 15.8 0l1.6 4.4C11.7 6 9 9.4 8.8 14.5H16V30H0Zm22.6 0V17.6C22.6 7.4 27.9 1.5 38.4 0L40 4.4c-5.7 1.6-8.4 5-8.6 10.1h7.2V30H22.6Z"></path></svg><blockquote class="tm__text"><p>They listened first.</p></blockquote><figcaption class="tm__who"><span class="tm__av" aria-hidden="true">SE</span><span><span class="tm__n">Sam Example</span><span class="tm__r">Head of Brand, Acme</span></span></figcaption></figure><figure class="tm__q" data-slide role="group" aria-roledescription="slide" aria-label="2 of 2"><svg class="tm__mark" viewBox="0 0 40 30" aria-hidden="true"><path fill="currentColor" d="M0 30V17.6C0 7.4 5.3 1.5 15.8 0l1.6 4.4C11.7 6 9 9.4 8.8 14.5H16V30H0Zm22.6 0V17.6C22.6 7.4 27.9 1.5 38.4 0L40 4.4c-5.7 1.6-8.4 5-8.6 10.1h7.2V30H22.6Z"></path></svg><blockquote class="tm__text"><p>On time, every time.</p></blockquote><figcaption class="tm__who"><span class="tm__av" aria-hidden="true">LS</span><span><span class="tm__n">Lee Sample</span></span></figcaption></figure></div><div class="tm__bar" aria-hidden="true"><i data-bar></i></div></div></div></section><script type="module" src="<root>/src/components/sections/Testimonials.astro?astro&type=script&index=0&lang.ts"></script><section class="disc disc--home" id="services" aria-labelledby="services-heading" data-disc-mode="home"><div class="disc__wrap"><div class="disc__head"><div><div class="tag rv"><span class="dot"></span><span>What we do</span></div><h2 class="rv" id="services-heading">Five disciplines, <em>one studio</em></h2></div><p class="rv">Take one. Take all of them. The work holds together either way, because it never leaves the building.</p></div><div class="disc__stage"><a class="disc-card" href="/services#branding" data-disc="branding" data-clip-trigger data-track="discipline_card"><span class="disc-card__clip"><span class="disc-card__media disc-card__media--none"></span><span class="disc-card__ring" aria-hidden="true"></span><span class="disc-card__n" aria-hidden="true">01</span><span class="disc-card__go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="disc-card__bot"><span class="disc-card__s"><span class="disc-card__head"><span class="disc-card__t">Branding</span> <span class="disc-card__cnt">2 services</span></span> <span class="disc-card__line">The mark and the system.</span></span></span></span></a><a class="disc-card" href="/services#production" data-disc="production" data-clip-trigger data-track="discipline_card"><span class="disc-card__clip"><span class="disc-card__media disc-card__media--none"></span><span class="disc-card__ring" aria-hidden="true"></span><span class="disc-card__n" aria-hidden="true">02</span><span class="disc-card__go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="disc-card__bot"><span class="disc-card__s"><span class="disc-card__head"><span class="disc-card__t">Production</span> <span class="disc-card__cnt">1 service</span></span> <span class="disc-card__line">Film and sound.</span></span></span></span></a></div><div class="disc__foot"><p class="disc__hint"><i aria-hidden="true"></i><span>Open one to see every service inside it</span></p><a href="/services" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>All services</span></a></div></div></section><section class="about-intro" id="about"><div class="section-wrap"><div class="tag rv"><span class="dot"></span><span>Why Braiin Statiion</span></div><h2 class="rv">Born in Jeddah. Built to move ideas <b>from the brain into the real world</b>.</h2><p class="about-intro__lead rv">We build brands that are seen, understood, and remembered. On a screen, on a stage, on a shelf, in any language.</p><div class="about-intro__cols"><div class="rv"><h3>Strategy before pixels</h3><p>Every identity, film, and campaign starts with a question about the business, not a mood board. If the work isn&#39;t earning something, it isn&#39;t finished.</p></div><div class="rv"><h3>One studio, five disciplines</h3><p>Identity, film, sound, events, merch, and web all live under one roof, so the idea never gets diluted in the handoff between three vendors.</p></div><div class="rv"><h3>Native in any language</h3><p>Arabic, English, or whatever the market speaks. Every language is written, typeset, and designed natively, so none of them ends up reading like a translation of another.</p></div></div></div></section><section class="slogan"><div class="slogan__pin"><div class="slogan__media" data-video-src="/media/showreel.mp4"></div><div class="slogan__overlay"></div><div class="slogan__inner"><p><span class="sr-only">We don&#39;t make noise. We make things people remember.</span><span class="sw" aria-hidden="true">We</span><span class="sw" aria-hidden="true">don&#39;t</span><span class="sw" aria-hidden="true">make</span><span class="sw" aria-hidden="true">noise.</span><span class="sw ac" aria-hidden="true">We</span><span class="sw ac" aria-hidden="true">make</span><span class="sw ac" aria-hidden="true">things</span><span class="sw ac" aria-hidden="true">people</span><span class="sw ac" aria-hidden="true">remember.</span></p></div><div class="slogan__rule" aria-hidden="true"></div></div></section><script type="module" src="<root>/src/components/sections/SloganBand.astro?astro&type=script&index=0&lang.ts"></script><section class="home-contact" id="contact" aria-labelledby="home-contact-cta"><div class="section-wrap"><h2 class="display-cta rv" id="home-contact-cta">Let&#39;s make something <em>that lands</em></h2><form id="contact-form" class="contact-form contact-form--compact" data-locale="en" data-kind="contact" data-err-required="This field is required." data-err-email="Enter a valid email address, like name@company.com." data-err-too-long="This is longer than we can accept." data-err-invalid="Please check this field." novalidate><div class="field"><label for="cf-name">Name</label><input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="Your full name"></div><div class="field"><label for="cf-email">Email</label><input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@company.com"></div><div class="field"><label for="cf-company">Company</label><input id="cf-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="Optional"></div><div class="field"><label for="cf-service">What do you need?</label><select id="cf-service" name="service"><option value="" selected>Not sure yet, let&#39;s talk</option><optgroup label="01 Branding"><option value="discipline:branding">Branding, help me choose</option><option value="logo">Logo Design</option><option value="packaging">Packaging</option></optgroup><optgroup label="02 Production"><option value="discipline:production">Production, help me choose</option><option value="animation">Animation</option></optgroup></select></div><div class="field field-full"><label for="cf-message">Tell us about the project</label><textarea id="cf-message" name="message" required maxlength="5000" placeholder="What are you making, who is it for, and when does it need to be ready?"></textarea></div><div class="field field-full field-check"><input id="cf-consent" name="consent" type="checkbox"><label for="cf-consent">I agree to be contacted about my inquiry.</label></div><div class="hp-field" aria-hidden="true"><label for="cf-hp">Leave this field empty</label><input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><div class="contact-form__foot field-full"><button type="submit" class="cta cta--trail"><span>Send message</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><p class="contact-form__note">We read everything and reply within one business day.</p></div><p id="contact-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="Sending…" data-ok="Got it. We'll be in touch within one business day." data-invalid="Please correct the marked fields and try again." data-rate-limited="Too many attempts. Please wait a minute and try again." data-unavailable="The form isn’t live yet — please email hello@braiinstatiion.com." data-error="Something went wrong. Please try again."></p></form><script type="module" src="<root>/src/components/ContactForm.astro?astro&type=script&index=0&lang.ts"></script></div></section><section class="social-strip"><div class="social-strip__wrap section-wrap"><div class="tag rv"><span class="dot"></span><span>Follow the studio</span></div><h2 class="rv">New work goes up here first.</h2><ul class="social-links"><li><a class="sbox rv" href="https://instagram.com/braiinstatiion" target="_blank" rel="noopener"><span class="sbox__top"><svg class="sbox__ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c0 1.2-.2 1.8-.4 2.2a3.7 3.7 0 0 1-.9 1.4c-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2 0-1.8-.2-2.2-.4a3.7 3.7 0 0 1-1.4-.9 3.7 3.7 0 0 1-.9-1.4c-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c0-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.1 0-3.5 0-4.8.07-1.1.05-1.7.24-2.1.4-.5.2-.9.44-1.3.83-.4.4-.63.8-.83 1.3-.16.4-.35 1-.4 2.1C2.5 8.5 2.5 8.9 2.5 12s0 3.5.07 4.8c.05 1.1.24 1.7.4 2.1.2.5.44.9.83 1.3.4.4.8.63 1.3.83.4.16 1 .35 2.1.4 1.3.06 1.7.07 4.8.07s3.5 0 4.8-.07c1.1-.05 1.7-.24 2.1-.4.5-.2.9-.44 1.3-.83.4-.4.63-.8.83-1.3.16-.4.35-1 .4-2.1.06-1.3.07-1.7.07-4.8s0-3.5-.07-4.8c-.05-1.1-.24-1.7-.4-2.1a3.5 3.5 0 0 0-.83-1.3 3.5 3.5 0 0 0-1.3-.83c-.4-.16-1-.35-2.1-.4C15.5 4 15.1 4 12 4Zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 1.8a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2Zm5.1-2.1a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z"></path></svg><svg class="sbox__go" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span><span class="sbox__name">Instagram</span><span class="sbox__user" dir="ltr">@braiinstatiion</span></span></a></li><li><a class="sbox rv" href="https://linkedin.com/company/braiin-statiion" target="_blank" rel="noopener"><span class="sbox__top"><svg class="sbox__ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm6.5 0h3.8v1.6h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.3c0-1.27-.02-2.9-1.8-2.9-1.8 0-2.08 1.38-2.08 2.8V21h-4V9.5Z"></path></svg><svg class="sbox__go" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span><span class="sbox__name">LinkedIn</span><span class="sbox__user" dir="ltr">@braiin-statiion</span></span></a></li><li><a class="sbox rv" href="https://behance.net/braiinstatiion" target="_blank" rel="noopener"><span class="sbox__top"><svg class="sbox__ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.2 5.5c1.9 0 3.4.85 3.4 2.75 0 1.15-.6 1.9-1.6 2.3 1.4.4 2.1 1.4 2.1 2.8 0 2.3-1.9 3.15-4 3.15H2V5.5h6.2Zm-.4 4.4c.9 0 1.5-.4 1.5-1.25S8.7 7.4 7.75 7.4H4.9v2.5h2.9Zm.2 4.75c1 0 1.7-.45 1.7-1.45s-.65-1.4-1.7-1.4H4.9v2.85h3.1ZM19 9.35c2.3 0 3.7 1.6 3.7 4.05 0 .18-.02.4-.04.6h-5.6c.1 1.2.85 1.85 1.95 1.85.8 0 1.4-.35 1.65-.95h1.9c-.45 1.6-1.75 2.5-3.6 2.5-2.4 0-3.9-1.6-3.9-4 0-2.35 1.55-4.05 3.94-4.05Zm-1.9 3.3h3.6c-.1-1.05-.75-1.7-1.75-1.7-1.05 0-1.7.6-1.85 1.7ZM15.6 6.3h5.2v1.4h-5.2V6.3Z"></path></svg><svg class="sbox__go" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span><span class="sbox__name">Behance</span><span class="sbox__user" dir="ltr">@braiinstatiion</span></span></a></li><li><a class="sbox rv" href="https://youtube.com/@braiinstatiion" target="_blank" rel="noopener"><span class="sbox__top"><svg class="sbox__ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.75-1.77C18.3 5 12 5 12 5s-6.3 0-7.85.43A2.5 2.5 0 0 0 2.4 7.2C2 8.76 2 12 2 12s0 3.24.4 4.8a2.5 2.5 0 0 0 1.75 1.77C5.7 19 12 19 12 19s6.3 0 7.85-.43a2.5 2.5 0 0 0 1.75-1.77C22 15.24 22 12 22 12s0-3.24-.4-4.8ZM10 15.1V8.9l5.2 3.1-5.2 3.1Z"></path></svg><svg class="sbox__go" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span><span class="sbox__name">YouTube</span><span class="sbox__user" dir="ltr">@braiinstatiion</span></span></a></li></ul></div></section>"`;

exports[`pages, as their routes compose them > join (ar) 1`] = `"<section class="hero hero--banner"><div class="hero__media" data-video-src="/media/showreel.mp4" data-clip-start="17.4" data-clip-end="18.3"></div><div class="hero__inner"><h1 aria-label="انضم إلى المحطة"><span class="word" aria-hidden="true"><span class="letter">انضم</span></span> <span class="word" aria-hidden="true"><span class="letter">إلى</span></span> <span class="word accent" aria-hidden="true"><span class="letter">المحطة</span></span></h1><div class="hero__side"><p class="hero__sub">للناس اللي يقدرون يطلّعون الفكرة من راسهم ويخلّونها حقيقة.</p><a href="#apply" class="cta cta--badge cta--klein cta--down hero__cta"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>قدّم الآن</span></a></div></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script><section class="join-why" aria-labelledby="join-why-heading"><div class="section-wrap"><div class="tag rv"><span class="dot"></span><span>ليش بريّن ستيشن</span></div><div class="sec-head"><h2 class="rv" id="join-why-heading">شغل <em>يطلع للعالم</em></h2><p class="rv">خمسة تخصصات و٢٨ خدمة في نفس المكان. بتشتغل جنب ناس يسوون اللي ما تسويه، على بريفات تنتهي في الواقع.</p></div><div class="join-why__grid"><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">01</span><h3>خمسة تخصصات، غرفة واحدة</h3><p>مصممون وصنّاع أفلام وكتّاب ومطوّرون في نفس المكان. تتعلّم اللي يعرفه غيرك.</p></div><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">02</span><h3>بريفات حقيقية من البداية</h3><p>بدون شهور من المراقبة. تشتغل على مشاريع تطلع فعلاً، مع ناس طلّعوا كثير.</p></div><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">03</span><h3>أصليّ بأي لغة</h3><p>العربية والإنجليزية وغيرها، كل لغة تُكتب وتُصمَّم بلغتها، مو كترجمة.</p></div><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">04</span><h3>مساحة للنمو</h3><p>ملاحظات من قادة في حرفتك، وطريق واضح للتطور تقدر تشوفه.</p></div></div></div></section><section class="join-steps" aria-labelledby="join-steps-heading"><div class="section-wrap"><div class="tag rv"><span class="dot"></span><span>كيف تمشي العملية</span></div><div class="sec-head"><h2 class="rv" id="join-steps-heading">من التقديم إلى <em>أول بريف</em></h2><p class="rv">أربع خطوات، وبتسمع منا في كل وحدة منها.</p></div><ol class="join-steps__list" role="list"><li class="join-step rv"><span class="join-step__n" aria-hidden="true">01</span><h3>قدّم</h3><p>أرسل أعمالك وبعض التفاصيل. خمس دقائق، بدون خطاب تقديم.</p><span class="join-step__time">اليوم الأول</span></li><li class="join-step rv"><span class="join-step__n" aria-hidden="true">02</span><h3>مراجعة الأعمال</h3><p>قائد من نفس حرفتك يراجع الشغل نفسه، مو بس السيرة الذاتية.</p><span class="join-step__time">خلال أسبوعين</span></li><li class="join-step rv"><span class="join-step__n" aria-hidden="true">03</span><h3>محادثة</h3><p>مكالمة مع الناس اللي بتشتغل معهم. وجهّز أسئلتك أنت بعد.</p><span class="join-step__time">حوالي ٤٥ دقيقة</span></li><li class="join-step rv"><span class="join-step__n" aria-hidden="true">04</span><h3>بريف قصير</h3><p>مهمة صغيرة واقعية عشان الطرفين يشوفون كيف يكون الشغل مع بعض.</p><span class="join-step__time">أيام قليلة</span></li></ol></div></section><section class="join-apply" id="apply" aria-labelledby="join-apply-heading"><div class="section-wrap"><div class="tag tag--sky rv"><span class="dot"></span><span>التقديم</span></div><div class="sec-head"><h2 class="rv" id="join-apply-heading">ورّنا وش <em>تصنع</em></h2><div class="join-apply__lead rv" id="apply-lead" data-closed="false"><p class="join-apply__p">أعمالك تقول لنا أكثر من السيرة الذاتية. أرسل الاثنين إذا عندك.</p><p class="join-apply__closed">لا نستقبل طلبات التوظيف حاليًا. عُد إلينا قريبًا.</p></div></div><form id="apply-form" class="apply-form" method="post" action="/api/apply" enctype="multipart/form-data" novalidate data-locale="ar" data-status-url="/api/apply/status" data-closed-target="apply-lead" data-err-required="هذا الحقل مطلوب." data-err-email="أدخل بريدًا إلكترونيًا صحيحًا، مثل you@email.com." data-err-url="أدخل رابطًا كاملًا يبدأ بـ https://" data-err-too-long="النص أطول من الحد المسموح." data-err-invalid="يرجى مراجعة هذا الحقل." data-err-consent="يرجى تحديد هذا المربع لنحتفظ بطلبك ونراجعه."><fieldset class="af-group"><legend class="af-group__t">عنك</legend><div class="af-grid"><div class="field"><label for="af-name">الاسم الكامل</label><input id="af-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="اسمك الكامل"></div><div class="field"><label for="af-email">البريد الإلكتروني</label><input id="af-email" name="email" type="email" required maxlength="254" autocomplete="email" dir="ltr" placeholder="you@email.com"></div><div class="field"><label for="af-phone">الجوال</label><input id="af-phone" name="phone" type="tel" required minlength="6" maxlength="32" autocomplete="tel" inputmode="tel" dir="ltr" placeholder="+966 5X XXX XXXX"></div><div class="field"><label for="af-city">المدينة</label><input id="af-city" name="city" type="text" required maxlength="80" autocomplete="address-level2" placeholder="جدة، الرياض، أي مكان"></div></div></fieldset><fieldset class="af-group"><legend class="af-group__t">الوظيفة</legend><div class="af-grid"><div class="field"><label for="af-role">الوظيفة اللي تهمّك</label><input id="af-role" name="role" type="text" required maxlength="120" autocomplete="off" placeholder="مصمم موشن، كاتب محتوى، منتج"></div><div class="field"><label for="af-experience">الخبرة</label><select id="af-experience" name="experience" required><option value="">اختر واحداً</option><option value="student">طالب أو خريج</option><option value="1-3">من سنة إلى ٣ سنوات</option><option value="3-6">من ٣ إلى ٦ سنوات</option><option value="6-plus">أكثر من ٦ سنوات</option></select></div><div class="field"><label for="af-work-type">كيف تحب تشتغل</label><select id="af-work-type" name="work_type" required><option value="">اختر واحداً</option><option value="full-time">دوام كامل</option><option value="freelance">عمل حر</option><option value="internship">تدريب</option><option value="any">أي شكل</option></select></div><div class="field"><label for="af-availability">متى تقدر تبدأ؟</label><select id="af-availability" name="availability" required><option value="">اختر واحداً</option><option value="immediately">فوراً</option><option value="two-weeks">خلال أسبوعين</option><option value="month">خلال شهر</option><option value="later">بعد أكثر من شهر</option></select></div><div class="af-chips af-full" role="group" aria-labelledby="af-skills-label"><p class="af-label" id="af-skills-label">الحِرف اللي تشتغل فيها</p><div class="af-chips__row"><label class="af-chip"><input type="checkbox" name="skills" value="branding"><span>الهوية البصرية</span></label><label class="af-chip"><input type="checkbox" name="skills" value="animation"><span>الرسوم المتحركة</span></label><label class="af-chip"><input type="checkbox" name="skills" value="motion-graphics"><span>الموشن جرافيك</span></label><label class="af-chip"><input type="checkbox" name="skills" value="videography"><span>الإنتاج المرئي</span></label><label class="af-chip"><input type="checkbox" name="skills" value="photography"><span>التصوير الفوتوغرافي</span></label><label class="af-chip"><input type="checkbox" name="skills" value="montage"><span>المونتاج</span></label><label class="af-chip"><input type="checkbox" name="skills" value="event-planning"><span>تنظيم الفعاليات</span></label><label class="af-chip"><input type="checkbox" name="skills" value="advertising"><span>الإعلان</span></label><label class="af-chip"><input type="checkbox" name="skills" value="social-media"><span>السوشيال ميديا</span></label><label class="af-chip"><input type="checkbox" name="skills" value="web-development"><span>تطوير المواقع</span></label><label class="af-chip"><input type="checkbox" name="skills" value="seo-geo-aeo"><span>تحسين الظهور</span></label><label class="af-chip"><input type="checkbox" name="skills" value="music"><span>الموسيقى</span></label><label class="af-chip"><input type="checkbox" name="skills" value="merchandise"><span>المنتجات الترويجية</span></label><label class="af-chip"><input type="checkbox" name="skills" value="gaming"><span>الألعاب</span></label><label class="af-chip"><input type="checkbox" name="skills" value="copywriting"><span>كتابة المحتوى</span></label><label class="af-chip"><input type="checkbox" name="skills" value="strategy"><span>الاستراتيجية</span></label></div></div></div></fieldset><fieldset class="af-group"><legend class="af-group__t">أعمالك</legend><div class="af-grid"><div class="field"><label for="af-portfolio">رابط أعمالك</label><input id="af-portfolio" name="portfolio" type="url" required maxlength="2048" autocomplete="url" inputmode="url" dir="ltr" placeholder="https://behance.net/yourname"></div><div class="field"><label for="af-linkedin">لينكدإن<span class="af-opt">اختياري</span></label><input id="af-linkedin" name="linkedin" type="url" maxlength="2048" autocomplete="url" inputmode="url" dir="ltr" placeholder="https://linkedin.com/in/yourname"></div><div class="af-drop af-full" data-cv-drop data-state="empty" data-kb="كيلوبايت" data-mb="ميجابايت"><input id="af-cv" class="af-drop__input" name="cv" type="file" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" aria-describedby="af-cv-hint"><span class="af-drop__ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5M4 20h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="af-drop__txt"><label for="af-cv" class="af-drop__t"><span class="af-drop__default">اسحب سيرتك الذاتية هنا، أو اضغط للاختيار</span><span class="af-drop__name" data-cv-name dir="auto"></span></label><span class="af-drop__s"><span id="af-cv-hint" class="af-drop__hint" data-cv-hint>PDF أو Word ‏(.docx)، حتى ١٠ ميجابايت</span><span id="af-cv-size" class="af-drop__size" data-cv-size></span><span id="af-cv-bad" class="af-drop__bad" data-cv-bad>هذا الملف ما ينفع. استخدم ملف PDF أو Word ‏(.docx) أقل من ١٠ ميجابايت.</span></span></span><button type="button" class="af-drop__x" data-cv-remove>إزالة</button></div><div class="field af-full"><label for="af-message">العمل اللي تفتخر فيه أكثر، وليش</label><textarea id="af-message" name="message" required maxlength="4000" placeholder="حط رابطه أو وصفه. قل لنا وش كان دورك فيه ووش بتسوي بشكل مختلف الحين."></textarea></div></div></fieldset><div class="af-consents"><div class="field af-consent"><input id="af-consent-application" name="consent_application" type="checkbox" value="yes" required><label for="af-consent-application">أوافق على أن تحفظ بريّن ستيشن هذا الطلب وتراجعه، بما في ذلك سيرتي الذاتية، للنظر في ترشيحي لهذه الوظيفة.</label></div><div class="field af-consent"><input id="af-consent-future" name="consent_future" type="checkbox" value="yes"><label for="af-consent-future">احتفظوا بطلبي أيضاً وتواصلوا معي بخصوص وظائف مستقبلية.</label></div><p class="af-privacy"><a href="/ar/privacy#recruitment" target="_blank" rel="noopener">كيف نتعامل مع طلبات التوظيف<span class="sr-only"> (يفتح في علامة تبويب جديدة)</span></a></p></div><div class="hp-field" aria-hidden="true"><label for="af-hp">Leave this field empty</label><input id="af-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><input type="hidden" name="locale" value="ar"><input type="hidden" name="policy_version" value="2026-10-04"><div class="af-foot"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>أرسل الطلب</span></button><p class="af-note">نرد على كل طلب خلال أسبوعين، حتى لو كان الجواب: مو الحين.</p></div><p id="apply-status" class="form-status af-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="جارٍ الإرسال…" data-ok="وصلنا طلبك. بنراجع أعمالك ونرد عليك خلال أسبوعين." data-invalid="بعض الإجابات ناقصة أو تحتاج إلى مراجعة. يرجى مراجعة النموذج والمحاولة مرة أخرى." data-too-large="حجم الملف أكبر من المسموح. يمكن أن يصل حجم سيرتك الذاتية إلى ١٠ ميجابايت." data-bad-type="لا يمكن قبول هذا الملف. استخدم ملف PDF أو Word ‏(.docx) أقل من ١٠ ميجابايت." data-rate-limited="محاولات كثيرة. يرجى الانتظار قليلًا ثم المحاولة مرة أخرى." data-unavailable="لا يمكننا استقبال الطلبات في الوقت الحالي. يرجى المحاولة لاحقًا." data-closed="لا نستقبل طلبات التوظيف حاليًا. عُد إلينا قريبًا." data-error="حدث خطأ ما. حاول مرة أخرى."></p></form><script type="module" src="<root>/src/components/ApplicationForm.astro?astro&type=script&index=0&lang.ts"></script></div></section>"`;

exports[`pages, as their routes compose them > join (en) 1`] = `"<section class="hero hero--banner"><div class="hero__media" data-video-src="/media/showreel.mp4" data-clip-start="17.4" data-clip-end="18.3"></div><div class="hero__inner"><h1 aria-label="Join the station"><span class="word" aria-hidden="true"><span class="letter">J</span><span class="letter">o</span><span class="letter">i</span><span class="letter">n</span></span> <span class="word" aria-hidden="true"><span class="letter">t</span><span class="letter">h</span><span class="letter">e</span></span> <span class="word accent" aria-hidden="true"><span class="letter">s</span><span class="letter">t</span><span class="letter">a</span><span class="letter">t</span><span class="letter">i</span><span class="letter">o</span><span class="letter">n</span></span></h1><div class="hero__side"><p class="hero__sub">For people who can take an idea out of their head and make it real.</p><a href="#apply" class="cta cta--badge cta--klein cta--down hero__cta"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Apply now</span></a></div></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script><section class="join-why" aria-labelledby="join-why-heading"><div class="section-wrap"><div class="tag rv"><span class="dot"></span><span>Why Braiin Statiion</span></div><div class="sec-head"><h2 class="rv" id="join-why-heading">Work that <em>leaves the building</em></h2><p class="rv">Five disciplines and 28 services sit in the same room here. You&#39;ll work next to people who do what you don&#39;t, on briefs that end up in the real world.</p></div><div class="join-why__grid"><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">01</span><h3>Five disciplines, one room</h3><p>Designers, filmmakers, writers and developers on the same floor. You pick up what the others know.</p></div><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">02</span><h3>Real briefs, early</h3><p>No months of shadowing. You work on projects that actually ship, with people who&#39;ve shipped plenty.</p></div><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">03</span><h3>Native in any language</h3><p>Arabic, English and more, each one written and designed as itself, never as a translation.</p></div><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">04</span><h3>Room to grow</h3><p>Feedback from leads in your craft, and a path forward you can actually see.</p></div></div></div></section><section class="join-steps" aria-labelledby="join-steps-heading"><div class="section-wrap"><div class="tag rv"><span class="dot"></span><span>How it works</span></div><div class="sec-head"><h2 class="rv" id="join-steps-heading">From application to <em>first brief</em></h2><p class="rv">Four steps, and you&#39;ll hear from us at every one of them.</p></div><ol class="join-steps__list" role="list"><li class="join-step rv"><span class="join-step__n" aria-hidden="true">01</span><h3>Apply</h3><p>Send your portfolio and a few details. Five minutes, no cover letter.</p><span class="join-step__time">Day one</span></li><li class="join-step rv"><span class="join-step__n" aria-hidden="true">02</span><h3>Portfolio review</h3><p>A lead from your craft looks at the work itself, not just the CV.</p><span class="join-step__time">Within two weeks</span></li><li class="join-step rv"><span class="join-step__n" aria-hidden="true">03</span><h3>Conversation</h3><p>A call with the people you&#39;d work with. Bring your questions too.</p><span class="join-step__time">About 45 minutes</span></li><li class="join-step rv"><span class="join-step__n" aria-hidden="true">04</span><h3>A short brief</h3><p>A small, real-world task so both sides see how working together feels.</p><span class="join-step__time">A few days</span></li></ol></div></section><section class="join-apply" id="apply" aria-labelledby="join-apply-heading"><div class="section-wrap"><div class="tag tag--sky rv"><span class="dot"></span><span>Application</span></div><div class="sec-head"><h2 class="rv" id="join-apply-heading">Show us what you <em>make</em></h2><div class="join-apply__lead rv" id="apply-lead" data-closed="false"><p class="join-apply__p">A portfolio tells us more than a CV. Send both if you have them.</p><p class="join-apply__closed">We&#39;re not taking applications right now. Check back soon.</p></div></div><form id="apply-form" class="apply-form" method="post" action="/api/apply" enctype="multipart/form-data" novalidate data-locale="en" data-status-url="/api/apply/status" data-closed-target="apply-lead" data-err-required="This field is required." data-err-email="Enter a valid email address, like you@email.com." data-err-url="Enter a full link that starts with https://" data-err-too-long="This is longer than we can accept." data-err-invalid="Please check this field." data-err-consent="Tick this box so we can keep and review your application."><fieldset class="af-group"><legend class="af-group__t">About you</legend><div class="af-grid"><div class="field"><label for="af-name">Full name</label><input id="af-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="Your full name"></div><div class="field"><label for="af-email">Email</label><input id="af-email" name="email" type="email" required maxlength="254" autocomplete="email" dir="ltr" placeholder="you@email.com"></div><div class="field"><label for="af-phone">Phone</label><input id="af-phone" name="phone" type="tel" required minlength="6" maxlength="32" autocomplete="tel" inputmode="tel" dir="ltr" placeholder="+966 5X XXX XXXX"></div><div class="field"><label for="af-city">City</label><input id="af-city" name="city" type="text" required maxlength="80" autocomplete="address-level2" placeholder="Jeddah, Riyadh, anywhere"></div></div></fieldset><fieldset class="af-group"><legend class="af-group__t">The role</legend><div class="af-grid"><div class="field"><label for="af-role">Role you&#39;re interested in</label><input id="af-role" name="role" type="text" required maxlength="120" autocomplete="off" placeholder="Motion designer, copywriter, producer"></div><div class="field"><label for="af-experience">Experience</label><select id="af-experience" name="experience" required><option value="">Choose one</option><option value="student">Student or graduate</option><option value="1-3">1 to 3 years</option><option value="3-6">3 to 6 years</option><option value="6-plus">6+ years</option></select></div><div class="field"><label for="af-work-type">How you&#39;d like to work</label><select id="af-work-type" name="work_type" required><option value="">Choose one</option><option value="full-time">Full-time</option><option value="freelance">Freelance</option><option value="internship">Internship</option><option value="any">Open to any</option></select></div><div class="field"><label for="af-availability">When could you start?</label><select id="af-availability" name="availability" required><option value="">Choose one</option><option value="immediately">Immediately</option><option value="two-weeks">Within two weeks</option><option value="month">Within a month</option><option value="later">In more than a month</option></select></div><div class="af-chips af-full" role="group" aria-labelledby="af-skills-label"><p class="af-label" id="af-skills-label">Crafts you work in</p><div class="af-chips__row"><label class="af-chip"><input type="checkbox" name="skills" value="branding"><span>Branding</span></label><label class="af-chip"><input type="checkbox" name="skills" value="animation"><span>Animation</span></label><label class="af-chip"><input type="checkbox" name="skills" value="motion-graphics"><span>Motion Graphics</span></label><label class="af-chip"><input type="checkbox" name="skills" value="videography"><span>Videography</span></label><label class="af-chip"><input type="checkbox" name="skills" value="photography"><span>Photography</span></label><label class="af-chip"><input type="checkbox" name="skills" value="montage"><span>Montage</span></label><label class="af-chip"><input type="checkbox" name="skills" value="event-planning"><span>Event Planning</span></label><label class="af-chip"><input type="checkbox" name="skills" value="advertising"><span>Advertising</span></label><label class="af-chip"><input type="checkbox" name="skills" value="social-media"><span>Social Media</span></label><label class="af-chip"><input type="checkbox" name="skills" value="web-development"><span>Web Development</span></label><label class="af-chip"><input type="checkbox" name="skills" value="seo-geo-aeo"><span>SEO / GEO / AEO</span></label><label class="af-chip"><input type="checkbox" name="skills" value="music"><span>Music</span></label><label class="af-chip"><input type="checkbox" name="skills" value="merchandise"><span>Merchandise</span></label><label class="af-chip"><input type="checkbox" name="skills" value="gaming"><span>Gaming</span></label><label class="af-chip"><input type="checkbox" name="skills" value="copywriting"><span>Copywriting</span></label><label class="af-chip"><input type="checkbox" name="skills" value="strategy"><span>Strategy</span></label></div></div></div></fieldset><fieldset class="af-group"><legend class="af-group__t">Your work</legend><div class="af-grid"><div class="field"><label for="af-portfolio">Portfolio link</label><input id="af-portfolio" name="portfolio" type="url" required maxlength="2048" autocomplete="url" inputmode="url" dir="ltr" placeholder="https://behance.net/yourname"></div><div class="field"><label for="af-linkedin">LinkedIn<span class="af-opt">optional</span></label><input id="af-linkedin" name="linkedin" type="url" maxlength="2048" autocomplete="url" inputmode="url" dir="ltr" placeholder="https://linkedin.com/in/yourname"></div><div class="af-drop af-full" data-cv-drop data-state="empty" data-kb="KB" data-mb="MB"><input id="af-cv" class="af-drop__input" name="cv" type="file" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" aria-describedby="af-cv-hint"><span class="af-drop__ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5M4 20h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="af-drop__txt"><label for="af-cv" class="af-drop__t"><span class="af-drop__default">Drop your CV here, or click to browse</span><span class="af-drop__name" data-cv-name dir="auto"></span></label><span class="af-drop__s"><span id="af-cv-hint" class="af-drop__hint" data-cv-hint>PDF or Word (.docx), up to 10 MB</span><span id="af-cv-size" class="af-drop__size" data-cv-size></span><span id="af-cv-bad" class="af-drop__bad" data-cv-bad>That file won&#39;t work. Use a PDF or Word (.docx) file under 10 MB.</span></span></span><button type="button" class="af-drop__x" data-cv-remove>Remove</button></div><div class="field af-full"><label for="af-message">The piece you&#39;re proudest of, and why</label><textarea id="af-message" name="message" required maxlength="4000" placeholder="Link it or describe it. Tell us what you did on it and what you'd do differently now."></textarea></div></div></fieldset><div class="af-consents"><div class="field af-consent"><input id="af-consent-application" name="consent_application" type="checkbox" value="yes" required><label for="af-consent-application">I agree that Braiin Statiion can store and review this application, including my CV, to consider me for this role.</label></div><div class="field af-consent"><input id="af-consent-future" name="consent_future" type="checkbox" value="yes"><label for="af-consent-future">Also keep my application on file and contact me about future roles.</label></div><p class="af-privacy"><a href="/privacy#recruitment" target="_blank" rel="noopener">How we handle applications<span class="sr-only"> (opens in a new tab)</span></a></p></div><div class="hp-field" aria-hidden="true"><label for="af-hp">Leave this field empty</label><input id="af-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><input type="hidden" name="locale" value="en"><input type="hidden" name="policy_version" value="2026-10-04"><div class="af-foot"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Send application</span></button><p class="af-note">We reply to every application within two weeks, even when the answer is not yet.</p></div><p id="apply-status" class="form-status af-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="Sending…" data-ok="Application received. We'll review your work and reply within two weeks." data-invalid="Some answers are missing or need another look. Please check the form and try again." data-too-large="That file is too large. Your CV can be up to 10 MB." data-bad-type="That file won't work. Use a PDF or Word (.docx) file under 10 MB." data-rate-limited="Too many attempts. Please wait a little and try again." data-unavailable="We can't receive applications at the moment. Please try again later." data-closed="We're not taking applications right now. Check back soon." data-error="Something went wrong. Please try again."></p></form><script type="module" src="<root>/src/components/ApplicationForm.astro?astro&type=script&index=0&lang.ts"></script></div></section>"`;

exports[`pages, as their routes compose them > services (ar) 1`] = `"<section class="hero hero--banner"><div class="hero__media" data-video-src="/media/showreel.mp4" data-clip-start="13.4" data-clip-end="15.9"></div><div class="hero__inner"><h1 aria-label="أفكار، صارت حقيقة"><span class="word" aria-hidden="true"><span class="letter">أفكار،</span></span> <span class="word" aria-hidden="true"><span class="letter">صارت</span></span> <span class="word accent" aria-hidden="true"><span class="letter">حقيقة</span></span></h1><div class="hero__side"><p class="hero__sub">هوية، وإنتاج، وتسويق، ومواقع، وفعاليات. فريق واحد ياخذ فكرتك من أول رسمة إلى يوم إطلاقها.</p><a href="#categories" class="cta cta--badge cta--klein cta--down hero__cta"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>استكشف خدماتنا</span></a><a class="hero__alt" href="#inquiry">عارف وش تحتاج؟ <b>انتقل للطلب مباشرة</b></a></div></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script><section class="svc-proof"><div class="svc-proof__grid"><div class="svc-proof__lead rv"><p class="svc-proof__line">خمسة تخصصات. فريق واحد. <em>بدون تسليم لأحد.</em></p></div><ul class="svc-proof__stats rv"><li class="svc-proof__stat"><span class="svc-proof__n"><span class="sr-only">250+</span><span aria-hidden="true"><span data-count-to="250">250</span><i>+</i></span></span><span class="svc-proof__l">مشروع منجز</span></li><li class="svc-proof__stat"><span class="svc-proof__n"><span class="sr-only">80</span><span aria-hidden="true"><span data-count-to="80">80</span></span></span><span class="svc-proof__l">عميل</span></li><li class="svc-proof__stat"><span class="svc-proof__n svc-proof__n--text">TBD</span><span class="svc-proof__l">سنوات</span></li></ul></div></section><script type="module" src="<root>/src/components/sections/ServicesProof.astro?astro&type=script&index=0&lang.ts"></script><section class="disc disc--page" id="categories" aria-labelledby="categories-heading" data-disc-mode="page"><div class="disc__wrap"><div class="disc__head"><div><div class="tag rv"><span class="dot"></span><span>خدماتنا</span></div><h2 class="rv" id="categories-heading">كل اللي تحتاجه <em>علامتك</em></h2></div><p class="rv">خمسة تخصصات وثمان وعشرون خدمة. افتح أي تخصص وشوف كل اللي فيه.</p></div><div class="disc__stage"><a class="disc-card" href="#branding" data-disc="branding" data-clip-trigger data-track="discipline_card"><span class="disc-card__clip"><span class="disc-card__media disc-card__media--none"></span><span class="disc-card__ring" aria-hidden="true"></span><span class="disc-card__n" aria-hidden="true">01</span><span class="disc-card__go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="disc-card__bot"><span class="disc-card__s"><span class="disc-card__head"><span class="disc-card__t">الهوية البصرية</span> <span class="disc-card__cnt">2 خدمتان</span></span> <span class="disc-card__line">الشعار والنظام.</span></span></span></span></a><a class="disc-card" href="#production" data-disc="production" data-clip-trigger data-track="discipline_card"><span class="disc-card__clip"><span class="disc-card__media disc-card__media--none"></span><span class="disc-card__ring" aria-hidden="true"></span><span class="disc-card__n" aria-hidden="true">02</span><span class="disc-card__go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="disc-card__bot"><span class="disc-card__s"><span class="disc-card__head"><span class="disc-card__t">الإنتاج</span> <span class="disc-card__cnt">1 خدمة</span></span> <span class="disc-card__line">فيديو وصوت.</span></span></span></span></a></div><div class="disc__foot"><p class="disc__hint"><i aria-hidden="true"></i><span>اضغط على أي تخصص لفتحه</span></p></div></div></section><section class="svc-xp" aria-label="الخدمات حسب التخصص" data-xp><div class="svc-xp__pad"><div class="svc-xp__tabs" data-xp-tabs data-xp-label="التخصصات"><a class="svc-tab" id="svc-tab-branding" href="#branding" data-xp-tab="branding"><i>01</i> الهوية البصرية</a><a class="svc-tab" id="svc-tab-production" href="#production" data-xp-tab="production"><i>02</i> الإنتاج</a></div><div class="svc-panel" id="branding" data-xp-panel="branding"><div class="svc-xp__grid svc-xp__grid--solo"><div class="svc-xp__copy"><p class="svc-xp__k"><span class="dot"></span><span>01 / 02</span> <span>2 خدمتان</span></p><h2 class="svc-xp__h" id="svc-panel-branding-h">الهوية البصرية</h2><p class="svc-xp__p">هوية من البداية للنهاية.</p><ol class="svc-list" data-xp-list><li class="svc-row" data-xp-row data-xp-n="01" data-xp-name="تصميم الشعار"><a class="svc-row__a" href="/ar/services/logo"><span class="svc-row__n" aria-hidden="true">01</span> <span class="svc-row__t">تصميم الشعار</span></a><a class="svc-row__q" href="/ar/services/logo#inquiry" aria-label="اطلب: تصميم الشعار"><span>اطلب</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li><li class="svc-row" data-xp-row data-xp-n="02" data-xp-name="التغليف"><a class="svc-row__a" href="/ar/services/packaging"><span class="svc-row__n" aria-hidden="true">02</span> <span class="svc-row__t">التغليف</span></a><a class="svc-row__q" href="/ar/services/packaging#inquiry" aria-label="اطلب: التغليف"><span>اطلب</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li></ol><div class="svc-xp__foot"><div class="svc-xp__nav"><a class="svc-xp__btn svc-xp__btn--prev" href="#production" data-xp-go="production"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H2M7 3L2 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><span class="sr-only">التخصص السابق: </span>الإنتاج</span></a><a class="svc-xp__btn svc-xp__btn--next" href="#production" data-xp-go="production"><span><span class="sr-only">التخصص التالي: </span>الإنتاج</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div><a href="#inquiry" data-preselect="discipline:branding" data-track="start_project" class="cta cta--badge cta--klein cta--go svc-xp__start"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>ابدأ مشروع الهوية البصرية</span></a></div></div></div></div><div class="svc-panel" id="production" data-xp-panel="production"><div class="svc-xp__grid svc-xp__grid--solo"><div class="svc-xp__copy"><p class="svc-xp__k"><span class="dot"></span><span>02 / 02</span> <span>1 خدمة</span></p><h2 class="svc-xp__h" id="svc-panel-production-h">الإنتاج</h2><ol class="svc-list" data-xp-list><li class="svc-row" data-xp-row data-xp-n="01" data-xp-name="الرسوم المتحركة"><a class="svc-row__a" href="/ar/services/animation"><span class="svc-row__n" aria-hidden="true">01</span> <span class="svc-row__t">الرسوم المتحركة</span></a><a class="svc-row__q" href="/ar/services/animation#inquiry" aria-label="اطلب: الرسوم المتحركة"><span>اطلب</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li></ol><div class="svc-xp__foot"><div class="svc-xp__nav"><a class="svc-xp__btn svc-xp__btn--prev" href="#branding" data-xp-go="branding"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H2M7 3L2 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><span class="sr-only">التخصص السابق: </span>الهوية البصرية</span></a><a class="svc-xp__btn svc-xp__btn--next" href="#branding" data-xp-go="branding"><span><span class="sr-only">التخصص التالي: </span>الهوية البصرية</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div><a href="#inquiry" data-preselect="discipline:production" data-track="start_project" class="cta cta--badge cta--klein cta--go svc-xp__start"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>ابدأ مشروع الإنتاج</span></a></div></div></div></div></div></section><script type="module" src="<root>/src/components/sections/ServiceExplorer.astro?astro&type=script&index=0&lang.ts"></script><section class="hello" id="inquiry" aria-labelledby="hello-heading"><div class="hello__wrap"><div class="hello__grid"><div class="hello__side"><div class="tag tag--sky rv"><span class="dot"></span><span>طلب مشروع</span></div><h2 class="hello__h rv" id="hello-heading">قل <em>هلا</em></h2><p class="hello__p rv">فكرة كبيرة أو تعديل بسيط، قل لنا وين تبي توصل. كل ما شاركتنا أكثر، صار ردنا الأول أنفع.</p><div class="hello__rule rv" aria-hidden="true"></div><ul class="hello__pts rv"><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>رد خلال يوم عمل واحد</span></li><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>سعر ثابت بعد الاتفاق على النطاق</span></li><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>فريق واحد من أول رسمة إلى الإطلاق</span></li></ul></div><form id="contact-form" class="contact-form contact-form--full contact-form--hello" data-locale="ar" data-kind="project_inquiry" data-err-required="هذا الحقل مطلوب." data-err-email="أدخل بريدًا إلكترونيًا صحيحًا، مثل name@company.com." data-err-too-long="النص أطول من الحد المسموح." data-err-invalid="يرجى مراجعة هذا الحقل." novalidate><div class="field"><label for="cf-name">الاسم</label><input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="اسمك الكامل"></div><div class="field"><label for="cf-email">البريد الإلكتروني</label><input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@company.com"></div><div class="field"><label for="cf-company">الشركة</label><input id="cf-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="اختياري"></div><div class="field"><label for="cf-phone">الجوال أو واتساب</label><input id="cf-phone" name="phone" type="tel" dir="ltr" maxlength="32" autocomplete="tel" inputmode="tel" placeholder="+966 5X XXX XXXX"></div><div class="field"><label for="cf-service">وش تحتاج؟</label><select id="cf-service" name="service"><option value="" selected>لسه ما قررت، خلّنا نتكلم</option><optgroup label="01 الهوية البصرية"><option value="discipline:branding">الهوية البصرية، ساعدوني أختار</option><option value="logo">تصميم الشعار</option><option value="packaging">التغليف</option></optgroup><optgroup label="02 الإنتاج"><option value="discipline:production">الإنتاج، ساعدوني أختار</option><option value="animation">الرسوم المتحركة</option></optgroup></select></div><div class="field"><label for="cf-budget">نطاق الميزانية</label><select id="cf-budget" name="budget"><option value="">أفضّل نتناقش فيها</option><option value="lt_25k">أقل من ٢٥ ألف ريال</option><option value="25k_75k">٢٥ إلى ٧٥ ألف ريال</option><option value="75k_200k">٧٥ إلى ٢٠٠ ألف ريال</option><option value="gt_200k">٢٠٠ ألف ريال فأكثر</option><option value="not_sure">لسه ما حددنا</option></select></div><div class="field field-full"><label for="cf-message">احكِ لنا عن المشروع</label><textarea id="cf-message" name="message" required maxlength="5000" placeholder="وش تصنع، ولمين، ومتى لازم يكون جاهز؟"></textarea></div><div class="field field-full field-check"><input id="cf-consent" name="consent" type="checkbox"><label for="cf-consent">أوافق على التواصل معي بخصوص طلبي.</label></div><div class="hp-field" aria-hidden="true"><label for="cf-hp">Leave this field empty</label><input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><div class="contact-form__foot field-full"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>أرسل رسالتك</span></button><p class="contact-form__note">نقرأ كل رسالة ونرد خلال يوم عمل واحد.</p></div><p id="contact-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="جارٍ الإرسال…" data-ok="وصلتنا. بنتواصل معك خلال يوم عمل واحد." data-invalid="يرجى تصحيح الحقول المشار إليها والمحاولة مرة أخرى." data-rate-limited="محاولات كثيرة. يرجى الانتظار دقيقة ثم المحاولة مرة أخرى." data-unavailable="النموذج غير مُفعّل بعد — راسلنا على hello@braiinstatiion.com." data-error="حدث خطأ ما. حاول مرة أخرى."></p></form><script type="module" src="<root>/src/components/ContactForm.astro?astro&type=script&index=0&lang.ts"></script></div></div></section>"`;

exports[`pages, as their routes compose them > services (en) 1`] = `"<section class="hero hero--banner"><div class="hero__media" data-video-src="/media/showreel.mp4" data-clip-start="13.4" data-clip-end="15.9"></div><div class="hero__inner"><h1 aria-label="Ideas, made real"><span class="word" aria-hidden="true"><span class="letter">I</span><span class="letter">d</span><span class="letter">e</span><span class="letter">a</span><span class="letter">s</span><span class="letter">,</span></span> <span class="word" aria-hidden="true"><span class="letter">m</span><span class="letter">a</span><span class="letter">d</span><span class="letter">e</span></span> <span class="word accent" aria-hidden="true"><span class="letter">r</span><span class="letter">e</span><span class="letter">a</span><span class="letter">l</span></span></h1><div class="hero__side"><p class="hero__sub">Branding, production, marketing, websites, and events. One team takes your idea from the first sketch to the day it goes live.</p><a href="#categories" class="cta cta--badge cta--klein cta--down hero__cta"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Explore our services</span></a><a class="hero__alt" href="#inquiry">Know what you need? <b>Skip to the inquiry</b></a></div></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script><section class="svc-proof"><div class="svc-proof__grid"><div class="svc-proof__lead rv"><p class="svc-proof__line">Five disciplines. One team. <em>Zero handoffs.</em></p></div><ul class="svc-proof__stats rv"><li class="svc-proof__stat"><span class="svc-proof__n"><span class="sr-only">250+</span><span aria-hidden="true"><span data-count-to="250">250</span><i>+</i></span></span><span class="svc-proof__l">Projects delivered</span></li><li class="svc-proof__stat"><span class="svc-proof__n"><span class="sr-only">80</span><span aria-hidden="true"><span data-count-to="80">80</span></span></span><span class="svc-proof__l">Clients</span></li><li class="svc-proof__stat"><span class="svc-proof__n svc-proof__n--text">TBD</span><span class="svc-proof__l">Years</span></li></ul></div></section><script type="module" src="<root>/src/components/sections/ServicesProof.astro?astro&type=script&index=0&lang.ts"></script><section class="disc disc--page" id="categories" aria-labelledby="categories-heading" data-disc-mode="page"><div class="disc__wrap"><div class="disc__head"><div><div class="tag rv"><span class="dot"></span><span>Our services</span></div><h2 class="rv" id="categories-heading">Everything your brand <em>needs</em></h2></div><p class="rv">Five disciplines, twenty eight services. Open one to see everything inside it.</p></div><div class="disc__stage"><a class="disc-card" href="#branding" data-disc="branding" data-clip-trigger data-track="discipline_card"><span class="disc-card__clip"><span class="disc-card__media disc-card__media--none"></span><span class="disc-card__ring" aria-hidden="true"></span><span class="disc-card__n" aria-hidden="true">01</span><span class="disc-card__go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="disc-card__bot"><span class="disc-card__s"><span class="disc-card__head"><span class="disc-card__t">Branding</span> <span class="disc-card__cnt">2 services</span></span> <span class="disc-card__line">The mark and the system.</span></span></span></span></a><a class="disc-card" href="#production" data-disc="production" data-clip-trigger data-track="discipline_card"><span class="disc-card__clip"><span class="disc-card__media disc-card__media--none"></span><span class="disc-card__ring" aria-hidden="true"></span><span class="disc-card__n" aria-hidden="true">02</span><span class="disc-card__go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="disc-card__bot"><span class="disc-card__s"><span class="disc-card__head"><span class="disc-card__t">Production</span> <span class="disc-card__cnt">1 service</span></span> <span class="disc-card__line">Film and sound.</span></span></span></span></a></div><div class="disc__foot"><p class="disc__hint"><i aria-hidden="true"></i><span>Tap a discipline to open it</span></p></div></div></section><section class="svc-xp" aria-label="Services by discipline" data-xp><div class="svc-xp__pad"><div class="svc-xp__tabs" data-xp-tabs data-xp-label="Disciplines"><a class="svc-tab" id="svc-tab-branding" href="#branding" data-xp-tab="branding"><i>01</i> Branding</a><a class="svc-tab" id="svc-tab-production" href="#production" data-xp-tab="production"><i>02</i> Production</a></div><div class="svc-panel" id="branding" data-xp-panel="branding"><div class="svc-xp__grid svc-xp__grid--solo"><div class="svc-xp__copy"><p class="svc-xp__k"><span class="dot"></span><span>01 / 02</span> <span>2 services</span></p><h2 class="svc-xp__h" id="svc-panel-branding-h">Branding</h2><p class="svc-xp__p">Identity work, end to end.</p><ol class="svc-list" data-xp-list><li class="svc-row" data-xp-row data-xp-n="01" data-xp-name="Logo Design"><a class="svc-row__a" href="/services/logo"><span class="svc-row__n" aria-hidden="true">01</span> <span class="svc-row__t">Logo Design</span></a><a class="svc-row__q" href="/services/logo#inquiry" aria-label="Inquire: Logo Design"><span>Inquire</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li><li class="svc-row" data-xp-row data-xp-n="02" data-xp-name="Packaging"><a class="svc-row__a" href="/services/packaging"><span class="svc-row__n" aria-hidden="true">02</span> <span class="svc-row__t">Packaging</span></a><a class="svc-row__q" href="/services/packaging#inquiry" aria-label="Inquire: Packaging"><span>Inquire</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li></ol><div class="svc-xp__foot"><div class="svc-xp__nav"><a class="svc-xp__btn svc-xp__btn--prev" href="#production" data-xp-go="production"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H2M7 3L2 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><span class="sr-only">Previous discipline: </span>Production</span></a><a class="svc-xp__btn svc-xp__btn--next" href="#production" data-xp-go="production"><span><span class="sr-only">Next discipline: </span>Production</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div><a href="#inquiry" data-preselect="discipline:branding" data-track="start_project" class="cta cta--badge cta--klein cta--go svc-xp__start"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Start your Branding project</span></a></div></div></div></div><div class="svc-panel" id="production" data-xp-panel="production"><div class="svc-xp__grid svc-xp__grid--solo"><div class="svc-xp__copy"><p class="svc-xp__k"><span class="dot"></span><span>02 / 02</span> <span>1 service</span></p><h2 class="svc-xp__h" id="svc-panel-production-h">Production</h2><ol class="svc-list" data-xp-list><li class="svc-row" data-xp-row data-xp-n="01" data-xp-name="Animation"><a class="svc-row__a" href="/services/animation"><span class="svc-row__n" aria-hidden="true">01</span> <span class="svc-row__t">Animation</span></a><a class="svc-row__q" href="/services/animation#inquiry" aria-label="Inquire: Animation"><span>Inquire</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li></ol><div class="svc-xp__foot"><div class="svc-xp__nav"><a class="svc-xp__btn svc-xp__btn--prev" href="#branding" data-xp-go="branding"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H2M7 3L2 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><span class="sr-only">Previous discipline: </span>Branding</span></a><a class="svc-xp__btn svc-xp__btn--next" href="#branding" data-xp-go="branding"><span><span class="sr-only">Next discipline: </span>Branding</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div><a href="#inquiry" data-preselect="discipline:production" data-track="start_project" class="cta cta--badge cta--klein cta--go svc-xp__start"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Start your Production project</span></a></div></div></div></div></div></section><script type="module" src="<root>/src/components/sections/ServiceExplorer.astro?astro&type=script&index=0&lang.ts"></script><section class="hello" id="inquiry" aria-labelledby="hello-heading"><div class="hello__wrap"><div class="hello__grid"><div class="hello__side"><div class="tag tag--sky rv"><span class="dot"></span><span>Project inquiry</span></div><h2 class="hello__h rv" id="hello-heading">Say <em>hello</em></h2><p class="hello__p rv">Big idea or small fix, tell us where you want to go. The more you share, the more useful our first reply is.</p><div class="hello__rule rv" aria-hidden="true"></div><ul class="hello__pts rv"><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>A reply within one business day</span></li><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>A fixed price once the scope is agreed</span></li><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>One team from the first sketch to launch</span></li></ul></div><form id="contact-form" class="contact-form contact-form--full contact-form--hello" data-locale="en" data-kind="project_inquiry" data-err-required="This field is required." data-err-email="Enter a valid email address, like name@company.com." data-err-too-long="This is longer than we can accept." data-err-invalid="Please check this field." novalidate><div class="field"><label for="cf-name">Name</label><input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="Your full name"></div><div class="field"><label for="cf-email">Email</label><input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@company.com"></div><div class="field"><label for="cf-company">Company</label><input id="cf-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="Optional"></div><div class="field"><label for="cf-phone">Phone or WhatsApp</label><input id="cf-phone" name="phone" type="tel" dir="ltr" maxlength="32" autocomplete="tel" inputmode="tel" placeholder="+966 5X XXX XXXX"></div><div class="field"><label for="cf-service">What do you need?</label><select id="cf-service" name="service"><option value="" selected>Not sure yet, let&#39;s talk</option><optgroup label="01 Branding"><option value="discipline:branding">Branding, help me choose</option><option value="logo">Logo Design</option><option value="packaging">Packaging</option></optgroup><optgroup label="02 Production"><option value="discipline:production">Production, help me choose</option><option value="animation">Animation</option></optgroup></select></div><div class="field"><label for="cf-budget">Budget range</label><select id="cf-budget" name="budget"><option value="">Prefer to discuss</option><option value="lt_25k">Under 25k SAR</option><option value="25k_75k">25k to 75k SAR</option><option value="75k_200k">75k to 200k SAR</option><option value="gt_200k">200k SAR and up</option><option value="not_sure">Not sure yet</option></select></div><div class="field field-full"><label for="cf-message">Tell us about the project</label><textarea id="cf-message" name="message" required maxlength="5000" placeholder="What are you making, who is it for, and when does it need to be ready?"></textarea></div><div class="field field-full field-check"><input id="cf-consent" name="consent" type="checkbox"><label for="cf-consent">I agree to be contacted about my inquiry.</label></div><div class="hp-field" aria-hidden="true"><label for="cf-hp">Leave this field empty</label><input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><div class="contact-form__foot field-full"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Send a message</span></button><p class="contact-form__note">We read everything and reply within one business day.</p></div><p id="contact-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="Sending…" data-ok="Got it. We'll be in touch within one business day." data-invalid="Please correct the marked fields and try again." data-rate-limited="Too many attempts. Please wait a minute and try again." data-unavailable="The form isn’t live yet — please email hello@braiinstatiion.com." data-error="Something went wrong. Please try again."></p></form><script type="module" src="<root>/src/components/ContactForm.astro?astro&type=script&index=0&lang.ts"></script></div></div></section>"`;

