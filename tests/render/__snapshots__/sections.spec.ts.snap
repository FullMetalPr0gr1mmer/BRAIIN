exports[`every content field authored > aboutWho, a poster and a clip (ar) 1`] = `"<section class="about-who" id="who"><div class="about-who__wrap"><p class="tag"><span class="dot"></span><span>من نحن</span></p><h1 aria-label="وُلدنا في جدة. وُجدنا لننقل الأفكار من الدماغ إلى أرض الواقع." class="h-split"><span aria-hidden="true"><span class="hw hw--0">وُلدنا</span> <span class="hw hw--1">في</span> <span class="hw hw--2">جدة.</span> <span class="hw hw--3">وُجدنا</span> <span class="hw hw--4">لننقل</span> <span class="hw hw--5">الأفكار</span> <em><span class="hw hw--6">من</span> <span class="hw hw--7">الدماغ</span> <span class="hw hw--8">إلى</span> <span class="hw hw--9">أرض</span> <span class="hw hw--10">الواقع.</span></em></span></h1><div class="about-who__row"><div class="mf mf--who about-who__media" data-clip-src="/media/showreel.mp4" data-clip-start="2" data-clip-end="5" data-clip-mode="inview" data-clip-threshold="0.3" data-clip-after-load><picture><source srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=480&amp;h=270&amp;f=avif 480w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=800&amp;h=450&amp;f=avif 800w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1200&amp;h=675&amp;f=avif 1200w" type="image/avif" sizes="(min-width: 53.75rem) 52vw, 100vw"><source srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=480&amp;h=270&amp;f=webp 480w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=800&amp;h=450&amp;f=webp 800w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1200&amp;h=675&amp;f=webp 1200w" type="image/webp" sizes="(min-width: 53.75rem) 52vw, 100vw"><img src="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1600&amp;h=900&amp;f=jpg" srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=480&amp;h=270&amp;f=jpg 480w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=800&amp;h=450&amp;f=jpg 800w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1200&amp;h=675&amp;f=jpg 1200w" data-image-component="true" alt sizes="(min-width: 53.75rem) 52vw, 100vw" loading="eager" decoding="async" fetchpriority="high" width="1600" height="900"></picture></div><script type="module" src="<root>/src/components/media/MediaFrame.astro?astro&type=script&index=0&lang.ts"></script><div class="about-who__copy rv"><p class="about-who__lead">نبني علامات تُرى وتُفهم وتُتذكَّر. على الشاشة، وعلى المسرح، وعلى الرف، وبأي لغة.</p><p><b>الاستراتيجية قبل التصميم.</b> كل هوية وكل فيلم وكل حملة تبدأ بسؤال عن العمل نفسه، لا بلوحة إلهام. وإن لم يكن الشغل يحقّق شيئاً، فهو غير مكتمل.</p><p><b>استوديو واحد، خمسة تخصصات.</b> الهوية والإنتاج والصوت والفعاليات والمنتجات والويب تحت سقف واحد، فلا تضيع الفكرة في التنقل بين الجهات.</p><p><b>أصليّ بأي لغة.</b> كل لغة تُكتب وتُنسّق وتُصمَّم بلغتها، فلا تبدو أي واحدة منها ترجمة للأخرى.</p></div></div></div></section>"`;

exports[`every content field authored > aboutWho, a poster and a clip (en) 1`] = `"<section class="about-who" id="who"><div class="about-who__wrap"><p class="tag"><span class="dot"></span><span>Who we are</span></p><h1 aria-label="Born in Jeddah. Built to move ideas from the brain into the real world." class="h-split"><span aria-hidden="true"><span class="hw hw--0">Born</span> <span class="hw hw--1">in</span> <span class="hw hw--2">Jeddah.</span> <span class="hw hw--3">Built</span> <span class="hw hw--4">to</span> <span class="hw hw--5">move</span> <span class="hw hw--6">ideas</span> <em><span class="hw hw--7">from</span> <span class="hw hw--8">the</span> <span class="hw hw--9">brain</span> <span class="hw hw--10">into</span> <span class="hw hw--11">the</span> <span class="hw hw--12">real</span> <span class="hw hw--13">world.</span></em></span></h1><div class="about-who__row"><div class="mf mf--who about-who__media" data-clip-src="/media/showreel.mp4" data-clip-start="2" data-clip-end="5" data-clip-mode="inview" data-clip-threshold="0.3" data-clip-after-load><picture><source srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=480&amp;h=270&amp;f=avif 480w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=800&amp;h=450&amp;f=avif 800w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1200&amp;h=675&amp;f=avif 1200w" type="image/avif" sizes="(min-width: 53.75rem) 52vw, 100vw"><source srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=480&amp;h=270&amp;f=webp 480w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=800&amp;h=450&amp;f=webp 800w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1200&amp;h=675&amp;f=webp 1200w" type="image/webp" sizes="(min-width: 53.75rem) 52vw, 100vw"><img src="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1600&amp;h=900&amp;f=jpg" srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=480&amp;h=270&amp;f=jpg 480w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=800&amp;h=450&amp;f=jpg 800w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1200&amp;h=675&amp;f=jpg 1200w" data-image-component="true" alt sizes="(min-width: 53.75rem) 52vw, 100vw" loading="eager" decoding="async" fetchpriority="high" width="1600" height="900"></picture></div><script type="module" src="<root>/src/components/media/MediaFrame.astro?astro&type=script&index=0&lang.ts"></script><div class="about-who__copy rv"><p class="about-who__lead">We build brands that are seen, understood, and remembered. On a screen, on a stage, on a shelf, in any language.</p><p><b>Strategy before pixels.</b> Every identity, film, and campaign starts with a question about the business, not a mood board. If the work isn&#39;t earning something, it isn&#39;t finished.</p><p><b>One studio, five disciplines.</b> Identity, film, sound, events, merch, and web all live under one roof, so the idea never gets diluted in the handoff between vendors.</p><p><b>Native in any language.</b> Every language is written, typeset, and designed as itself, so none of them reads like a translation of another.</p></div></div></div></section>"`;

exports[`every content field authored > clientsMarquee (ar) 1`] = `"<section class="clients" aria-label="وسم مكتوب" id="clients"><div class="tag tag--sky rv"><span class="dot"></span><span>وسم مكتوب</span></div><div class="clients__head"><h2 class="rv">عنوان العملاء المكتوب.</h2><span class="rv">ملاحظة مكتوبة</span></div><div class="marquee"><ul class="marquee-track"><li class="marquee-item">أكمي</li><li class="marquee-item">جلوبكس</li><li class="marquee-item" aria-hidden="true">أكمي</li><li class="marquee-item" aria-hidden="true">جلوبكس</li></ul></div><div class="marquee marquee--rev" aria-hidden="true"><ul class="marquee-track"><li class="marquee-item" aria-hidden="true">جلوبكس</li><li class="marquee-item" aria-hidden="true">أكمي</li><li class="marquee-item" aria-hidden="true">جلوبكس</li><li class="marquee-item" aria-hidden="true">أكمي</li></ul></div></section>"`;

exports[`every content field authored > clientsMarquee (en) 1`] = `"<section class="clients" aria-label="Authored tag" id="clients"><div class="tag tag--sky rv"><span class="dot"></span><span>Authored tag</span></div><div class="clients__head"><h2 class="rv">Authored clients heading.</h2><span class="rv">Authored note</span></div><div class="marquee"><ul class="marquee-track"><li class="marquee-item">Acme</li><li class="marquee-item">Globex</li><li class="marquee-item" aria-hidden="true">Acme</li><li class="marquee-item" aria-hidden="true">Globex</li></ul></div><div class="marquee marquee--rev" aria-hidden="true"><ul class="marquee-track"><li class="marquee-item" aria-hidden="true">Globex</li><li class="marquee-item" aria-hidden="true">Acme</li><li class="marquee-item" aria-hidden="true">Globex</li><li class="marquee-item" aria-hidden="true">Acme</li></ul></div></section>"`;

exports[`every content field authored > contact (ar) 1`] = `"<section class="home-contact" id="contact" aria-labelledby="home-contact-cta"><div class="section-wrap"><h2 class="display-cta rv" id="home-contact-cta">قبل مكتوب <em>لكنة</em></h2><form id="contact-form" class="contact-form contact-form--compact" data-locale="ar" data-kind="contact" data-err-required="هذا الحقل مطلوب." data-err-email="أدخل بريدًا إلكترونيًا صحيحًا، مثل name@company.com." data-err-too-long="النص أطول من الحد المسموح." data-err-invalid="يرجى مراجعة هذا الحقل." novalidate><div class="field"><label for="cf-name">الاسم</label><input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="اسمك الكامل"></div><div class="field"><label for="cf-email">البريد الإلكتروني</label><input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@company.com"></div><div class="field"><label for="cf-company">الشركة</label><input id="cf-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="اختياري"></div><div class="field"><label for="cf-service">وش تحتاج؟</label><select id="cf-service" name="service"><option value="" selected>لسه ما قررت، خلّنا نتكلم</option><optgroup label="01 الهوية البصرية"><option value="discipline:branding">الهوية البصرية، ساعدوني أختار</option><option value="logo">تصميم الشعار</option><option value="packaging">التغليف</option></optgroup><optgroup label="02 الإنتاج"><option value="discipline:production">الإنتاج، ساعدوني أختار</option><option value="animation">الرسوم المتحركة</option></optgroup></select></div><div class="field field-full"><label for="cf-message">احكِ لنا عن المشروع</label><textarea id="cf-message" name="message" required maxlength="5000" placeholder="وش تبني، ولمين، ومتى لازم يطلع؟"></textarea></div><div class="field field-full field-check"><input id="cf-consent" name="consent" type="checkbox"><label for="cf-consent">أوافق على التواصل معي بخصوص طلبي.</label></div><div class="hp-field" aria-hidden="true"><label for="cf-hp">Leave this field empty</label><input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><div class="contact-form__foot field-full"><button type="submit" class="cta cta--trail"><span>أرسل الرسالة</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><p class="contact-form__note">نقرأ كل رسالة ونرد خلال يوم عمل واحد.</p></div><p id="contact-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="جارٍ الإرسال…" data-ok="وصلتنا. بنتواصل معك خلال يوم عمل واحد." data-invalid="يرجى تصحيح الحقول المشار إليها والمحاولة مرة أخرى." data-rate-limited="محاولات كثيرة. يرجى الانتظار دقيقة ثم المحاولة مرة أخرى." data-unavailable="النموذج غير مُفعّل بعد — راسلنا على hello@braiinstatiion.com." data-error="حدث خطأ ما. حاول مرة أخرى."></p></form><script type="module" src="<root>/src/components/ContactForm.astro?astro&type=script&index=0&lang.ts"></script></div></section>"`;

exports[`every content field authored > contact (en) 1`] = `"<section class="home-contact" id="contact" aria-labelledby="home-contact-cta"><div class="section-wrap"><h2 class="display-cta rv" id="home-contact-cta">Authored pre <em>authored accent</em></h2><form id="contact-form" class="contact-form contact-form--compact" data-locale="en" data-kind="contact" data-err-required="This field is required." data-err-email="Enter a valid email address, like name@company.com." data-err-too-long="This is longer than we can accept." data-err-invalid="Please check this field." novalidate><div class="field"><label for="cf-name">Name</label><input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="Your full name"></div><div class="field"><label for="cf-email">Email</label><input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@company.com"></div><div class="field"><label for="cf-company">Company</label><input id="cf-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="Optional"></div><div class="field"><label for="cf-service">What do you need?</label><select id="cf-service" name="service"><option value="" selected>Not sure yet, let&#39;s talk</option><optgroup label="01 Branding"><option value="discipline:branding">Branding, help me choose</option><option value="logo">Logo Design</option><option value="packaging">Packaging</option></optgroup><optgroup label="02 Production"><option value="discipline:production">Production, help me choose</option><option value="animation">Animation</option></optgroup></select></div><div class="field field-full"><label for="cf-message">Tell us about the project</label><textarea id="cf-message" name="message" required maxlength="5000" placeholder="What are you making, who is it for, and when does it need to be ready?"></textarea></div><div class="field field-full field-check"><input id="cf-consent" name="consent" type="checkbox"><label for="cf-consent">I agree to be contacted about my inquiry.</label></div><div class="hp-field" aria-hidden="true"><label for="cf-hp">Leave this field empty</label><input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><div class="contact-form__foot field-full"><button type="submit" class="cta cta--trail"><span>Send message</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><p class="contact-form__note">We read everything and reply within one business day.</p></div><p id="contact-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="Sending…" data-ok="Got it. We'll be in touch within one business day." data-invalid="Please correct the marked fields and try again." data-rate-limited="Too many attempts. Please wait a minute and try again." data-unavailable="The form isn’t live yet — please email hello@braiinstatiion.com." data-error="Something went wrong. Please try again."></p></form><script type="module" src="<root>/src/components/ContactForm.astro?astro&type=script&index=0&lang.ts"></script></div></section>"`;

