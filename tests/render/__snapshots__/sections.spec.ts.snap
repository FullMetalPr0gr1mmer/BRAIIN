exports[`variants, modes and route data > testimonials klein built-in (en) 1`] = `"<section id="testimonials" aria-roledescription="carousel" aria-labelledby="testimonials-heading" data-carousel class="tm tm--klein klein-band"><div class="tm__grid"><div class="tm__side"><p class="tag rv"><span class="dot"></span>Testimonials</p><h2 class="rv" id="testimonials-heading">In their <em>words</em></h2><div class="tm__nav rv" data-controls hidden><button class="tm__btn" type="button" data-prev aria-label="Previous testimonial"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H2M7 3L2 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button class="tm__btn" type="button" data-next aria-label="Next testimonial"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button class="tm__btn tm__toggle" type="button" data-toggle data-label-pause="Pause the testimonials" data-label-play="Play the testimonials" aria-label="Pause the testimonials" hidden><svg class="tm__pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg><svg class="tm__play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l8 5-8 5z" fill="currentColor"></path></svg></button><span class="tm__count" data-counter aria-hidden="true"></span></div></div><div class="tm__main rv"><div class="tm__stage" data-stage aria-live="polite"><figure class="tm__q is-active" data-slide role="group" aria-roledescription="slide" aria-label="1 of 2"><svg class="tm__mark" viewBox="0 0 40 30" aria-hidden="true"><path fill="currentColor" d="M0 30V17.6C0 7.4 5.3 1.5 15.8 0l1.6 4.4C11.7 6 9 9.4 8.8 14.5H16V30H0Zm22.6 0V17.6C22.6 7.4 27.9 1.5 38.4 0L40 4.4c-5.7 1.6-8.4 5-8.6 10.1h7.2V30H22.6Z"></path></svg><blockquote class="tm__text"><p>They listened first.</p></blockquote><figcaption class="tm__who"><span class="tm__av" aria-hidden="true">SE</span><span><span class="tm__n">Sam Example</span><span class="tm__r">Head of Brand, Acme</span></span></figcaption></figure><figure class="tm__q" data-slide role="group" aria-roledescription="slide" aria-label="2 of 2"><svg class="tm__mark" viewBox="0 0 40 30" aria-hidden="true"><path fill="currentColor" d="M0 30V17.6C0 7.4 5.3 1.5 15.8 0l1.6 4.4C11.7 6 9 9.4 8.8 14.5H16V30H0Zm22.6 0V17.6C22.6 7.4 27.9 1.5 38.4 0L40 4.4c-5.7 1.6-8.4 5-8.6 10.1h7.2V30H22.6Z"></path></svg><blockquote class="tm__text"><p>On time, every time.</p></blockquote><figcaption class="tm__who"><span class="tm__av" aria-hidden="true">LS</span><span><span class="tm__n">Lee Sample</span></span></figcaption></figure></div><div class="tm__bar" aria-hidden="true"><i data-bar></i></div></div></div></section><script type="module" src="<root>/src/components/sections/Testimonials.astro?astro&type=script&index=0&lang.ts"></script>"`;

exports[`variants, modes and route data > workIntro without a link (ar) 1`] = `"<section class="work-intro work-intro--text"><div class="work-intro__grid"><div class="work-intro__txt rv"><p>كل مشروع هنا بدأ كرسمة في دفتر، وانتهى في مكان يقدر الناس يشوفونه أو يلمسونه أو يسمعونه. هذه مختارات من الشغل اللي نفتخر فيه أكثر.</p></div></div></section>"`;

exports[`variants, modes and route data > workIntro without a link (en) 1`] = `"<section class="work-intro work-intro--text"><div class="work-intro__grid"><div class="work-intro__txt rv"><p>Every project here started as a sketch in a notebook and ended somewhere people could see it, hold it, or hear it. This is a selection of the work we&#39;re proudest of.</p></div></div></section>"`;
