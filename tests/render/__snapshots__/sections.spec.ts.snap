exports[`variants, modes and route data > servicesOverview fallback cards (ar) 1`] = `"<section class="disc disc--page" id="categories" aria-labelledby="categories-heading" data-disc-mode="page"><div class="disc__wrap"><div class="disc__head"><div><div class="tag rv"><span class="dot"></span><span>خدماتنا</span></div><h2 class="rv" id="categories-heading">كل اللي تحتاجه <em>علامتك</em></h2></div><p class="rv">خمسة تخصصات وثمان وعشرون خدمة. افتح أي تخصص وشوف كل اللي فيه.</p></div><div class="disc__stage"><a class="disc-card" href="#branding" data-disc="branding" data-clip-trigger data-track="discipline_card"><span class="disc-card__clip"><span class="disc-card__media disc-card__media--none"></span><span class="disc-card__ring" aria-hidden="true"></span><span class="disc-card__n" aria-hidden="true">01</span><span class="disc-card__go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="disc-card__bot"><span class="disc-card__s"><span class="disc-card__head"><span class="disc-card__t">الهوية البصرية</span></span> <span class="disc-card__line">الشعار والنظام، وكل شي يلمسه.</span></span></span></span></a><a class="disc-card" href="#production" data-disc="production" data-clip-trigger data-track="discipline_card"><span class="disc-card__clip"><span class="disc-card__media disc-card__media--none"></span><span class="disc-card__ring" aria-hidden="true"></span><span class="disc-card__n" aria-hidden="true">02</span><span class="disc-card__go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="disc-card__bot"><span class="disc-card__s"><span class="disc-card__head"><span class="disc-card__t">الإنتاج</span></span> <span class="disc-card__line">فيديو وموشن وتصوير وصوت، كله ننتج