exports[`pages, as their routes compose them > about (en) 1`] = `"<section class="about-who about-who--text" id="who"><div class="about-who__wrap"><p class="tag"><span class="dot"></span><span>Who we are</span></p><h1 aria-label="Born in Jeddah. Built to move ideas from the brain into the real world." class="h-split"><span aria-hidden="true"><span class="hw hw--0">Born</span> <span class="hw hw--1">in</span> <span class="hw hw--2">Jeddah.</span> <span class="hw hw--3">Built</span> <span class="hw hw--4">to</span> <span class="hw hw--5">move</span> <span class="hw hw--6">ideas</span> <em><span class="hw hw--7">from</span> <span class="hw hw--8">the</span> <span class="hw hw--9">brain</span> <span class="hw hw--10">into</span> <span class="hw hw--11">the</span> <span class="hw hw--12">real</span> <span class="hw hw--13">world.</span></em></span></h1><div class="about-who__row"><div class="about-who__copy"><p class="about-who__lead">We build brands that are seen, understood, and remembered. On a screen, on a stage, on a shelf, in any language.</p><p><b>Strategy before pixels.</b> Every identity, film, and campaign starts with a question about the business, not a mood board. If the work isn&#39;t earning something, it isn&#39;t finished.</p><p><b>One studio, five disciplines.</b> Identity, film, sound, events, merch, and web all live under one roof, so the idea never gets diluted in the handoff between vendors.</p><p><b>Native in any language.</b> Every language is written, typeset, and designed as itself, so none of them reads like a translation of another.</p></div></div></div></section><section class="leaders" id="team" aria-labelledby="team-heading" data-slider><div class="leaders__wrap"><div class="leaders__head"><div><p class="tag tag--sky rv"><span class="dot"></span><span>Leadership</span></p><h2 class="rv" id="team-heading">Meet our <em>leadership</em> team</h2></div><p class="rv">The people who keep five disciplines pulling in the same direction.</p></div><div class="leaders__track" id="team-track" role="region" aria-label="Leadership team" tabindex="0" data-slider-track><ul class="leaders__list"><li class="leader rv"><a class="leader__card leader__card--link" href="https://www.linkedin.com/in/first-leader" target="_blank" rel="noopener noreferrer"><span class="leader__ph"><svg class="leader__sil" viewBox="0 0 200 220" aria-hidden="true"><circle cx="100" cy="70" r="44" fill="currentColor"></circle><path d="M8 220c4-58 44-96 92-96s88 38 92 96z" fill="currentColor"></path></svg><span class="leader__in" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm6.5 0h3.8v1.6h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.3c0-1.27-.02-2.9-1.8-2.9-1.8 0-2.08 1.38-2.08 2.8V21h-4V9.5Z"></path></svg></span></span><h3 class="leader__n">First Leader</h3><p class="leader__r">Founder</p><span class="sr-only">LinkedIn profile (opens in a new tab)</span></a></li><li class="leader rv"><div class="leader__card"><span class="leader__ph"><svg class="leader__sil" viewBox="0 0 200 220" aria-hidden="true"><circle cx="100" cy="70" r="44" fill="currentColor"></circle><path d="M8 220c4-58 44-96 92-96s88 38 92 96z" fill="currentColor"></path></svg></span><h3 class="leader__n">Second Leader</h3></div></li></ul></div><div class="leaders__nav" data-slider-nav hidden><button type="button" class="leaders__btn" aria-controls="team-track" aria-label="Previous" data-slider-prev><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H2M7 3L2 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button type="button" class="leaders__btn" aria-controls="team-track" aria-label="Next" data-slider-next><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><span class="leaders__count" aria-hidden="true" dir="ltr"><b data-slider-current>01</b> / <span data-slider-total>02</span></span><span class="leaders__bar" aria-hidden="true"><i data-slider-bar></i></span></div></div></section><script type="module" src="<root>/src/components/sections/LeadershipSlider.astro?astro&type=script&index=0&lang.ts"></script><section class="sb sb--reach"><div class="sb__wrap"><p class="tag rv"><span class="dot"></span>Our reach</p><div class="sb__head"><h2 class="rv">Campaigns that run <em>end to end</em></h2><p class="rv">We started with minds built to plan, make, and run integrated campaigns. From brand strategy and production to media and live events, we build communication that feels new, for clients who expect it to deliver.</p></div><ul class="sb__grid"><li class="sb__cell rv"><span class="sb__n"><span class="sr-only">250+</span><span aria-hidden="true"><span data-count-to="250">250</span><i>+</i></span></span><span class="sb__l">Projects delivered</span></li><li class="sb__cell rv"><span class="sb__n"><span class="sr-only">80</span><span aria-hidden="true"><span data-count-to="80">80</span></span></span><span class="sb__l">Clients</span></li><li class="sb__cell rv"><span class="sb__n sb__n--text">TBD</span><span class="sb__l">Years</span></li></ul></div></section><script type="module" src="<root>/src/components/sections/StatBand.astro?astro&type=script&index=0&lang.ts"></script><section class="social-strip social-strip--klein klein-band"><div class="social-strip__wrap section-wrap"><div class="social-strip__head"><div><div class="tag rv"><span class="dot"></span><span>Follow the studio</span></div><h2 class="rv">See the work <em>as it happens</em></h2></div><p class="rv">Launches, behind the scenes, and new work. It goes up on our channels first.</p></div><ul class="social-links"><li><a class="sbox rv" href="https://instagram.com/braiinstatiion" target="_blank" rel="noopener"><span class="sbox__top"><svg class="sbox__ico" viewBox="0 0 24 24" ari