exports[`pages, as their routes compose them > about (ar) 1`] = `"<section class="about-who about-who--text" id="who"><div class="about-who__wrap"><p class="tag"><span class="dot"></span><span>من نحن</span></p><h1 aria-label="وُلدنا في جدة. وُجدنا لننقل الأفكار من الدماغ إلى أرض الواقع." class="h-split"><span aria-hidden="true"><span class="hw hw--0">وُلدنا</span> <span class="hw hw--1">في</span> <span class="hw hw--2">جدة.</span> <span class="hw hw--3">وُجدنا</span> <span class="hw hw--4">لننقل</span> <span class="hw hw--5">الأفكار</span> <em><span class="hw hw--6">من</span> <span class="hw hw--7">الدماغ</span> <span class="hw hw--8">إلى</span> <span class="hw hw--9">أرض</span> <span class="hw hw--10">الواقع.</span></em></span></h1><div class="about-who__row"><div class="about-who__copy"><p class="about-who__lead">نبني علامات تُرى وتُفهم وتُتذكَّر. على الشاشة، وعلى المسرح، وعلى الرف، وبأي لغة.</p><p><b>الاستراتيجية قبل التصميم.</b> كل هوية وكل فيلم وكل حملة تبدأ بسؤال عن العمل نفسه، لا بلوحة إلهام. وإن لم يكن الشغل يحقّق شيئاً، فهو غير مكتمل.</p><p><b>استوديو واحد، خمسة تخصصات.</b> الهوية والإنتاج والصوت والفعاليات والمنتجات والويب تحت سقف واحد، فلا تضيع الفكرة في التنقل بين الجهات.</p><p><b>أصليّ بأي لغة.</b> كل لغة تُكتب وتُنسّق وتُصمَّم بلغتها، فلا تبدو أي واحدة منها ترجمة للأخرى.</p></div></div></div></section><section class="leaders" id="team" aria-labelledby="team-heading" data-slider><div class="leaders__wrap"><div class="leaders__head"><div><p class="tag tag--sky rv"><span class="dot"></span><span>القيادة</span></p><h2 class="rv" id="team-heading">تعرّف على <em>فريق القيادة</em></h2></div><p class="rv">الناس اللي يخلّون خمسة تخصصات تمشي في نفس الاتجاه.</p></div><div class="leaders__track" id="team-track" role="region" aria-label="فريق القيادة" tabindex="0" data-slider-track><ul class="leaders__list"><li class="leader rv"><a class="leader__card leader__card--link" href="https://www.linkedin.com/in/first-leader" target="_blank" rel="noopener noreferrer"><span class="leader__ph"><svg class="leader__sil" viewBox="0 0 200 220" aria-hidden="true"><circle cx="100" cy="70" r="44" fill="currentColor"></circle><path d="M8 220c4-58 44-96 92-96s88 38 92 96z" fill="currentColor"></path></svg><span class="leader__in" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm6.5 0h3.8v1.6h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.3c0-1.27-.02-2.9-1.8-2.9-1.8 0-2.08 1.38-2.08 2.8V21h-4V9.5Z"></path></svg></span></span><h3 class="leader__n">القائد الأول</h3><p class="leader__r">المؤسس</p><span class="sr-only">حساب لينكدإن (يفتح في تبويب جديد)</span></a></li><li class="leader rv"><div class="leader__card"><span class="leader__ph"><svg class="leader__sil" viewBox="0 0 200 220" aria-hidden="true"><circle cx="100" cy="70" r="44" fill="currentColor"></circle><path d="M8 220c4-58 44-96 92-96s88 38 92 96z" fill="currentColor"></path></svg></span><h3 class="leader__n">القائد الثاني</h3></div></li></ul></div><div class="leaders__nav" data-slider-nav hidden><button type="button" class="leaders__btn" aria-controls="team-track" aria-label="السابق" data-slider-prev><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H2M7 3L2 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><button type="button" class="leaders__btn" aria-controls="team-track" aria-label="التالي" data-slider-next><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><span class="leaders__count" aria-hidden="true" dir="ltr"><b data-slider-current>01</b> / <span data-slider-total>02</span></span><span class="leaders__bar" aria-hidden="true"><i data-slider-bar></i></span></div></div></section><script type="module" src="<root>/src/components/sections/LeadershipSlider.astro?astro&type=script&index=0&lang.ts"></script><section class="sb sb--reach"><div class="sb__wrap"><p class="tag rv"><span class="dot"></span>نطاق تأثيرنا</p><div class="sb__head"><h2 class="rv">حملات متكاملة <em>من البداية للنهاية</em></h2><p class="rv">انطلقنا بعقول مبنية للتخطيط والتنفيذ وإدارة الحملات المتكاملة. من استراتيجية العلامة والإنتاج إلى الإعلام والفعاليات الحيّة، نبني تواصلاً يبدو جديداً، لعملاء يتوقعون منه نتائج.</p></div><ul class="sb__grid"><li class="sb__cell rv"><span class="sb__n"><span class="sr-only">250+</span><span aria-hidden="true"><span data-count-to="250">250</span><i>+</i></span></span><span class="sb__l">مشروع منجز</span></li><li class="sb__cell rv"><span class="sb__n"><span class="sr-only">80</span><span aria-hidden="true"><span data-count-to="80">80</span></span></span><span class="sb__l">عميل</span></li><li class="sb__cell rv"><span class="sb__n sb__n--text">TBD</span><span class="sb__l">سنوات</span></li></ul></div></section><script type="module" src="<root>/src/components/sections/StatBand.astro?astro&type=script&index=0&lang.ts"></script><section class="social-strip social-strip--klein klein-band"><div class="social-strip__wrap section-wrap"><div class="social-strip__head"><div><div class="tag rv"><span class="dot"></span><span>تابع الاستوديو</span></div><h2 class="rv">شوف الشغل <em>وهو يصير</em></h2></div><p class="rv">الإطلاقات وكواليس العمل والشغل الجديد. كلها تنزل على حساباتنا أول.</p></div><ul class="social-links"><li><a class="sbox rv" href="https://instagram.com/braiinstatiion" target="_blank" rel="noopener"><span class="sbox__top"><svg class="sbox__ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c0 1.2-.2 1.8-.4 2.2a3.7 3.7 0 0 1-.9 1.4c-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2 0-1.8-.2-2.2-.4a3.7 3.7 0 0 1-1.4-.9 3.7 3.7 0 0 1-.9-1.4c-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-