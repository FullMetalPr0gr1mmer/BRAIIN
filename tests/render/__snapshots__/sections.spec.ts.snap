%3D900%26origFormat%3Djpg&amp;w=1600&amp;h=900&amp;f=jpg" srcset="/_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=480&amp;h=270&amp;f=jpg 480w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=800&amp;h=450&amp;f=jpg 800w, /_image?href=%2F%40fs%2F<root>%2Fsrc%2Fassets%2Fmedia%2Fstills%2Fproject%2Fg01.jpg%3ForigWidth%3D1600%26origHeight%3D900%26origFormat%3Djpg&amp;w=1200&amp;h=675&amp;f=jpg 1200w" data-image-component="true" alt sizes="(min-width: 47.5rem) 50vw, 100vw" loading="lazy" decoding="async" fetchpriority="auto" width="1600" height="900"></picture></div><script type="module" src="<root>/src/components/media/MediaFrame.astro?astro&type=script&index=0&lang.ts"></script><h3 class="pcard__t">The Rider | Brand film</h3></a><div class="facets facets--dark"><div class="facets__f"><span class="facets__k">Service</span><div class="facets__tags"><a class="ftag" href="/portfolio?service=animation#projects" data-f="service" data-v="animation">Animation</a></div></div><div class="facets__f"><span class="facets__k">Sector</span><div class="facets__tags"><a class="ftag" href="/portfolio?sector=retail#projects" data-f="sector" data-v="retail">Retail</a></div></div><div class="facets__f"><span class="facets__k">Client</span><div class="facets__tags"><a class="ftag" href="/portfolio?client=acme#projects" data-f="client" data-v="acme">Acme</a></div></div><div class="facets__f"><span class="facets__k">Year</span><div class="facets__tags"><a class="ftag" href="/portfolio?year=2025#projects" data-f="year" data-v="2025">2025</a></div></div></div></article><article class="pcard pcard--catalog rv" data-card data-facets="{&quot;service&quot;:[],&quot;sector&quot;:[],&quot;client&quot;:[],&quot;year&quot;:[&quot;2024&quot;]}"><a class="pcard__link" href="/portfolio/quiet-mark" data-clip-trigger data-track="project_card"><div class="mf mf--card"></div><h3 class="pcard__t">Quiet Mark</h3></a><div class="facets facets--dark"><div class="facets__f"><span class="facets__k">Client</span><div class="facets__tags"><span class="ftag ftag--note">Confidential client</span></div></div><div class="facets__f"><span class="facets__k">Year</span><div class="facets__tags"><a class="ftag" href="/portfolio?year=2024#projects" data-f="year" data-v="2024">2024</a></div></div></div></article><article class="pcard pcard--catalog rv" data-card data-facets="{&quot;service&quot;:[],&quot;sector&quot;:[&quot;food&quot;],&quot;client&quot;:[],&quot;year&quot;:[&quot;2023&quot;]}"><a class="pcard__link" href="/portfolio/third-light" data-clip-trigger data-track="project_card"><div class="mf mf--card"></div><h3 class="pcard__t">Third Light | Identity</h3></a><div class="facets facets--dark"><div class="facets__f"><span class="facets__k">Sector</span><div class="facets__tags"><a class="ftag" href="/portfolio?sector=food#projects" data-f="sector" data-v="food">Food</a></div></div><div class="facets__f"><span class="facets__k">Year</span><div class="facets__tags"><a class="ftag" href="/portfolio?year=2023#projects" data-f="year" data-v="2023">2023</a></div></div></div></article><div class="fb__empty" data-empty hidden><p>No projects match these filters.</p><a class="fb__clear" href="/portfolio#projects" data-f="all" data-v="">Clear filters</a></div></div><div class="pgrid__foot"><a href="/portfolio/all" data-see-all data-index="[{&quot;service&quot;:[&quot;animation&quot;],&quot;sector&quot;:[&quot;retail&quot;],&quot;client&quot;:[&quot;acme&quot;],&quot;year&quot;:[&quot;2025&quot;]},{&quot;service&quot;:[],&quot;sector&quot;:[],&quot;client&quot;:[],&quot;year&quot;:[&quot;2024&quot;]},{&quot;service&quot;:[],&quot;sector&quot;:[&quot;food&quot;],&quot;client&quot;:[],&quot;year&quot;:[&quot;2023&quot;]}]" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span><span data-see-all-label>See all projects</span></span></a></div></section><script type="module" src="<root>/src/components/sections/ProjectGrid.astro?astro&type=script&index=0&lang.ts"></script><section class="clients" aria-label="Selected clients" id="clients"><div class="tag tag--sky rv"><span class="dot"></span><span>Selected clients</span></div><div class="clients__head"><h2 class="rv">Trusted by the minds behind the region&#39;s biggest moments.</h2><span class="rv">Since 2019</span></div><div class="marquee"><ul class="marquee-track"><li class="marquee-item">Acme</li><li class="marquee-item">Globex</li><li class="marquee-item" aria-hidden="true">Acme</li><li class="marquee-item" aria-hidden="true">Globex</li></ul></div><div class="marquee marquee--rev" aria-hidden="true"><ul class="marquee-track"><li class="marquee-item" aria-hidden="true">Globex</li><li class="marquee-item" aria-hidden="true">Acme</li><li class="marquee-item" aria-hidden="true">Globex</li><li class="marquee-item" aria-hidden="true">Acme</li></ul></div></section><section class="lead-band klein-band" aria-labelledby="lead-band-heading"><div class="lead-band__wrap"><p class="tag rv"><span class="dot"></span>Start a project</p><h2 class="rv" id="lead-band-heading">Your idea could be <em>next</em></h2><div class="lead-band__row"><p class="rv">Tell us what you&#39;re making. You&#39;ll hear back within one business day with our questions, a rough range, and a time to talk.</p><div class="lead-band__acts rv"><a href="/contact#inquiry" data-track="contact_link" class="cta cta--badge cta--light cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Start an inquiry</span></a><a class="lead-band__mail" href="mailto:hello@braiinstatiion.com" dir="ltr" data-track="email">hello@braiinstatiion.com</a></div></div></div></section>"`;

exports[`variants, modes and route data > aboutStory and aboutIntro built-in (ar) 1`] = `"<section class="about-story"><div class="container"><h1>عن بريّن ستيشن</h1><p class="lead">بريّن ستيشن استوديو إبداعي ثنائي اللغة في المملكة العربية السعودية — خمسة تخصصات، وفريق واحد، يبني علامات تعمل بالعربية والإنجليزية على حدٍ سواء.</p><div class="about-pillars"><div><h2>رسالتنا</h2><p>أن نمنح العلامات الطموحة في المنطقة شريكًا إبداعيًا واحدًا مسؤولًا — من الهوية والفيلم إلى الويب والبحث — نُقاس بالنتائج التي نحققها لا بالجوائز.</p></div><div><h2>رؤيتنا</h2><p>مشهد إبداعي في منطقة الشرق الأوسط وشمال أفريقيا يكون فيه العمل عالمي المستوى هو المتوقع، ثنائي اللغة بطبيعته، وقريبًا من الجمهور الذي يخدمه.</p></div></div></div></section><section class="about-intro" id="about"><div class="section-wrap"><div class="tag rv"><span class="dot"></span><span>ليش بريّن ستيشن</span></div><h2 class="rv">وُلدنا في جدة. وُجدنا لننقل الأفكار <b>من الدماغ إلى أرض الواقع</b>.</h2><p class="about-intro__lead rv">نبني علامات تُرى وتُفهم وتُتذكَّر. على الشاشة، وعلى المسرح، وعلى الرف، وبأي لغة.</p><div class="about-intro__cols"><div class="rv"><h3>الاستراتيجية قبل التصميم</h3><p>كل هوية وكل فيلم وكل حملة تبدأ بسؤال عن العمل نفسه، لا بلوحة إلهام. وإن لم يكن الشغل يحقّق شيئاً، فهو غير مكتمل.</p></div><div class="rv"><h3>استوديو واحد، خمسة تخصصات</h3><p>الهوية والإنتاج والصوت والفعاليات والمنتجات والويب تحت سقف واحد، فلا تضيع الفكرة في التنقل بين ثلاث جهات.</p></div><div class="rv"><h3>أصليّ بأي لغة</h3><p>عربي، إنجليزي، أو أي لغة يتحدثها السوق. كل لغة تُكتب وتُنسّق وتُصمَّم بلغتها، فلا تبدو أي واحدة منها ترجمة للأخرى.</p></div></div></div></section>"`;

exports[`variants, modes and route data > aboutStory and aboutIntro built-in (en) 1`] = `"<section class="about-story"><div class="container"><h1>About Braiin Statiion</h1><p class="lead">Braiin Statiion is a bilingual creative studio in Saudi Arabia — five disciplines, one team, building brands that work in Arabic and English alike.</p><div class="about-pillars"><div><h2>Our mission</h2><p>To give ambitious brands in the region a single, accountable creative partner — from identity and film to web and search — measured by the results we ship, not the awards we chase.</p></div><div><h2>Our vision</h2><p>A MENA creative scene where world-class work is expected, bilingual by default, and made close to the audiences it serves.</p></div></div></div></section><section class="about-intro" id="about"><div class="section-wrap"><div class="tag rv"><span class="dot"></span><span>Why Braiin Statiion</span></div><h2 class="rv">Born in Jeddah. Built to move ideas <b>from the brain into the real world</b>.</h2><p class="about-intro__lead rv">We build brands that are seen, understood, and remembered. On a screen, on a stage, on a shelf, in any language.</p><div class="about-intro__cols"><div class="rv"><h3>Strategy before pixels</h3><p>Every identity, film, and campaign starts with a question about the business, not a mood board. If the work isn&#39;t earning something, it isn&#39;t finished.</p></div><div class="rv"><h3>One studio, five disciplines</h3><p>Identity, film, sound, events, merch, and web all live under one roof, so the idea never gets diluted in the handoff between three vendors.</p></div><div class="rv"><h3>Native in any language</h3><p>Arabic, English, or whatever the market speaks. Every language is written, typeset, and designed natively, so none of them ends up reading like a translation of another.</p></div></div></div></section>"`;

exports[`variants, modes and route data > hero built-in, no intro (ar) 1`] = `"<section class="hero"><div class="hero__media" data-video-src="/media/showreel.mp4"></div><div class="hero__inner"><h1 aria-label="شغل إبداعي يحقّق نتائج*"><span class="word" aria-hidden="true"><span class="letter">شغل</span></span> <span class="word" aria-hidden="true"><span class="letter">إبداعي</span></span> <span class="word accent" aria-hidden="true"><span class="letter">يحقّق</span></span> <span class="word accent" aria-hidden="true"><span class="letter">نتائج</span></span><span class="word word--mark" aria-hidden="true"><span class="letter letter--plain">*</span></span></h1><div class="hero__side"><p class="hero__sub">من الدماغ إلى أرض الواقع.</p><a class="cta hero__cta" href="#selected-work"><span>شوف أعمالنا</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="hero__scroll" aria-hidden="true"><i></i><span>انزل</span></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script>"`;

exports[`variants, modes and route data > hero built-in, no intro (en) 1`] = `"<section class="hero"><div class="hero__media" data-video-src="/media/showreel.mp4"></div><div class="hero__inner"><h1 aria-label="Creative work that performs*"><span class="word" aria-hidden="true"><span class="letter">C</span><span class="letter">r</span><span class="letter">e</span><span class="letter">a</span><span class="letter">t</span><span class="letter">i</span><span class="letter">v</span><span class="letter">e</span></span> <span class="word" aria-hidden="true"><span class="letter">w</span><span class="letter">o</span><span class="letter">r</span><span class="letter">k</span></span> <span class="word" aria-hidden="true"><span class="letter">t</span><span class="letter">h</span><span class="letter">a</span><span class="letter">t</span></span> <span class="word accent" aria-hidden="true"><span class="letter">p</span><span class="letter">e</span><span class="letter">r</span><span class="letter">f</span><span class="letter">o</span><span class="letter">r</span><span class="letter">m</span><span class="letter">s</span></span><span class="word word--mark" aria-hidden="true"><span class="letter letter--plain">*</span></span></h1><div class="hero__side"><p class="hero__sub">From the brain to the real world.</p><a class="cta hero__cta" href="#selected-work"><span>See our work</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div><div class="hero__scroll" aria-hidden="true"><i></i><span>Scroll</span></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script>"`;

exports[`variants, modes and route data > hero service page (ar) 1`] = `"<section class="hero hero--banner hero--one"><div class="hero__media" data-video-src="/media/showreel.mp4" data-clip-start="1" data-clip-end="2"></div><a class="hero__skip" href="#inquiry" data-track="skip_to_inquiry"><span class="hero__skip-t"><small>زرتنا قبل؟</small><b>انتقل للطلب مباشرة</b></span><span class="hero__skip-go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></a><div class="hero__inner"><nav class="crumb" aria-label="مسار التنقل"><a href="/ar/services">الخدمات</a><span aria-hidden="true">/</span><a href="/ar/services#branding">Branding</a></nav><h1 aria-label="تصميم الشعار"><span class="word" aria-hidden="true"><span class="letter">تصميم</span></span> <span class="word" aria-hidden="true"><span class="letter">الشعار</span></span></h1><div class="hero__side"><a href="#case" class="cta cta--badge cta--klein cta--down hero__cta"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>شوف أعمالنا</span></a></div></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script>"`;

exports[`variants, modes and route data > hero service page (en) 1`] = `"<section class="hero hero--banner hero--one"><div class="hero__media" data-video-src="/media/showreel.mp4" data-clip-start="1" data-clip-end="2"></div><a class="hero__skip" href="#inquiry" data-track="skip_to_inquiry"><span class="hero__skip-t"><small>Been here before?</small><b>Skip to the inquiry</b></span><span class="hero__skip-go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></a><div class="hero__inner"><nav class="crumb" aria-label="Breadcrumb"><a href="/services">Services</a><span aria-hidden="true">/</span><a href="/services#branding">Branding</a></nav><h1 aria-label="Logo Design"><span class="word" aria-hidden="true"><span class="letter">L</span><span class="letter">o</span><span class="letter">g</span><span class="letter">o</span></span> <span class="word" aria-hidden="true"><span class="letter">D</span><span class="letter">e</span><span class="letter">s</span><span class="letter">i</span><span class="letter">g</span><span class="letter">n</span></span></h1><div class="hero__side"><a href="#case" class="cta cta--badge cta--klein cta--down hero__cta"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>See our work</span></a></div></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script>"`;

exports[`variants, modes and route data > join with an answer (ar) 1`] = `"<section class="hero hero--banner"><div class="hero__media" data-video-src="/media/showreel.mp4" data-clip-start="17.4" data-clip-end="18.3"></div><div class="hero__inner"><h1 aria-label="انضم إلى المحطة"><span class="word" aria-hidden="true"><span class="letter">انضم</span></span> <span class="word" aria-hidden="true"><span class="letter">إلى</span></span> <span class="word accent" aria-hidden="true"><span class="letter">المحطة</span></span></h1><div class="hero__side"><p class="hero__sub">للناس اللي يقدرون يطلّعون الفكرة من راسهم ويخلّونها حقيقة.</p><a href="#apply" class="cta cta--badge cta--klein cta--down hero__cta"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>قدّم الآن</span></a></div></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script><section class="join-why" aria-labelledby="join-why-heading"><div class="section-wrap"><div class="tag rv"><span class="dot"></span><span>ليش بريّن ستيشن</span></div><div class="sec-head"><h2 class="rv" id="join-why-heading">شغل <em>يطلع للعالم</em></h2><p class="rv">خمسة تخصصات و٢٨ خدمة في نفس المكان. بتشتغل جنب ناس يسوون اللي ما تسويه، على بريفات تنتهي في الواقع.</p></div><div class="join-why__grid"><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">01</span><h3>خمسة تخصصات، غرفة واحدة</h3><p>مصممون وصنّاع أفلام وكتّاب ومطوّرون في نفس المكان. تتعلّم اللي يعرفه غيرك.</p></div><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">02</span><h3>بريفات حقيقية من البداية</h3><p>بدون شهور من المراقبة. تشتغل على مشاريع تطلع فعلاً، مع ناس طلّعوا كثير.</p></div><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">03</span><h3>أصليّ بأي لغة</h3><p>العربية والإنجليزية وغيرها، كل لغة تُكتب وتُصمَّم بلغتها، مو كترجمة.</p></div><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">04</span><h3>مساحة للنمو</h3><p>ملاحظات من قادة في حرفتك، وطريق واضح للتطور تقدر تشوفه.</p></div></div></div></section><section class="join-steps" aria-labelledby="join-steps-heading"><div class="section-wrap"><div class="tag rv"><span class="dot"></span><span>كيف تمشي العملية</span></div><div class="sec-head"><h2 class="rv" id="join-steps-heading">من التقديم إلى <em>أول بريف</em></h2><p class="rv">أربع خطوات، وبتسمع منا في كل وحدة منها.</p></div><ol class="join-steps__list" role="list"><li class="join-step rv"><span class="join-step__n" aria-hidden="true">01</span><h3>قدّم</h3><p>أرسل أعمالك وبعض التفاصيل. خمس دقائق، بدون خطاب تقديم.</p><span class="join-step__time">اليوم الأول</span></li><li class="join-step rv"><span class="join-step__n" aria-hidden="true">02</span><h3>مراجعة الأعمال</h3><p>قائد من نفس حرفتك يراجع الشغل نفسه، مو بس السيرة الذاتية.</p><span class="join-step__time">خلال أسبوعين</span></li><li class="join-step rv"><span class="join-step__n" aria-hidden="true">03</span><h3>محادثة</h3><p>مكالمة مع الناس اللي بتشتغل معهم. وجهّز أسئلتك أنت بعد.</p><span class="join-step__time">حوالي ٤٥ دقيقة</span></li><li class="join-step rv"><span class="join-step__n" aria-hidden="true">04</span><h3>بريف قصير</h3><p>مهمة صغيرة واقعية عشان الطرفين يشوفون كيف يكون الشغل مع بعض.</p><span class="join-step__time">أيام قليلة</span></li></ol></div></section><section class="join-apply" id="apply" aria-labelledby="join-apply-heading"><div class="section-wrap"><div class="tag tag--sky rv"><span class="dot"></span><span>التقديم</span></div><div class="sec-head"><h2 class="rv" id="join-apply-heading">ورّنا وش <em>تصنع</em></h2><div class="join-apply__lead rv" id="apply-lead" data-closed="true"><p class="join-apply__p">أعمالك تقول لنا أكثر من السيرة الذاتية. أرسل الاثنين إذا عندك.</p><p class="join-apply__closed">لا نستقبل طلبات التوظيف حاليًا. عُد إلينا قريبًا.</p></div></div><form id="apply-form" class="apply-form" method="post" action="/api/apply" enctype="multipart/form-data" novalidate data-locale="ar" data-status-url="/api/apply/status" data-closed-target="apply-lead" data-err-required="هذا الحقل مطلوب." data-err-email="أدخل بريدًا إلكترونيًا صحيحًا، مثل you@email.com." data-err-url="أدخل رابطًا كاملًا يبدأ بـ https://" data-err-too-long="النص أطول من الحد المسموح." data-err-invalid="يرجى مراجعة هذا الحقل." data-err-consent="يرجى تحديد هذا المربع لنحتفظ بطلبك ونراجعه."><p id="apply-status" class="form-status af-status is-error" role="status" aria-live="polite" tabindex="-1" data-sending="جارٍ الإرسال…" data-ok="وصلنا طلبك. بنراجع أعمالك ونرد عليك خلال أسبوعين." data-invalid="بعض الإجابات ناقصة أو تحتاج إلى مراجعة. يرجى مراجعة النموذج والمحاولة مرة أخرى." data-too-large="حجم الملف أكبر من المسموح. يمكن أن يصل حجم سيرتك الذاتية إلى ١٠ ميجابايت." data-bad-type="لا يمكن قبول هذا الملف. استخدم ملف PDF أو Word ‏(.docx) أقل من ١٠ ميجابايت." data-rate-limited="محاولات كثيرة. يرجى الانتظار قليلًا ثم المحاولة مرة أخرى." data-unavailable="لا يمكننا استقبال الطلبات في الوقت الحالي. يرجى المحاولة لاحقًا." data-closed="لا نستقبل طلبات التوظيف حاليًا. عُد إلينا قريبًا." data-error="حدث خطأ ما. حاول مرة أخرى.">لا نستقبل طلبات التوظيف حاليًا. عُد إلينا قريبًا.</p><fieldset class="af-group"><legend class="af-group__t">عنك</legend><div class="af-grid"><div class="field"><label for="af-name">الاسم الكامل</label><input id="af-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="اسمك الكامل"></div><div class="field"><label for="af-email">البريد الإلكتروني</label><input id="af-email" name="email" type="email" required maxlength="254" autocomplete="email" dir="ltr" placeholder="you@email.com"></div><div class="field"><label for="af-phone">الجوال</label><input id="af-phone" name="phone" type="tel" required minlength="6" maxlength="32" autocomplete="tel" inputmode="tel" dir="ltr" placeholder="+966 5X XXX XXXX"></div><div class="field"><label for="af-city">المدينة</label><input id="af-city" name="city" type="text" required maxlength="80" autocomplete="address-level2" placeholder="جدة، الرياض، أي مكان"></div></div></fieldset><fieldset class="af-group"><legend class="af-group__t">الوظيفة</legend><div class="af-grid"><div class="field"><label for="af-role">الوظيفة اللي تهمّك</label><input id="af-role" name="role" type="text" required maxlength="120" autocomplete="off" placeholder="مصمم موشن، كاتب محتوى، منتج"></div><div class="field"><label for="af-experience">الخبرة</label><select id="af-experience" name="experience" required><option value="">اختر واحداً</option><option value="student">طالب أو خريج</option><option value="1-3">من سنة إلى ٣ سنوات</option><option value="3-6">من ٣ إلى ٦ سنوات</option><option value="6-plus">أكثر من ٦ سنوات</option></select></div><div class="field"><label for="af-work-type">كيف تحب تشتغل</label><select id="af-work-type" name="work_type" required><option value="">اختر واحداً</option><option value="full-time">دوام كامل</option><option value="freelance">عمل حر</option><option value="internship">تدريب</option><option value="any">أي شكل</option></select></div><div class="field"><label for="af-availability">متى تقدر تبدأ؟</label><select id="af-availability" name="availability" required><option value="">اختر واحداً</option><option value="immediately">فوراً</option><option value="two-weeks">خلال أسبوعين</option><option value="month">خلال شهر</option><option value="later">بعد أكثر من شهر</option></select></div><div class="af-chips af-full" role="group" aria-labelledby="af-skills-label"><p class="af-label" id="af-skills-label">الحِرف اللي تشتغل فيها</p><div class="af-chips__row"><label class="af-chip"><input type="checkbox" name="skills" value="branding"><span>الهوية البصرية</span></label><label class="af-chip"><input type="checkbox" name="skills" value="animation"><span>الرسوم المتحركة</span></label><label class="af-chip"><input type="checkbox" name="skills" value="motion-graphics"><span>الموشن جرافيك</span></label><label class="af-chip"><input type="checkbox" name="skills" value="videography"><span>الإنتاج المرئي</span></label><label class="af-chip"><input type="checkbox" name="skills" value="photography"><span>التصوير الفوتوغرافي</span></label><label class="af-chip"><input type="checkbox" name="skills" value="montage"><span>المونتاج</span></label><label class="af-chip"><input type="checkbox" name="skills" value="event-planning"><span>تنظيم الفعاليات</span></label><label class="af-chip"><input type="checkbox" name="skills" value="advertising"><span>الإعلان</span></label><label class="af-chip"><input type="checkbox" name="skills" value="social-media"><span>السوشيال ميديا</span></label><label class="af-chip"><input type="checkbox" name="skills" value="web-development"><span>تطوير المواقع</span></label><label class="af-chip"><input type="checkbox" name="skills" value="seo-geo-aeo"><span>تحسين الظهور</span></label><label class="af-chip"><input type="checkbox" name="skills" value="music"><span>الموسيقى</span></label><label class="af-chip"><input type="checkbox" name="skills" value="merchandise"><span>المنتجات الترويجية</span></label><label class="af-chip"><input type="checkbox" name="skills" value="gaming"><span>الألعاب</span></label><label class="af-chip"><input type="checkbox" name="skills" value="copywriting"><span>كتابة المحتوى</span></label><label class="af-chip"><input type="checkbox" name="skills" value="strategy"><span>الاستراتيجية</span></label></div></div></div></fieldset><fieldset class="af-group"><legend class="af-group__t">أعمالك</legend><div class="af-grid"><div class="field"><label for="af-portfolio">رابط أعمالك</label><input id="af-portfolio" name="portfolio" type="url" required maxlength="2048" autocomplete="url" inputmode="url" dir="ltr" placeholder="https://behance.net/yourname"></div><div class="field"><label for="af-linkedin">لينكدإن<span class="af-opt">اختياري</span></label><input id="af-linkedin" name="linkedin" type="url" maxlength="2048" autocomplete="url" inputmode="url" dir="ltr" placeholder="https://linkedin.com/in/yourname"></div><div class="af-drop af-full" data-cv-drop data-state="empty" data-kb="كيلوبايت" data-mb="ميجابايت"><input id="af-cv" class="af-drop__input" name="cv" type="file" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" aria-describedby="af-cv-hint"><span class="af-drop__ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5M4 20h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="af-drop__txt"><label for="af-cv" class="af-drop__t"><span class="af-drop__default">اسحب سيرتك الذاتية هنا، أو اضغط للاختيار</span><span class="af-drop__name" data-cv-name dir="auto"></span></label><span class="af-drop__s"><span id="af-cv-hint" class="af-drop__hint" data-cv-hint>PDF أو Word ‏(.docx)، حتى ١٠ ميجابايت</span><span id="af-cv-size" class="af-drop__size" data-cv-size></span><span id="af-cv-bad" class="af-drop__bad" data-cv-bad>هذا الملف ما ينفع. استخدم ملف PDF أو Word ‏(.docx) أقل من ١٠ ميجابايت.</span></span></span><button type="button" class="af-drop__x" data-cv-remove>إزالة</button></div><div class="field af-full"><label for="af-message">العمل اللي تفتخر فيه أكثر، وليش</label><textarea id="af-message" name="message" required maxlength="4000" placeholder="حط رابطه أو وصفه. قل لنا وش كان دورك فيه ووش بتسوي بشكل مختلف الحين."></textarea></div></div></fieldset><div class="af-consents"><div class="field af-consent"><input id="af-consent-application" name="consent_application" type="checkbox" value="yes" required><label for="af-consent-application">أوافق على أن تحفظ بريّن ستيشن هذا الطلب وتراجعه، بما في ذلك سيرتي الذاتية، للنظر في ترشيحي لهذه الوظيفة.</label></div><div class="field af-consent"><input id="af-consent-future" name="consent_future" type="checkbox" value="yes"><label for="af-consent-future">احتفظوا بطلبي أيضاً وتواصلوا معي بخصوص وظائف مستقبلية.</label></div><p class="af-privacy"><a href="/ar/privacy#recruitment" target="_blank" rel="noopener">كيف نتعامل مع طلبات التوظيف<span class="sr-only"> (يفتح في علامة تبويب جديدة)</span></a></p></div><div class="hp-field" aria-hidden="true"><label for="af-hp">Leave this field empty</label><input id="af-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><input type="hidden" name="locale" value="ar"><input type="hidden" name="policy_version" value="2026-10-04"><div class="af-foot"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>أرسل الطلب</span></button><p class="af-note">نرد على كل طلب خلال أسبوعين، حتى لو كان الجواب: مو الحين.</p></div></form><script type="module" src="<root>/src/components/ApplicationForm.astro?astro&type=script&index=0&lang.ts"></script></div></section>"`;

exports[`variants, modes and route data > join with an answer (en) 1`] = `"<section class="hero hero--banner"><div class="hero__media" data-video-src="/media/showreel.mp4" data-clip-start="17.4" data-clip-end="18.3"></div><div class="hero__inner"><h1 aria-label="Join the station"><span class="word" aria-hidden="true"><span class="letter">J</span><span class="letter">o</span><span class="letter">i</span><span class="letter">n</span></span> <span class="word" aria-hidden="true"><span class="letter">t</span><span class="letter">h</span><span class="letter">e</span></span> <span class="word accent" aria-hidden="true"><span class="letter">s</span><span class="letter">t</span><span class="letter">a</span><span class="letter">t</span><span class="letter">i</span><span class="letter">o</span><span class="letter">n</span></span></h1><div class="hero__side"><p class="hero__sub">For people who can take an idea out of their head and make it real.</p><a href="#apply" class="cta cta--badge cta--klein cta--down hero__cta"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 1v13M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Apply now</span></a></div></div></section><script type="module" src="<root>/src/components/sections/Hero.astro?astro&type=script&index=0&lang.ts"></script><section class="join-why" aria-labelledby="join-why-heading"><div class="section-wrap"><div class="tag rv"><span class="dot"></span><span>Why Braiin Statiion</span></div><div class="sec-head"><h2 class="rv" id="join-why-heading">Work that <em>leaves the building</em></h2><p class="rv">Five disciplines and 28 services sit in the same room here. You&#39;ll work next to people who do what you don&#39;t, on briefs that end up in the real world.</p></div><div class="join-why__grid"><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">01</span><h3>Five disciplines, one room</h3><p>Designers, filmmakers, writers and developers on the same floor. You pick up what the others know.</p></div><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">02</span><h3>Real briefs, early</h3><p>No months of shadowing. You work on projects that actually ship, with people who&#39;ve shipped plenty.</p></div><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">03</span><h3>Native in any language</h3><p>Arabic, English and more, each one written and designed as itself, never as a translation.</p></div><div class="join-why__item rv"><span class="join-why__n" aria-hidden="true">04</span><h3>Room to grow</h3><p>Feedback from leads in your craft, and a path forward you can actually see.</p></div></div></div></section><section class="join-steps" aria-labelledby="join-steps-heading"><div class="section-wrap"><div class="tag rv"><span class="dot"></span><span>How it works</span></div><div class="sec-head"><h2 class="rv" id="join-steps-heading">From application to <em>first brief</em></h2><p class="rv">Four steps, and you&#39;ll hear from us at every one of them.</p></div><ol class="join-steps__list" role="list"><li class="join-step rv"><span class="join-step__n" aria-hidden="true">01</span><h3>Apply</h3><p>Send your portfolio and a few details. Five minutes, no cover letter.</p><span class="join-step__time">Day one</span></li><li class="join-step rv"><span class="join-step__n" aria-hidden="true">02</span><h3>Portfolio review</h3><p>A lead from your craft looks at the work itself, not just the CV.</p><span class="join-step__time">Within two weeks</span></li><li class="join-step rv"><span class="join-step__n" aria-hidden="true">03</span><h3>Conversation</h3><p>A call with the people you&#39;d work with. Bring your questions too.</p><span class="join-step__time">About 45 minutes</span></li><li class="join-step rv"><span class="join-step__n" aria-hidden="true">04</span><h3>A short brief</h3><p>A small, real-world task so both sides see how working together feels.</p><span class="join-step__time">A few days</span></li></ol></div></section><section class="join-apply" id="apply" aria-labelledby="join-apply-heading"><div class="section-wrap"><div class="tag tag--sky rv"><span class="dot"></span><span>Application</span></div><div class="sec-head"><h2 class="rv" id="join-apply-heading">Show us what you <em>make</em></h2><div class="join-apply__lead rv" id="apply-lead" data-closed="true"><p class="join-apply__p">A portfolio tells us more than a CV. Send both if you have them.</p><p class="join-apply__closed">We&#39;re not taking applications right now. Check back soon.</p></div></div><form id="apply-form" class="apply-form" method="post" action="/api/apply" enctype="multipart/form-data" novalidate data-locale="en" data-status-url="/api/apply/status" data-closed-target="apply-lead" data-err-required="This field is required." data-err-email="Enter a valid email address, like you@email.com." data-err-url="Enter a full link that starts with https://" data-err-too-long="This is longer than we can accept." data-err-invalid="Please check this field." data-err-consent="Tick this box so we can keep and review your application."><p id="apply-status" class="form-status af-status is-error" role="status" aria-live="polite" tabindex="-1" data-sending="Sending…" data-ok="Application received. We'll review your work and reply within two weeks." data-invalid="Some answers are missing or need another look. Please check the form and try again." data-too-large="That file is too large. Your CV can be up to 10 MB." data-bad-type="That file won't work. Use a PDF or Word (.docx) file under 10 MB." data-rate-limited="Too many attempts. Please wait a little and try again." data-unavailable="We can't receive applications at the moment. Please try again later." data-closed="We're not taking applications right now. Check back soon." data-error="Something went wrong. Please try again.">We&#39;re not taking applications right now. Check back soon.</p><fieldset class="af-group"><legend class="af-group__t">About you</legend><div class="af-grid"><div class="field"><label for="af-name">Full name</label><input id="af-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="Your full name"></div><div class="field"><label for="af-email">Email</label><input id="af-email" name="email" type="email" required maxlength="254" autocomplete="email" dir="ltr" placeholder="you@email.com"></div><div class="field"><label for="af-phone">Phone</label><input id="af-phone" name="phone" type="tel" required minlength="6" maxlength="32" autocomplete="tel" inputmode="tel" dir="ltr" placeholder="+966 5X XXX XXXX"></div><div class="field"><label for="af-city">City</label><input id="af-city" name="city" type="text" required maxlength="80" autocomplete="address-level2" placeholder="Jeddah, Riyadh, anywhere"></div></div></fieldset><fieldset class="af-group"><legend class="af-group__t">The role</legend><div class="af-grid"><div class="field"><label for="af-role">Role you&#39;re interested in</label><input id="af-role" name="role" type="text" required maxlength="120" autocomplete="off" placeholder="Motion designer, copywriter, producer"></div><div class="field"><label for="af-experience">Experience</label><select id="af-experience" name="experience" required><option value="">Choose one</option><option value="student">Student or graduate</option><option value="1-3">1 to 3 years</option><option value="3-6">3 to 6 years</option><option value="6-plus">6+ years</option></select></div><div class="field"><label for="af-work-type">How you&#39;d like to work</label><select id="af-work-type" name="work_type" required><option value="">Choose one</option><option value="full-time">Full-time</option><option value="freelance">Freelance</option><option value="internship">Internship</option><option value="any">Open to any</option></select></div><div class="field"><label for="af-availability">When could you start?</label><select id="af-availability" name="availability" required><option value="">Choose one</option><option value="immediately">Immediately</option><option value="two-weeks">Within two weeks</option><option value="month">Within a month</option><option value="later">In more than a month</option></select></div><div class="af-chips af-full" role="group" aria-labelledby="af-skills-label"><p class="af-label" id="af-skills-label">Crafts you work in</p><div class="af-chips__row"><label class="af-chip"><input type="checkbox" name="skills" value="branding"><span>Branding</span></label><label class="af-chip"><input type="checkbox" name="skills" value="animation"><span>Animation</span></label><label class="af-chip"><input type="checkbox" name="skills" value="motion-graphics"><span>Motion Graphics</span></label><label class="af-chip"><input type="checkbox" name="skills" value="videography"><span>Videography</span></label><label class="af-chip"><input type="checkbox" name="skills" value="photography"><span>Photography</span></label><label class="af-chip"><input type="checkbox" name="skills" value="montage"><span>Montage</span></label><label class="af-chip"><input type="checkbox" name="skills" value="event-planning"><span>Event Planning</span></label><label class="af-chip"><input type="checkbox" name="skills" value="advertising"><span>Advertising</span></label><label class="af-chip"><input type="checkbox" name="skills" value="social-media"><span>Social Media</span></label><label class="af-chip"><input type="checkbox" name="skills" value="web-development"><span>Web Development</span></label><label class="af-chip"><input type="checkbox" name="skills" value="seo-geo-aeo"><span>SEO / GEO / AEO</span></label><label class="af-chip"><input type="checkbox" name="skills" value="music"><span>Music</span></label><label class="af-chip"><input type="checkbox" name="skills" value="merchandise"><span>Merchandise</span></label><label class="af-chip"><input type="checkbox" name="skills" value="gaming"><span>Gaming</span></label><label class="af-chip"><input type="checkbox" name="skills" value="copywriting"><span>Copywriting</span></label><label class="af-chip"><input type="checkbox" name="skills" value="strategy"><span>Strategy</span></label></div></div></div></fieldset><fieldset class="af-group"><legend class="af-group__t">Your work</legend><div class="af-grid"><div class="field"><label for="af-portfolio">Portfolio link</label><input id="af-portfolio" name="portfolio" type="url" required maxlength="2048" autocomplete="url" inputmode="url" dir="ltr" placeholder="https://behance.net/yourname"></div><div class="field"><label for="af-linkedin">LinkedIn<span class="af-opt">optional</span></label><input id="af-linkedin" name="linkedin" type="url" maxlength="2048" autocomplete="url" inputmode="url" dir="ltr" placeholder="https://linkedin.com/in/yourname"></div><div class="af-drop af-full" data-cv-drop data-state="empty" data-kb="KB" data-mb="MB"><input id="af-cv" class="af-drop__input" name="cv" type="file" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" aria-describedby="af-cv-hint"><span class="af-drop__ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5M4 20h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="af-drop__txt"><label for="af-cv" class="af-drop__t"><span class="af-drop__default">Drop your CV here, or click to browse</span><span class="af-drop__name" data-cv-name dir="auto"></span></label><span class="af-drop__s"><span id="af-cv-hint" class="af-drop__hint" data-cv-hint>PDF or Word (.docx), up to 10 MB</span><span id="af-cv-size" class="af-drop__size" data-cv-size></span><span id="af-cv-bad" class="af-drop__bad" data-cv-bad>That file won&#39;t work. Use a PDF or Word (.docx) file under 10 MB.</span></span></span><button type="button" class="af-drop__x" data-cv-remove>Remove</button></div><div class="field af-full"><label for="af-message">The piece you&#39;re proudest of, and why</label><textarea id="af-message" name="message" required maxlength="4000" placeholder="Link it or describe it. Tell us what you did on it and what you'd do differently now."></textarea></div></div></fieldset><div class="af-consents"><div class="field af-consent"><input id="af-consent-application" name="consent_application" type="checkbox" value="yes" required><label for="af-consent-application">I agree that Braiin Statiion can store and review this application, including my CV, to consider me for this role.</label></div><div class="field af-consent"><input id="af-consent-future" name="consent_future" type="checkbox" value="yes"><label for="af-consent-future">Also keep my application on file and contact me about future roles.</label></div><p class="af-privacy"><a href="/privacy#recruitment" target="_blank" rel="noopener">How we handle applications<span class="sr-only"> (opens in a new tab)</span></a></p></div><div class="hp-field" aria-hidden="true"><label for="af-hp">Leave this field empty</label><input id="af-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><input type="hidden" name="locale" value="en"><input type="hidden" name="policy_version" value="2026-10-04"><div class="af-foot"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Send application</span></button><p class="af-note">We reply to every application within two weeks, even when the answer is not yet.</p></div></form><script type="module" src="<root>/src/components/ApplicationForm.astro?astro&type=script&index=0&lang.ts"></script></div></section>"`;

exports[`variants, modes and route data > pageHead built-in without a count (ar) 1`] = `"<section class="catalog-head" data-hero><div class="catalog-head__wrap"><a class="catalog-head__back" href="/ar/portfolio"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H2M7 3L2 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>أعمالنا</span></a><div class="catalog-head__row"><h1>كل <em>المشاريع</em></h1><div class="rv"><p>كل المشاريع اللي صنعناها. فلتر حسب الخدمة أو القطاع أو العميل أو السنة، أو اضغط على أي وسم في المشروع.</p></div></div></div></section>"`;

exports[`variants, modes and route data > pageHead built-in without a count (en) 1`] = `"<section class="catalog-head" data-hero><div class="catalog-head__wrap"><a class="catalog-head__back" href="/portfolio"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H2M7 3L2 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>Our Work</span></a><div class="catalog-head__row"><h1>All <em>projects</em></h1><div class="rv"><p>Every project we&#39;ve made. Filter by service, sector, client or year, or tap any tag on a project.</p></div></div></div></section>"`;

exports[`variants, modes and route data > serviceExplorer fallback panels (ar) 1`] = `"<section class="svc-xp" aria-label="الخدمات حسب التخصص" data-xp><div class="svc-xp__pad"><div class="svc-xp__tabs" data-xp-tabs data-xp-label="التخصصات"><a class="svc-tab" id="svc-tab-branding" href="#branding" data-xp-tab="branding"><i>01</i> الهوية البصرية</a><a class="svc-tab" id="svc-tab-production" href="#production" data-xp-tab="production"><i>02</i> الإنتاج</a><a class="svc-tab" id="svc-tab-marketing" href="#marketing" data-xp-tab="marketing"><i>03</i> التسويق</a><a class="svc-tab" id="svc-tab-web" href="#web" data-xp-tab="web"><i>04</i> تطوير المواقع</a><a class="svc-tab" id="svc-tab-events" href="#events" data-xp-tab="events"><i>05</i> الفعاليات والمعارض</a></div><div class="svc-panel" id="branding" data-xp-panel="branding"><div class="svc-xp__grid svc-xp__grid--solo"><div class="svc-xp__copy"><p class="svc-xp__k"><span class="dot"></span><span>01 / 05</span></p><h2 class="svc-xp__h" id="svc-panel-branding-h">الهوية البصرية</h2><p class="svc-xp__p">الشعار والنظام، وكل شي يلمسه.</p><div class="svc-xp__foot"><div class="svc-xp__nav"><a class="svc-xp__btn svc-xp__btn--prev" href="#events" data-xp-go="events"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H2M7 3L2 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><span class="sr-only">التخصص السابق: </span>الفعاليات والمعارض</span></a><a class="svc-xp__btn svc-xp__btn--next" href="#production" data-xp-go="production"><span><span class="sr-only">التخصص التالي: </span>الإنتاج</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div><a href="#inquiry" data-preselect="discipline:branding" data-track="start_project" class="cta cta--badge cta--klein cta--go svc-xp__start"><span class="cta__ico" aria-hidden=