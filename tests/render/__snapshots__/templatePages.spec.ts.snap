rue"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>A fixed price once the scope is agreed</span></li><li><b aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></b><span>One team from the first sketch to launch</span></li></ul></div><form id="contact-form" class="contact-form contact-form--full contact-form--hello" data-locale="en" data-kind="project_inquiry" data-form-variant="hello" data-err-required="This field is required." data-err-email="Enter a valid email address, like name@company.com." data-err-too-long="This is longer than we can accept." data-err-invalid="Please check this field." novalidate><div class="field"><label for="cf-name">Name</label><input id="cf-name" name="name" type="text" required maxlength="120" autocomplete="name" placeholder="Your full name"></div><div class="field"><label for="cf-email">Email</label><input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@company.com"></div><div class="field"><label for="cf-company">Company</label><input id="cf-company" name="company" type="text" maxlength="120" autocomplete="organization" placeholder="Optional"></div><div class="field"><label for="cf-phone">Phone or WhatsApp</label><input id="cf-phone" name="phone" type="tel" dir="ltr" maxlength="32" autocomplete="tel" inputmode="tel" placeholder="+966 5X XXX XXXX"></div><div class="field"><label for="cf-service">What do you need?</label><select id="cf-service" name="service"><option value="">Not sure yet, let&#39;s talk</option><optgroup label="01 Branding"><option value="discipline:branding">Branding, help me choose</option><option value="logo" selected>Logo Design</option><option value="packaging">Packaging</option></optgroup><optgroup label="02 Production"><option value="discipline:production">Production, help me choose</option><option value="animation">Animation</option></optgroup></select></div><div class="field"><label for="cf-budget">Budget range</label><select id="cf-budget" name="budget"><option value="">Prefer to discuss</option><option value="lt_25k">Under 25k SAR</option><option value="25k_75k">25k to 75k SAR</option><option value="75k_200k">75k to 200k SAR</option><option value="gt_200k">200k SAR and up</option><option value="not_sure">Not sure yet</option></select></div><div class="field field-full"><label for="cf-message">Tell us about the project</label><textarea id="cf-message" name="message" required maxlength="5000" placeholder="What are you making, who is it for, and when does it need to be ready?"></textarea></div><div class="field field-full field-check"><input id="cf-consent" name="consent" type="checkbox"><label for="cf-consent">I agree to be contacted about my inquiry.</label></div><div class="hp-field" aria-hidden="true"><label for="cf-hp">Leave this field empty</label><input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off"></div><input type="hidden" name="required_fields" value><div class="contact-form__foot field-full"><button type="submit" class="cta cta--badge cta--klein cta--go"><span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Send a message</span></button><p class="contact-form__note">We read everything and reply within one business day.</p></div><p id="contact-status" class="form-status" role="status" aria-live="polite" tabindex="-1" hidden data-sending="Sending…" data-ok="Got it. We'll be in touch within one business day." data-invalid="Please correct the marked fields and try again." data-rate-limited="Too many attempts. Please wait a minute and try again." data-unavailable="The form isn’t live yet — please email hello@braiinstatiion.com."